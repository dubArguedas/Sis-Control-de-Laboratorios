@page "/aulas/{TorreNombre}"
@inject NavigationManager NavManager

<h3>Aulas de @TorreNombre</h3>

<RadzenRow Class="rz-mb-4">
    <RadzenColumn Size="12">
        <h4 class="rz-color-danger">Aulas en Uso</h4>
        <div class="d-flex flex-wrap gap-3">
            @foreach (var aula in AulasEnUso)
            {
                <RadzenCard Style="cursor:pointer;" Click="@(() => SeleccionarAula(aula.Nombre))" Class="shadow-lg">
                    <div class="d-flex align-items-center">
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="" IsPill="true" Style="margin-right: 8px;" />
                        <strong>@aula.Nombre</strong>
                    </div>
                </RadzenCard>
            }
        </div>
    </RadzenColumn>
</RadzenRow>
<hr />
<RadzenRow>
    <RadzenColumn Size="12">
        <h4 class="rz-color-success">Aulas Vacías (Disponibles)</h4>
        <div class="d-flex flex-wrap gap-3">
            @foreach (var aula in AulasVacias)
            {
                <RadzenCard Style="cursor:pointer;" Click="@(() => SeleccionarAula(aula.Nombre))">
                    <div class="d-flex align-items-center">
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="" IsPill="true" Style="margin-right: 8px;" />
                        <span>@aula.Nombre</span>
                    </div>
                </RadzenCard>
            }
        </div>
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter]
    public string TorreNombre { get; set; } = "";

    // Simulación de datos (deberías cargarlos de tu servicio)
    private List<Aula> TodasLasAulas = new List<Aula>();

    private List<Aula> AulasEnUso => TodasLasAulas.Where(a => a.EstaEnUso).ToList();
    private List<Aula> AulasVacias => TodasLasAulas.Where(a => !a.EstaEnUso).ToList();

    protected override void OnInitialized()
    {
        // Lógica: Cargar Aulas para la TorreNombre
        if (TorreNombre == "Maestra")
        {
            TodasLasAulas = new List<Aula>
            {
                new Aula { Nombre = "B401", EstaEnUso = true },
                new Aula { Nombre = "B402", EstaEnUso = false },
                new Aula { Nombre = "B403", EstaEnUso = true },
                new Aula { Nombre = "B404", EstaEnUso = false }
            };
        }
        else // Innovacion
        {
             TodasLasAulas = new List<Aula>
            {
                new Aula { Nombre = "I101", EstaEnUso = true },
                new Aula { Nombre = "I102", EstaEnUso = false },
            };
        }
    }

    void SeleccionarAula(string aulaNombre)
    {
        // Navega a la página de equipos, pasando la torre y el aula
        NavManager.NavigateTo($"/equipos/{TorreNombre}/{aulaNombre}");
    }

    // Modelo de datos simple
    public class Aula { 
        public string Nombre { get; set; } = ""; 
        public bool EstaEnUso { get; set; } }

}