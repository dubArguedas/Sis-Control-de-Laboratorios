@page "/torres"
@layout AdminLayout
@rendermode InteractiveServer
@inject NavigationManager NavManager

<RadzenText TextStyle="TextStyle.DisplayH3" Class="rz-mb-4">Gestión de Torres</RadzenText>




@code {
    void SeleccionarTorre(string torre)
    {
        // Navega a la página de aulas, pasando el nombre de la torre como parámetro de URL
        NavManager.NavigateTo($"/aulas/{torre}");
    }
}
