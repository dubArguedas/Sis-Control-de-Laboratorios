@inject SCLAB_Client.Components.Service.SignalR.SignalRAlertasService AlertasService
@inject NavigationManager Navigation
@implements IDisposable

<div class="alert-bell-container" @onclick="IrAAlertas">
    <RadzenIcon Icon="notifications" Style="font-size: 24px; color: #662222; cursor: pointer;" />

    @if (conteoPendientes > 0)
    {
        <span class="alert-badge">@conteoPendientes</span>
    }
</div>

<style>
    .alert-bell-container {
        position: relative;
        display: inline-block;
        margin-right: 15px;
    }

    .alert-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background-color: #dc3545;
        color: white;
        border-radius: 50%;
        padding: 2px 6px;
        font-size: 11px;
        font-weight: bold;
        cursor: pointer;
    }
</style>

@code {
    private int conteoPendientes = 0;

    protected override async Task OnInitializedAsync()
    {
        AlertasService.OnAlertaRecibida += ActualizarContador;

        // await CargarContadorInicial();
    }

    private void ActualizarContador()
    {
        conteoPendientes++;
        InvokeAsync(StateHasChanged);
    }

    private void IrAAlertas()
    {
        Navigation.NavigateTo("/alertas/historial");
    }

    public void Dispose()
    {
        AlertasService.OnAlertaRecibida -= ActualizarContador;
    }
}