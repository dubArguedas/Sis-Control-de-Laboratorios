@page "/estudiante"
@layout LoginLayout
@rendermode InteractiveServer
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.WebUtilities
@using SCLAB_Entities
@using SCLAB_Client.Services
@inject NavigationManager NavigationManager
@inject AsistenciaService AsistenciaService
@inject LaboratorioService LaboratorioService
@inject MaquinaService MaquinaService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IAuthService AuthService

<PageTitle>Reporte de Observación - PachaSoft</PageTitle>

@if (mostrarModalQR)
{
    <div class="modal-overlay">
        <div class="modal-container-qr">
            <div class="modal-icon">
                <RadzenIcon Icon="qr_code_scanner" Style="font-size: 64px; color: #842A3B;" />
            </div>
            <div class="modal-content">
                <h3 class="modal-title">Registro Requerido</h3>
                <p class="modal-text">
                    Para acceder al sistema, primero debe registrar su asistencia escaneando el código QR
                    de la máquina en el laboratorio.
                </p>
                <p class="modal-subtext">
                    Una vez registrado, podrá ingresar con sus credenciales institucionales.
                </p>
            </div>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="10px" JustifyContent="JustifyContent.Center">
                @* <RadzenButton Text="Entendido"
                              Click="@CerrarModalQR"
                              ButtonStyle="ButtonStyle.Primary"
                              Class="modal-btn"
                              Size="ButtonSize.Medium" /> *@
                <RadzenButton Text="Volver al Inicio"
                              Click="@(() => NavigationManager.NavigateTo("/"))"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Medium" />
            </RadzenStack>
        </div>
    </div>
}
else if (cargando)
{
    <div class="loading-overlay">
        <div class="loading-container">
            <div class="loading-spinner">
                <RadzenProgressBarCircular ShowValue="false"
                                           Mode="ProgressBarMode.Indeterminate"
                                           Size="ProgressBarCircularSize.Large" />
            </div>
            <div class="loading-content">
                <p class="loading-text">@mensajeCarga</p>
                <small class="loading-subtext">Por favor espere...</small>
            </div>
        </div>
    </div>
}
else
{
    <div class="pacha-layout">
        <div class="pacha-header">
            <div class="header-top-row">
                <RadzenButton Icon="arrow_back"
                              Click="@VolverAlLogin"
                              Variant="Variant.Text"
                              Class="btn-back-mobile"
                              Style="color: white;" />

                <span class="header-brand">PachaSoft</span>

                <RadzenButton Icon="logout"
                              Click="@CerrarSesion"
                              Variant="Variant.Text"
                              Class="btn-logout-mobile"
                              Style="color: white;"
                              Title="Cerrar Sesión" />
            </div>

            <div class="profile-container">
                <div class="avatar-ring">
                    <RadzenIcon Icon="account_circle" Style="font-size: 80px; color: #fff; display: block;" />
                </div>
                <div class="user-info">
                    <h2 class="welcome-text">Hola, <span class="highlight-name">@estudianteNombre</span></h2>
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" IsPill="true" Text="Estudiante" Class="rz-mt-1" />
                    @if (asistenciaActualId > 0)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" IsPill="true" Text="Asistencia Registrada" Class="rz-mt-1" />
                    }
                </div>
            </div>
        </div>

        <div class="content-area">
            <RadzenCard class="main-card rz-shadow-4">
                <RadzenTabs @bind-SelectedIndex="@selectedTabIndex" RenderMode="TabRenderMode.Client" Class="pacha-tabs">
                    <Tabs>
                        <RadzenTabsItem Text="DATOS">
                            <RadzenStack Gap="1.5rem" Class="rz-p-0 rz-p-md-2">
                                @if (asistenciaActualId > 0)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Success"
                                                 Variant="Variant.Flat"
                                                 Shade="Shade.Lighter"
                                                 Size="AlertSize.Small"
                                                 AllowClose="false">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <RadzenIcon Icon="check_circle" />
                                            <RadzenText TextStyle="TextStyle.Body2" Class="rz-m-0">
                                                Asistencia registrada exitosamente
                                            </RadzenText>
                                        </RadzenStack>
                                    </RadzenAlert>
                                }

                                <RadzenRow>
                                    <RadzenColumn Size="6" SizeXS="12">
                                        <RadzenFormField Text="Laboratorio" Variant="Variant.Flat" Style="width: 100%;">
                                            <RadzenTextBox Value="@codigoLaboratorio"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeXS="12">
                                        <RadzenFormField Text="Máquina" Variant="Variant.Flat" Style="width: 100%;">
                                            <RadzenTextBox Value="@codigoMaquina"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow>
                                    <RadzenColumn Size="6" SizeXS="12">
                                        <RadzenFormField Text="Nombre" Variant="Variant.Flat" Style="width: 100%;">
                                            <RadzenTextBox Value="@oEstudianteCLS.Nombre"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeXS="12">
                                        <RadzenFormField Text="Apellido Paterno" Variant="Variant.Flat" Style="width: 100%;">
                                            <RadzenTextBox Value="@oEstudianteCLS.ApellidoPaterno"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow>
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Text="Correo Institucional" Variant="Variant.Flat" Style="width: 100%;">
                                            <RadzenTextBox Value="@oEstudianteCLS.CorreoInstitucional"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                @* <RadzenRow>
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Text="Materia Actual" Variant="Variant.Flat" Style="width: 100%;">
                                            <RadzenTextBox Value="@(materiaActual ?? "No asignada")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow> *@
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Class="rz-mt-4">
                                <RadzenButton Text="Cerrar Sesión" Icon="logout" ButtonStyle="ButtonStyle.Danger"
                                              Click="@CerrarSesion" Size="ButtonSize.Medium" />
                            </RadzenStack>
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="OBSERVACIÓN">
                            <RadzenStack Gap="1rem" Class="rz-p-0 rz-p-md-2">
                                <RadzenAlert AlertStyle="AlertStyle.Warning"
                                             Variant="Variant.Flat"
                                             Shade="Shade.Lighter"
                                             Size="AlertSize.Small"
                                             AllowClose="false"
                                             Class="rz-mb-2">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenIcon Icon="info" />
                                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-m-0">
                                            Reporte cualquier incidencia técnica. Esta observación pondrá la máquina en mantenimiento.
                                        </RadzenText>
                                    </RadzenStack>
                                </RadzenAlert>

                                <RadzenFormField Text="Detalle del problema" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenTextArea @bind-Value="maxLengthValue"
                                                    @oninput="@(args => maxLengthValue = $"{args.Value}")"
                                                    MaxLength="@maxLength"
                                                    Change="@(args => OnChange(args, "Observaciones"))"
                                                    Style="width: 100%; min-height: 150px;"
                                                    Disabled="@(asistenciaActualId == 0)"
                                                    Placeholder="Escriba aquí..." />
                                </RadzenFormField>

                                <div class="char-counter">@($"{maxLengthValue?.Length ?? 0}/{maxLength}") caracteres</div>

                                <RadzenButton Text="ENVIAR REPORTE"
                                              Icon="send"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Large"
                                              Class="btn-guindo rz-mt-4"
                                              Disabled="@(asistenciaActualId == 0 || string.IsNullOrWhiteSpace(maxLengthValue))"
                                              Click="@GuardarObservaciones" />
                            </RadzenStack>
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
            </RadzenCard>
        </div>
    </div>
}

<style>
    :root {
        --pacha-guindo: #842A3B;
        --pacha-guindo-dark: #601e2b;
        --pacha-bg: #f4f6f8;
    }

    .pacha-layout {
        background-color: var(--pacha-bg);
        min-height: 100vh;
        font-family: 'Roboto', sans-serif;
    }

    .pacha-header {
        background: linear-gradient(180deg, var(--pacha-guindo) 0%, var(--pacha-guindo-dark) 100%);
        padding-top: 60px;
        padding-bottom: 40px;
        padding-left: 15px;
        padding-right: 15px;
        color: white;
        border-radius: 0;
    }

    .header-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .btn-back-mobile, .btn-logout-mobile {
        background: rgba(255, 255, 255, 0.2) !important;
        border-radius: 50% !important;
        width: 45px !important;
        height: 45px !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .header-brand {
        font-weight: 700;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .profile-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .avatar-ring {
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        padding: 8px;
        border: 2px solid rgba(255,255,255,0.3);
        margin-bottom: 10px;
    }

    .welcome-text {
        font-size: 1.4rem;
        margin: 0;
    }

    .highlight-name {
        font-weight: 700;
    }

    .content-area {
        margin-top: -20px;
        padding: 0 15px 40px 15px;
        display: flex;
        justify-content: center;
        position: relative;
        z-index: 10;
    }

    .main-card {
        width: 100%;
        max-width: 700px;
        border-radius: 12px !important;
        background: white;
        overflow: hidden;
    }

    .pacha-tabs .rz-tabview-nav {
        background: #fff;
        border-bottom: 1px solid #eee;
    }

    .pacha-tabs .rz-tabview-selected {
        color: var(--pacha-guindo) !important;
        border-bottom: 3px solid var(--pacha-guindo) !important;
    }

    .btn-guindo {
        background-color: var(--pacha-guindo) !important;
        color: white !important;
    }

    .char-counter {
        text-align: right;
        font-size: 0.75rem;
        color: #999;
        margin-top: 5px;
    }

    .loading-overlay, .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loading-container {
        background: white;
        padding: 30px;
        border-radius: 12px;
        text-align: center;
    }

    .modal-container-qr {
        background: white;
        padding: 40px;
        border-radius: 12px;
        max-width: 500px;
        text-align: center;
    }
</style>

@code {
    private int selectedTabIndex = 0;
    string maxLengthValue = "";
    int maxLength = 500;
    private bool cargando = true;
    private bool mostrarModalQR = false;
    private string mensajeCarga = "Cargando información...";

    private string? codigoMaquina;
    private string? codigoLaboratorio;

    private int asistenciaActualId = 0;
    private string? materiaActual = null;

    public RegistroAsistenciaDto asistenciaEstudiante = new RegistroAsistenciaDto();
    public UsuariosCLS oEstudianteCLS = new UsuariosCLS();
    public UsuarioInfo? correo = new UsuarioInfo();

    private string estudianteNombre => oEstudianteCLS.Nombre ?? "Estudiante";

    private bool isDataLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isDataLoaded)
        {
            await ObtenerEstudiante();
            isDataLoaded = true;
            StateHasChanged();
        }
    }

    private async Task ObtenerEstudiante()
    {
        try
        {
            correo = await AuthService.GetCurrentUserInfoAsync();
            if (correo == null || correo.Rol.ToLower() != "estudiante")
            {
                NotificationService.Notify(NotificationSeverity.Error, "Acceso denegado", "Esta sección es solo para estudiantes");
                NavigationManager.NavigateTo("/");
                return;
            }

            oEstudianteCLS = await AsistenciaService.ObtenerEstudianteId(correo.UsuarioId);

            // Obtener parámetros del QR
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("codigoMaquina", out var maquinaValue))
            {
                codigoMaquina = maquinaValue.ToString();
            }
            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("codigoLaboratorio", out var laboratorioValue))
            {
                codigoLaboratorio = laboratorioValue.ToString();
            }

            if (string.IsNullOrEmpty(codigoMaquina) || string.IsNullOrEmpty(codigoLaboratorio))
            {
                mostrarModalQR = true;
                cargando = false;
                StateHasChanged();
                return;
            }

            // Registrar asistencia automáticamente
            await RegistrarAsistencia();

            cargando = false;
        }
        catch (Exception ex)
        {
            oEstudianteCLS = new UsuariosCLS() { Nombre = "Error", CorreoInstitucional = "Error" };
            NotificationService.Notify(NotificationSeverity.Error, "Error de Carga", $"No se pudieron cargar los datos. Detalle: {ex.Message}");
            cargando = false;
        }
    }

    async Task RegistrarAsistencia()
    {
        asistenciaEstudiante.UsuarioId = oEstudianteCLS.UsuarioId;
        asistenciaEstudiante.MaquinaId = await MaquinaService.ObtenerIdPorCodigo(codigoMaquina);
        asistenciaEstudiante.LaboratorioId = await LaboratorioService.ObtenerIdLaboratorio(codigoLaboratorio);

        if (asistenciaEstudiante.MaquinaId <= 0 || asistenciaEstudiante.LaboratorioId <= 0)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error de Datos QR",
                Detail = "No se pudieron obtener IDs válidos para Máquina o Laboratorio. Verifique el código.",
                Duration = 5000
            });
            return;
        }

        var respuesta = await AsistenciaService.RegistrarAsistencia(asistenciaEstudiante);

        if (respuesta.IsSuccess)
        {
            asistenciaActualId = (int)(respuesta.Data ?? 0);

            // Extraer la materia usando el método ObtenerAsistenciaDetalle que vamos a crear
            var asistenciaDetalle = await AsistenciaService.ObtenerAsistenciaDetalle(asistenciaActualId);
            if (asistenciaDetalle != null)
            {
                materiaActual = asistenciaDetalle.Materia;
            }

            NotificationService.Notify(NotificationSeverity.Success, "Registro Exitoso", respuesta.Message);

            StateHasChanged();
        }
        else
        {
            NotificationSeverity severity;
            string summary;

            if (respuesta.Message.Contains("No hay un horario") || respuesta.Message.Contains("Ya existe un registro"))
            {
                severity = NotificationSeverity.Warning;
                summary = "Advertencia de Asistencia";
            }
            else
            {
                severity = NotificationSeverity.Error;
                summary = "Error en Asistencia";
            }

            NotificationService.Notify(new NotificationMessage
            {
                Severity = severity,
                Summary = summary,
                Detail = respuesta.Message,
                Duration = 7000
            });
        }
    }

    private async Task GuardarObservaciones()
    {
        if (string.IsNullOrWhiteSpace(maxLengthValue))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Advertencia", "La observación no puede estar vacía.");
            return;
        }

        if (asistenciaActualId == 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Advertencia", "Debe registrar la asistencia primero.");
            return;
        }

        var dto = new SCLAB_Client.Services.ActualizarObservacionDto
        {
            Observacion = maxLengthValue
        };

        var resultado = await AsistenciaService.ActualizarObservaciones(asistenciaActualId, dto);

        if (resultado.IsSuccess)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Guardado Exitoso", resultado.Message);
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error al guardar observación", resultado.Message);
        }
    }

    void OnChange(string value, string name)
    {
        // Console log si es necesario
    }

    private void CerrarModalQR()
    {
        mostrarModalQR = false;
        StateHasChanged();
    }

    private void VolverAlLogin()
    {
        NavigationManager.NavigateTo("/login");
    }

    private async Task CerrarSesion()
    {
        var result = await DialogService.Confirm(
            "¿Está seguro de que desea cerrar sesión?",
            "Confirmar cierre de sesión",
            new ConfirmOptions()
            {
                OkButtonText = "Sí, cerrar sesión",
                CancelButtonText = "Cancelar"
            }
        );

        if (result.HasValue && result.Value)
        {
            await AuthService.LogoutAsync();
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
    }
}