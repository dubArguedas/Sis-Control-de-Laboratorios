@page "/gestion-usuarios"
@* @layout AdminLayout *@
@rendermode InteractiveServer
@inject UsuarioService UsuarioService
@inject NotificationService NotificationService
@inject DialogService DialogService
@layout AdminLayout

<PageTitle>Gestión de Usuarios - PachaSoft</PageTitle>

<!-- Hero Section -->
<div class="hero-section">
    <div class="hero-overlay">
        <div class="hero-content">
            <div class="hero-badge">GESTIÓN DE USUARIOS</div>
            <h1 class="hero-title">Bienvenido a la Gestión de Usuarios</h1>
            <div class="hero-divider"></div>
            <p class="hero-subtitle">Por favor, seleccione el tipo de usuario que desea gestionar</p>
        </div>
    </div>
</div>

<div class="content-container">
    @if (selectedUserType == null)
    {
        <!-- Tarjetas de Selección de Tipo de Usuario -->
        <RadzenRow Gap="30px" class="user-type-cards">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard class="user-type-card estudiantes-card" @onclick="@(() => SelectUserType("estudiante"))">
                    <div class="card-icon-wrapper">
                        <RadzenIcon Icon="school" Style="font-size: 50px; color: white;" />
                    </div>
                    <h3>Estudiantes</h3>
                    <p>Gestionar estudiantes del sistema</p>
                    <div class="card-stats">
                        <RadzenBadge BadgeStyle="BadgeStyle.Light"
                                     Text="@($"{allUsers.Count(u => u.Rol == "estudiante")} registrados")" />
                    </div>
                    <div class="card-arrow">
                        Gestionar <span>→</span>
                    </div>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard class="user-type-card docentes-card" @onclick="@(() => SelectUserType("docente"))">
                    <div class="card-icon-wrapper">
                        <RadzenIcon Icon="menu_book" Style="font-size: 50px; color: white;" />
                    </div>
                    <h3>Docentes</h3>
                    <p>Gestionar docentes del sistema</p>
                    <div class="card-stats">
                        <RadzenBadge BadgeStyle="BadgeStyle.Light"
                                     Text="@($"{allUsers.Count(u => u.Rol == "docente")} registrados")" />
                    </div>
                    <div class="card-arrow">
                        Gestionar <span>→</span>
                    </div>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard class="user-type-card encargados-card" @onclick="@(() => SelectUserType("encargado"))">
                    <div class="card-icon-wrapper">
                        <RadzenIcon Icon="admin_panel_settings" Style="font-size: 50px; color: white;" />
                    </div>
                    <h3>Encargados</h3>
                    <p>Gestionar encargados del sistema</p>
                    <div class="card-stats">
                        <RadzenBadge BadgeStyle="BadgeStyle.Light"
                                     Text="@($"{allUsers.Count(u => u.Rol == "encargado")} registrados")" />
                    </div>
                    <div class="card-arrow">
                        Gestionar <span>→</span>
                    </div>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    }
    else
    {
        <!-- Vista de Gestión de Usuarios -->
        <RadzenCard class="management-header">
            <RadzenButton Text="Volver" Icon="arrow_back" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => { selectedUserType = null; searchTerm = ""; })" class="btn-back" />

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center" Gap="20px" class="header-content">
                <div>
                    <RadzenText TextStyle="TextStyle.H3" class="management-title">
                        Gestión de @GetUserTypeTitle()
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" class="management-subtitle">
                        @filteredUsers.Count() usuario@(filteredUsers.Count() != 1 ? "s" : "") encontrado@(filteredUsers.Count() != 1 ? "s" : "")
                        @if (filteredUsers.Any())
                        {
                            <span class="active-count">
                                • @filteredUsers.Count(u => u.Estado == "activo") activos
                            </span>
                        }
                    </RadzenText>
                </div>

                <RadzenButton Text="@($"Agregar {GetUserTypeSingle()}")" Icon="add_circle"
                              ButtonStyle="ButtonStyle.Success" Click="@InsertRow"
                              Disabled="@(usuariosToInsert.Count > 0)"
                              class="@($"btn-add btn-add-{selectedUserType}")" />
            </RadzenStack>
        </RadzenCard>

        <!-- Barra de Búsqueda -->
        <RadzenCard class="search-card">
            <RadzenTextBox @bind-Value="@searchTerm" Placeholder="Buscar por nombre, apellido, CI o correo..." 
                          class="search-input" Style="width: 100%;">
                <RadzenColumn>
                    <RadzenIcon Icon="search" />
                </RadzenColumn>
            </RadzenTextBox>
        </RadzenCard>

        <!-- DataGrid con Edición Inline -->
        <RadzenCard class="data-grid-card">
            @if (filteredUsers.Any())
            {
                <RadzenDataGrid @ref="usersGrid"
                                Data="@filteredUsers"
                                TItem="UsuarioDto"
                                AllowFiltering="false"
                                AllowPaging="true"
                                PageSize="10"
                                AllowSorting="true"
                                EditMode="DataGridEditMode.Single"
                                RowUpdate="@OnUpdateRow"
                                RowCreate="@OnCreateRow"
                                ColumnWidth="auto">
                    <Columns>
                        <RadzenDataGridColumn TItem="UsuarioDto" Property="Nombre" Title="Nombre Completo" Width="250px" Frozen="true">
                            <Template Context="user">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="10px" AlignItems="AlignItems.Center">
                                    <div class="user-avatar">
                                        @user.Nombre.Substring(0, 1).ToUpper()@user.ApellidoPaterno.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <strong>@user.Nombre @user.ApellidoPaterno @user.ApellidoMaterno</strong>
                                    </div>
                                </RadzenStack>
                            </Template>
                            <EditTemplate Context="user">
                                <RadzenTextBox @bind-Value="user.Nombre" Style="width: 100%;" Name="Nombre" aria-label="Nombre" />
                                <RadzenRequiredValidator Text="Nombre es requerido" Component="Nombre" Popup="true" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="UsuarioDto" Property="ApellidoPaterno" Title="Apellido Paterno" Width="180px">
                            <EditTemplate Context="user">
                                <RadzenTextBox @bind-Value="user.ApellidoPaterno" Style="width: 100%;" Name="ApellidoPaterno" aria-label="Apellido Paterno" />
                                <RadzenRequiredValidator Text="Apellido Paterno es requerido" Component="ApellidoPaterno" Popup="true" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="UsuarioDto" Property="ApellidoMaterno" Title="Apellido Materno" Width="180px">
                            <EditTemplate Context="user">
                                <RadzenTextBox @bind-Value="user.ApellidoMaterno" Style="width: 100%;" aria-label="Apellido Materno" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="UsuarioDto" Property="CI" Title="CI" Width="120px">
                            <Template Context="user">
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@user.CI" />
                            </Template>
                            <EditTemplate Context="user">
                                <RadzenTextBox @bind-Value="user.CI" Style="width: 100%;" Name="CI" aria-label="CI" Disabled="@(!IsNewUser(user))" />
                                <RadzenRequiredValidator Text="CI es requerido" Component="CI" Popup="true" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="UsuarioDto" Property="CorreoInstitucional" Title="Correo Institucional" Width="280px">
                            <Template Context="user">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="8px" AlignItems="AlignItems.Center">
                                    <RadzenIcon Icon="email" Style="font-size: 16px; color: #666;" />
                                    <span style="font-size: 14px;">@user.CorreoInstitucional</span>
                                </RadzenStack>
                            </Template>
                            <EditTemplate Context="user">
                                <RadzenTextBox @bind-Value="user.CorreoInstitucional" Style="width: 100%;" Name="Email" aria-label="Correo" Disabled="@(!IsNewUser(user))" />
                                <RadzenRequiredValidator Text="Correo es requerido" Component="Email" Popup="true" />
                                <RadzenEmailValidator Text="Correo inválido" Component="Email" Popup="true" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        @if (usuariosToInsert.Any())
                        {
                            <RadzenDataGridColumn TItem="UsuarioDto" Property="PasswordHash" Title="Contraseña" Width="200px">
                                <EditTemplate Context="user">
                                    @if (IsNewUser(user))
                                    {
                                        <RadzenPassword @bind-Value="user.PasswordHash" Style="width: 100%;" Name="Password" aria-label="Contraseña" />
                                        <RadzenRequiredValidator Text="Contraseña es requerida" Component="Password" Popup="true" />
                                        <RadzenLengthValidator Text="Mínimo 6 caracteres" Component="Password" Min="6" Popup="true" />
                                    }
                                </EditTemplate>
                            </RadzenDataGridColumn>
                        }

                        <RadzenDataGridColumn TItem="UsuarioDto" Property="Estado" Title="Estado" Width="120px">
                            <Template Context="user">
                                <RadzenBadge BadgeStyle="@(user.Estado == "activo" ? BadgeStyle.Success : BadgeStyle.Danger)"
                                             Text="@user.Estado.ToUpper()" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="UsuarioDto" Property="FechaRegistro" Title="Fecha Registro" Width="150px">
                            <Template Context="user">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="5px" AlignItems="AlignItems.Center">
                                    <RadzenIcon Icon="calendar_today" Style="font-size: 14px; color: #666;" />
                                    <span style="font-size: 13px;">@user.FechaRegistro.ToString("dd/MM/yyyy")</span>
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="UsuarioDto" Filterable="false" Sortable="false"
                                              TextAlign="TextAlign.Center" Width="200px" Title="Acciones"
                                              Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                            <Template Context="user">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="8px" JustifyContent="JustifyContent.Center">
                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light"
                                                  Variant="Variant.Flat" Size="ButtonSize.Small"
                                                  Click="@(() => EditRow(user))" title="Editar" />
                                    <RadzenButton Icon="@(user.Estado == "activo" ? "block" : "check_circle")"
                                                  ButtonStyle="@(user.Estado == "activo" ? ButtonStyle.Danger : ButtonStyle.Success)"
                                                  Variant="Variant.Flat" Size="ButtonSize.Small"
                                                  Click="@(() => ToggleEstado(user))"
                                                  title="@(user.Estado == "activo" ? "Desactivar" : "Activar")" />
                                </RadzenStack>
                            </Template>
                            <EditTemplate Context="user">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="8px" JustifyContent="JustifyContent.Center">
                                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success"
                                                  Variant="Variant.Flat" Size="ButtonSize.Small"
                                                  Click="@(() => SaveRow(user))" aria-label="Guardar" />
                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light"
                                                  Variant="Variant.Flat" Size="ButtonSize.Small"
                                                  Click="@(() => CancelEdit(user))" aria-label="Cancelar" />
                                </RadzenStack>
                            </EditTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
            else
            {
                <div class="empty-state">
                    <RadzenIcon Icon="search_off" Style="font-size: 64px; color: #ccc; margin-bottom: 20px;" />
                    <RadzenText TextStyle="TextStyle.H5" Style="color: #666; margin-bottom: 10px;">
                        No se encontraron resultados
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Style="color: #999;">
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <span>Intenta con otros términos de búsqueda</span>
                        }
                        else
                        {
                            <span>Aún no hay @GetUserTypeTitle().ToLower() registrados</span>
                        }
                    </RadzenText>
                </div>
            }
        </RadzenCard>
    }
</div>

