@code {
    RadzenDataGrid<UsuarioDto> usersGrid;
    private string? selectedUserType = null;
    private string searchTerm = "";
    private List<UsuarioDto> allUsers = new List<UsuarioDto>();
    private List<UsuarioDto> usuariosToInsert = new List<UsuarioDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            allUsers = await UsuarioService.GetUsuariosAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "❌ Error",
                Detail = $"No se pudieron cargar los usuarios: {ex.Message}",
                Duration = 5000
            });
        }
    }

    private IEnumerable<UsuarioDto> filteredUsers
    {
        get
        {
            if (selectedUserType == null) return Enumerable.Empty<UsuarioDto>();

            var users = allUsers.Where(u => u.Rol == selectedUserType).ToList();
            users.AddRange(usuariosToInsert.Where(u => u.Rol == selectedUserType));

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var search = searchTerm.Trim();
                users = users.Where(u =>
                    u.Nombre.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    u.ApellidoPaterno.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (u.ApellidoMaterno ?? "").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    u.CI.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    u.CorreoInstitucional.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            return users;
        }
    }

    private void SelectUserType(string type)
    {
        selectedUserType = type;
        searchTerm = "";
        usuariosToInsert.Clear();
    }

    private string GetUserTypeTitle() => selectedUserType switch
    {
        "estudiante" => "Estudiantes",
        "docente" => "Docentes",
        "encargado" => "Encargados",
        _ => ""
    };

    private string GetUserTypeSingle() => selectedUserType switch
    {
        "estudiante" => "Estudiante",
        "docente" => "Docente",
        "encargado" => "Encargado",
        _ => ""
    };

    private bool IsNewUser(UsuarioDto user) => user?.UsuarioId == 0;

    async Task InsertRow()
    {
        var usuario = new UsuarioDto
        {
            Rol = selectedUserType!,
            Estado = "activo",
            FechaRegistro = DateTime.Now
        };
        usuariosToInsert.Add(usuario);
       await usersGrid.InsertRow(usuario);
    }

    async Task EditRow(UsuarioDto user)
    {
        await usersGrid.EditRow(user);
    }

    async Task SaveRow(UsuarioDto user)
    {
        await usersGrid.UpdateRow(user);
    }

    void CancelEdit(UsuarioDto user)
    {
        usersGrid.CancelEditRow(user);
        if (IsNewUser(user))
        {
            usuariosToInsert.Remove(user);
        }
    }

    async Task OnCreateRow(UsuarioDto user)
    {
        try
        {
            var createDto = new UsuarioCreateDto
            {
                Nombre = user.Nombre,
                ApellidoPaterno = user.ApellidoPaterno,
                ApellidoMaterno = user.ApellidoMaterno,
                CI = user.CI,
                CorreoInstitucional = user.CorreoInstitucional,
                Rol = user.Rol,
                PasswordHash = user.PasswordHash
            };

            var result = await UsuarioService.CreateUsuarioAsync(createDto);

            if (result.Success)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "✅ Usuario creado",
                    Detail = "El usuario ha sido creado exitosamente",
                    Duration = 3000
                });

                usuariosToInsert.Remove(user);
                await LoadUsers();
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "❌ Error",
                    Detail = result.Message,
                    Duration = 5000
                });
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "❌ Error",
                Detail = $"Error al crear usuario: {ex.Message}",
                Duration = 5000
            });
        }
    }

    async Task OnUpdateRow(UsuarioDto user)
    {
        try
        {
            var result = await UsuarioService.UpdateUsuarioAsync(user.UsuarioId, user);

            if (result.Success)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "✅ Usuario actualizado",
                    Detail = "Los cambios han sido guardados",
                    Duration = 3000
                });

                await LoadUsers();
                await usersGrid.Reload();
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "❌ Error",
                    Detail = result.Message,
                    Duration = 5000
                });
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "❌ Error",
                Detail = $"Error al actualizar: {ex.Message}",
                Duration = 5000
            });
        }
    }

    async Task ToggleEstado(UsuarioDto user)
    {
        var nuevoEstado = user.Estado == "activo" ? "inactivo" : "activo";
        var mensaje = nuevoEstado == "activo" ? "activar" : "desactivar";

        var result = await DialogService.Confirm(
            $"¿Está seguro de {mensaje} a {user.Nombre} {user.ApellidoPaterno}?",
            "Confirmar acción",
            new ConfirmOptions { OkButtonText = "Sí, confirmar", CancelButtonText = "Cancelar" }
        );

        if (result == true)
        {
            try
            {
                var toggleResult = await UsuarioService.ToggleUsuarioEstadoAsync(user.UsuarioId);

                if (toggleResult.Success)
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = nuevoEstado == "activo" ? NotificationSeverity.Success : NotificationSeverity.Warning,
                        Summary = $"✅ Usuario {(nuevoEstado == "activo" ? "activado" : "desactivado")}",
                        Detail = $"{user.Nombre} {user.ApellidoPaterno} ahora está {nuevoEstado}",
                        Duration = 3000
                    });

                    await LoadUsers();
                    await usersGrid.Reload();
                }
                else
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "❌ Error",
                        Detail = toggleResult.Message,
                        Duration = 5000
                    });
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "❌ Error",
                    Detail = $"Error al cambiar estado: {ex.Message}",
                    Duration = 5000
                });
            }
        }
    }
}