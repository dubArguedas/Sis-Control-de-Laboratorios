@code {
    RadzenDataGrid<UsuarioDto> usersGrid;
    private string? selectedUserType = null;
    private string searchTerm = "";
    private List<UsuarioDto> allUsers = new List<UsuarioDto>();

    protected override async Task OnInitializedAsync()
    {
        await EnlistarUsuarios();
    }

    private async Task EnlistarUsuarios()
    {
        // Verificar autenticación
        var token = TokenStateService.GetToken();
        if (string.IsNullOrEmpty(token))
        {
            NotificationService.Notify(NotificationSeverity.Warning,
                "Autenticación requerida",
                "Debe iniciar sesión para acceder a la gestión de usuarios");
            return;
        }

        allUsers = await UsuarioService.ListarUsuarios();

        if (!allUsers.Any())
        {
            NotificationService.Notify(NotificationSeverity.Info,
                "Sin datos",
                "No se pudieron cargar los usuarios. Verifique su conexión y permisos.");
        }

        if (usersGrid != null)
        {
            await usersGrid.Reload();
        }
    }

    private IEnumerable<UsuarioDto> filteredUsers
    {
        get
        {
            if (selectedUserType == null) return Enumerable.Empty<UsuarioDto>();

            var users = allUsers.Where(u => u.Rol == selectedUserType).ToList();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var search = searchTerm.Trim();
                users = users.Where(u =>
                    u.Nombre.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    u.ApellidoPaterno.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (u.ApellidoMaterno ?? "").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    u.CI.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    u.CorreoInstitucional.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            return users;
        }
    }

    private void SelectUserType(string type)
    {
        selectedUserType = type;
        searchTerm = "";
    }

    private string GetUserTypeTitle() => selectedUserType switch
    {
        "estudiante" => "Estudiantes",
        "docente" => "Docentes",
        "encargado" => "Encargados",
        _ => ""
    };

    private string GetUserTypeSingle() => selectedUserType switch
    {
        "estudiante" => "Estudiante",
        "docente" => "Docente",
        "encargado" => "Encargado",
        _ => ""
    };

    private string GetInitials(string nombre, string apellidoPaterno)
    {
        var inicialNombre = nombre.Length > 0 ? nombre[0].ToString().ToUpper() : "";
        var inicialApellido = apellidoPaterno.Length > 0 ? apellidoPaterno[0].ToString().ToUpper() : "";
        return $"{inicialNombre}{inicialApellido}";
    }

    void NavigateToCreate()
    {
        NavigationManager.NavigateTo($"/usuario-crear/{selectedUserType}");
    }

    void NavigateToEdit(int usuarioId)
    {
        NavigationManager.NavigateTo($"/usuario-editar/{usuarioId}");
    }


    async Task CerrarUsuario(int usuarioId)
{
    var usuario = allUsers.FirstOrDefault(u => u.UsuarioId == usuarioId);
    if (usuario == null) return;

    var accion = usuario.Estado == "activo" ? "desactivar" : "activar";
    var mensajeConfirmacion = usuario.Estado == "activo"
        ? "¿Está seguro de que desea desactivar este usuario?"
        : "¿Está seguro de que desea activar este usuario?";

    var result = await DialogService.Confirm(
        mensajeConfirmacion,
        "Confirmación de cambio de estado",
        new ConfirmOptions()
        {
            OkButtonText = "Sí",
            CancelButtonText = "No",
            CssClass = "mi-dialogo-eliminar",
            CloseDialogOnEsc = true
        }
    );

    if (result.HasValue && result.Value)
    {
        var mensaje = await UsuarioService.CambiarEstadoUsuario(usuarioId);

        if (mensaje.StartsWith("Error:"))
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error",
                "No se pudo cambiar el estado del usuario. Es posible que no tenga permisos suficientes.");
        }
        else
        {
            // 🔄 FORZAR ACTUALIZACIÓN DE LA LISTA
            await EnlistarUsuarios();
            
            var nuevoEstado = usuario.Estado == "activo" ? "desactivado" : "activado";
            NotificationService.Notify(NotificationSeverity.Success, "Estado cambiado",
                $"El usuario ha sido {nuevoEstado} correctamente.");
            
            // 🔄 FORZAR RE-RENDER DEL DATAGRID
            StateHasChanged();
        }
    }
    else
    {
        NotificationService.Notify(NotificationSeverity.Info, "Cancelado", "La operación fue cancelada.");
    }
}
    
}