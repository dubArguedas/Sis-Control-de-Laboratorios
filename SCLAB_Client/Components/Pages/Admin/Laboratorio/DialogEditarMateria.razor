@using Radzen
@using Radzen.Blazor
@inject DialogService DialogService

<RadzenCard Style="background-color: #ffe0b2; border: 3px solid #ff9800;">
    <h4 class="rz-mb-4">Asignación de Materia</h4>
    <RadzenLabel Text="Materia:" Component="TextBox" />
    <RadzenTextBox @bind-Value="Materia" Style="width:100%;" Placeholder="Escriba el nombre de la materia..." />
    <div class="mt-3 text-center">
        <RadzenButton Text="Guardar" Icon="save" Click="@(async _ => DialogService.Close(Materia))" Style="margin-right:10px;" />
        <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Secondary" Click="@(async _ => DialogService.Close(null))" />
    </div>
</RadzenCard>

@code {
    [Parameter] public string Materia { get; set; } = "";
}