@layout LoginLayout
@using Radzen
@using Radzen.Blazor
@inject DialogService DialogService

<RadzenCard>
    <p>Ingrese la materia o déjelo vacío para marcar como "LIBRE".</p>
    <RadzenTextBox @bind-Value="Materia" Style="width:100%" />
    <div class="mt-3 d-flex justify-content-end">
        <RadzenButton Text="Cancelar" Click="@(async _ => DialogService.Close(null))" ButtonStyle="ButtonStyle.Secondary" class="me-2" />
        <RadzenButton Text="Guardar" Click="@(async _ => DialogService.Close(Materia))" />
    </div>
</RadzenCard>

@code {
    [Parameter]
    public string Materia { get; set; } = "";
}
