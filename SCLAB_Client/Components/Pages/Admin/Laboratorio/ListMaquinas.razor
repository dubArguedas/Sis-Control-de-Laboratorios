@page "/maquinas/{laboratorio:int}"
@rendermode InteractiveServer
@using Radzen.Blazor
@using Radzen
@using SCLAB_Entities
@layout AdminLayout

@inject MaquinaService maquinaService
@inject NotificationService NotificationService
@inject NavigationManager navigationManager
@inject ContextMenuService ContextMenuService

<div class="header-container rz-p-12 rz-text-align-center rz-shadow-7"
     style="background: linear-gradient(135deg, #842a3b, #bf4b57);">
    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.Center" Gap="0.5rem">
        <RadzenText TextStyle="TextStyle.H2" Class="rz-color-white" Style="font-weight: 700;">
            Gestión de Máquinas
        </RadzenText>
        <RadzenText TextStyle="TextStyle.H5" Class="rz-color-white rz-pt-2">
            Equipos del laboratorio seleccionado
        </RadzenText>
    </RadzenStack>
</div>

<div style="margin-bottom: 1rem; margin-left:1rem;">
    <RadzenButton Icon="arrow_back"
                  Text="Volver a la lista de Laboratorios"
                  ButtonStyle="ButtonStyle.Light"
                  Click="@(() => navigationManager.NavigateTo("/laboratorios"))"
                  Style="background-color:#EFE9E3; color:#842a3b; min-width:150px;" />
</div>

<RadzenCard Style="margin: 1rem;">
    <RadzenDataGrid TItem="MaquinaListCLS"
                    Data="@maquinasFiltradas"
                    @ref="grid"
                    ColumnWidth="200px"
                    Responsive="true"
                    AllowFiltering="true"
                    AllowSorting="true"
                    AllowPaging="true"
                    PageSize="10"
                    RowHeight="55"
                    CellContextMenu="OnCellContextMenu">

        <Columns>
            <RadzenDataGridColumn TItem="MaquinaListCLS" Property="CodigoMaquina" Title="Código" />
            <RadzenDataGridColumn TItem="MaquinaListCLS" Property="DescripcionHardware" Title="Descripción" />
            <RadzenDataGridColumn TItem="MaquinaListCLS" Property="Estado" Title="Estado" />
            <RadzenDataGridColumn TItem="MaquinaListCLS" Property="LaboratorioCodigo" Title="Laboratorio" />
            <RadzenDataGridColumn TItem="MaquinaListCLS" Property="Ubicacion" Title="Ubicación" />
            <RadzenDataGridColumn TItem="MaquinaListCLS" Property="FechaRegistro" Title="Registro"
                                  FormatString="{0:dd/MM/yyyy}" />
        </Columns>

    </RadzenDataGrid>
</RadzenCard>

@code {
    [Parameter] public int laboratorio { get; set; }

    RadzenDataGrid<MaquinaListCLS>? grid;

    List<MaquinaListCLS> maquinas = new();
    List<MaquinaListCLS> maquinasFiltradas = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarMaquinas();
    }

    private async Task CargarMaquinas()
    {
        try
        {
            maquinas = await maquinaService.ListarMaquinas();

            maquinasFiltradas = maquinas
                .Where(x => x.LaboratorioId == laboratorio)
                .OrderBy(x => x.CodigoMaquina)
                .ToList();
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = "No se pudieron cargar las máquinas."
            });

        }
    }
    string MostrarUbicacion(string ubicacionDb)
    {
        return ubicacionDb switch
        {
            "torre_maestra" => "Torre Maestra",
            "torre_innovacion" => "Torre Innovación",
            _ => ubicacionDb
        };
    }
    void OnCellContextMenu(DataGridCellMouseEventArgs<MaquinaListCLS> args)
    {
        var maquina = args.Data;

        ContextMenuService.Open(args,
            new List<ContextMenuItem> {
                new() { Text = "Ver QR", Icon = "qr_code" },
                new() { Text = "Editar Máquina", Icon = "edit" },
                new() { Text = "Eliminar Máquina", Icon = "delete" }
            },
            async (e) =>
            {
                // ⚠️ Lo llenamos más adelante
                await Task.CompletedTask;
            }
        );
    }
}
