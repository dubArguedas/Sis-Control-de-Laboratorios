@code {
    // --- Variables de Estado ---
    private bool isLoading = false;
    private string selectedUbicacion = "";
    private int selectedLaboratorioId = 0;
    private List<string> ubicaciones = new();
    private List<LaboratorioResumenDto> laboratorios = new();
    private List<LaboratorioResumenDto> laboratoriosFiltrados = new();

    // Variables para filtros
    private string nombreMateria = "";
    private string diaSemana = "Lunes";
    private DateTime? horaInicio;
    private DateTime? horaFin;
    private List<string> diasSemana = new() { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" };
    private string filtroRol = "todos"; // todos, estudiante, docente

    // Variables para PDF
    private string pdfReportType = "general";
    private string pdfRoleFilter = "todos";
    private List<PdfGeneratedItem> generatedPdfs = new();

    public class PdfGeneratedItem
    {
        public string Url { get; set; } = "";
        public string Titulo { get; set; } = "";
        public string NombreArchivo { get; set; } = "";
        public DateTime Fecha { get; set; }
    }

    // Respuestas de API
    private DistribucionEstadosResponse? distribucionResponse;
    private MaquinasLaboratorioResponse? maquinasResponse;
    private ReporteAsistenciasResponse? asistenciasMateriaResponse;
    private ReporteAsistenciasResponse? asistenciasHorarioResponse;
    private ReporteAsistenciasResponse? asistenciasGeneralResponse;

    protected override async Task OnInitializedAsync()
    {
        await CargarLaboratorios();
    }

    private async Task CargarLaboratorios()
    {
        try
        {
            var resumen = await AdminDashboardService.ObtenerResumenLaboratorios();
            if (resumen != null)
            {
                laboratorios = resumen.Laboratorios;
                ubicaciones = laboratorios.Select(l => l.Ubicacion).Distinct().ToList();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "No se pudieron cargar los laboratorios.");
        }
    }

    private void OnUbicacionChanged()
    {
        laboratoriosFiltrados = laboratorios.Where(l => l.Ubicacion == selectedUbicacion).ToList();
        selectedLaboratorioId = 0;
    }

    // --- Métodos de Consulta ---

    private async Task ConsultarDistribucion()
    {
        if (selectedLaboratorioId == 0) return;
        isLoading = true;
        try
        {
            distribucionResponse = await ReportesService.ObtenerDistribucionEstados(selectedLaboratorioId);
            maquinasResponse = await AdminDashboardService.ObtenerMaquinasLaboratorio(selectedLaboratorioId);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error al cargar distribución: {ex.Message}");
        }
        finally { isLoading = false; }
    }

    private async Task ConsultarMateriaDocente()
    {
        if (string.IsNullOrWhiteSpace(nombreMateria))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Atención", "Ingrese el nombre de la materia.");
            return;
        }
        isLoading = true;
        try
        {
            asistenciasMateriaResponse = await ReportesService.ObtenerAsistenciasPorMateria(nombreMateria);
            if (asistenciasMateriaResponse?.Asistencias.Count == 0)
                NotificationService.Notify(NotificationSeverity.Info, "Sin resultados", "No se encontraron asistencias.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error al buscar: {ex.Message}");
        }
        finally { isLoading = false; }
    }

    private async Task ConsultarMateriaEstudiante()
    {
        if (string.IsNullOrWhiteSpace(nombreMateria))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Atención", "Ingrese el nombre de la materia.");
            return;
        }
        isLoading = true;
        try
        {
            asistenciasMateriaResponse = await ReportesService.ObtenerAsistenciasEstudiantesporMateria(nombreMateria);
            if (asistenciasMateriaResponse?.Asistencias.Count == 0)
                NotificationService.Notify(NotificationSeverity.Info, "Sin resultados", "No se encontraron asistencias.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error al buscar: {ex.Message}");
        }
        finally { isLoading = false; }
    }

    private async Task ConsultarHorario()
    {
        if (!horaInicio.HasValue || !horaFin.HasValue)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Atención", "Seleccione hora de inicio y fin.");
            return;
        }
        isLoading = true;
        try
        {
            asistenciasHorarioResponse = await ReportesService.ObtenerAsistenciasporHorario(diaSemana, horaInicio.Value.TimeOfDay, horaFin.Value.TimeOfDay);
            if (asistenciasHorarioResponse?.Asistencias.Count == 0)
                NotificationService.Notify(NotificationSeverity.Info, "Sin resultados", "No se encontraron asistencias en ese horario.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error al buscar por horario: {ex.Message}");
        }
        finally { isLoading = false; }
    }

    private async Task ConsultarGeneral(string tipo)
    {
        isLoading = true;
        try
        {
            asistenciasGeneralResponse = tipo switch
            {
                "general" => await ReportesService.ObtenerAsistenciasGeneral(),
                "programada" => await ReportesService.ObtenerAsistenciasProgramada(),
                "uso_libre" => await ReportesService.ObtenerAsistenciasUso_libre(),
                _ => null
            };

            if (asistenciasGeneralResponse?.Asistencias.Count == 0)
                NotificationService.Notify(NotificationSeverity.Info, "Info", "No hay datos para mostrar.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error al cargar reporte", $"Detalle: {ex.Message}");
        }
        finally { isLoading = false; }
    }

    private void OnRolFilterChanged()
    {
        StateHasChanged();
    }

    private IEnumerable<AsistenciaReporteDto> FilteredAsistencias
    {
        get
        {
            if (asistenciasGeneralResponse?.Asistencias == null) return Enumerable.Empty<AsistenciaReporteDto>();
            if (filtroRol == "todos") return asistenciasGeneralResponse.Asistencias;
            return asistenciasGeneralResponse.Asistencias.Where(a => a.Rol?.ToLower() == filtroRol);
        }
    }

    private string GetStatusClass(string estado)
    {
        return estado.ToLower() switch
        {
            "disponible" => "disponible",
            "ocupado" => "ocupado",
            "mantenimiento" => "mantenimiento",
            _ => ""
        };
    }

    // --- Lógica de PDF ---

    private void ShowPdfFilterDialog()
    {
        DialogService.Open("Opciones de Reporte PDF", ds =>
    @<RadzenStack Gap="1.5rem" Class="rz-p-4">
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Tipo de Reporte</RadzenText>
        <RadzenRadioButtonList @bind-Value="pdfReportType" TValue="string" Orientation="Orientation.Vertical">
            <Items>
                <RadzenRadioButtonListItem Text="General (Todo)" Value="@("general")" />
                <RadzenRadioButtonListItem Text="Clases Programadas" Value="@("programada")" />
                <RadzenRadioButtonListItem Text="Uso Libre" Value="@("uso_libre")" />
            </Items>
        </RadzenRadioButtonList>

        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" Class="rz-mt-2">Filtrar Usuarios</RadzenText>
        <RadzenRadioButtonList @bind-Value="pdfRoleFilter" TValue="string" Orientation="Orientation.Horizontal">
            <Items>
                <RadzenRadioButtonListItem Text="Todos" Value="@("todos")" />
                <RadzenRadioButtonListItem Text="Estudiantes" Value="@("estudiante")" />
                <RadzenRadioButtonListItem Text="Docentes" Value="@("docente")" />
            </Items>
        </RadzenRadioButtonList>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Class="rz-mt-4">
            <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="() => ds.Close(false)" />
            <RadzenButton Text="Generar PDF" Icon="picture_as_pdf" ButtonStyle="ButtonStyle.Danger" Click="() => { ds.Close(true); GenerarPdf(); }" />
        </RadzenStack>
    </RadzenStack>, new DialogOptions() { Width = "400px", CloseDialogOnOverlayClick = true });
    }

    private async Task GenerarPdf()
    {
        isLoading = true;
        try
        {
            // 1. Obtener datos según filtros seleccionados en el modal
            ReporteAsistenciasResponse? datosRaw = pdfReportType switch
            {
                "general" => await ReportesService.ObtenerAsistenciasGeneral(),
                "programada" => await ReportesService.ObtenerAsistenciasProgramada(),
                "uso_libre" => await ReportesService.ObtenerAsistenciasUso_libre(),
                _ => null
            };

            if (datosRaw?.Asistencias == null || !datosRaw.Asistencias.Any())
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Sin datos", "No hay registros para generar el PDF.");
                return;
            }

            // 2. Aplicar filtro de rol
            var datosFiltrados = datosRaw.Asistencias;
            if (pdfRoleFilter != "todos")
            {
                datosFiltrados = datosFiltrados.Where(a => a.Rol?.ToLower() == pdfRoleFilter).ToList();
            }

            if (!datosFiltrados.Any())
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Sin datos", "No hay registros con el rol seleccionado.");
                return;
            }

            // 3. Preparar datos para JS
            var datosParaJs = datosFiltrados.Select(a => new[]
            {
                a.FechaRegistro.ToString("g"),
                a.NombreMostrar,
                a.Rol,
                a.LaboratorioCodigo,
                a.Materia ?? "-",
                a.Observacion ?? "-",
                a.HoraIngresoStr,
                a.HoraSalidaStr
            }).ToList();

            var columnas = new string[] { "Fecha", "Usuario", "Rol", "Lab", "Materia", "Obs.", "Ingreso", "Salida" };
            var titulo = $"Reporte {pdfReportType.Replace("_", " ").ToUpper()} - {pdfRoleFilter.ToUpper()}";
            var logoUrl = "/images/uniolog.png";

            // 4. Invocar JS y obtener URL
            var blobUrl = await JSRuntime.InvokeAsync<string>("reportes.generarPDF", titulo, datosParaJs, columnas, logoUrl);

            // 5. Agregar a la lista
            if (!string.IsNullOrEmpty(blobUrl))
            {
                generatedPdfs.Insert(0, new PdfGeneratedItem
                {
                    Url = blobUrl,
                    Titulo = titulo,
                    Fecha = DateTime.Now,
                    NombreArchivo = $"Reporte_{DateTime.Now:HHmmss}.pdf"
                });
                NotificationService.Notify(NotificationSeverity.Success, "Éxito", "PDF generado correctamente.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error al generar PDF: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task AbrirPdf(string url)
    {
        await JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
    }
}