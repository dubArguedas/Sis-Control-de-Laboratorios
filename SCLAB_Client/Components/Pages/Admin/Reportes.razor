        {
            case "Usuarios por Rol": return data.GroupBy(x => x.Rol ?? "?").Select(g => new ChartDataItem { Category = g.Key, Value = g.Count() }).ToList();
            case "Asistencia por Tipo": return data.GroupBy(x => x.Tipo ?? "?").Select(g => new ChartDataItem { Category = g.Key, Value = g.Count() }).ToList();
            case "Top 10 Máquinas": return data.GroupBy(x => x.MaquinaCodigo ?? "-").OrderByDescending(g => g.Count()).Take(10).Select(g => new ChartDataItem { Category = g.Key, Value = g.Count() }).ToList();
            case "Top Laboratorios": return data.GroupBy(x => x.LaboratorioCodigo ?? "-").Select(g => new ChartDataItem { Category = g.Key, Value = g.Count() }).ToList();
            case "Distribución por Hora": return data.GroupBy(x => x.HoraIngresoStr?.Split(':')[0] + ":00" ?? "-").OrderBy(g => g.Key).Select(g => new ChartDataItem { Category = g.Key, Value = g.Count() }).ToList();
            case "Top Observaciones": return data.Where(x => !string.IsNullOrEmpty(x.Observacion)).GroupBy(x => x.Observacion).OrderByDescending(g => g.Count()).Take(5).Select(g => new ChartDataItem { Category = g.Key.Length > 20 ? g.Key.Substring(0, 20) + "..." : g.Key, Value = g.Count() }).ToList();
            default: return new List<ChartDataItem>();
        }
    }
    private List<ChartDataItem> GetDistribucionChartData()
    {
        if (distribucionResponse == null) return new List<ChartDataItem>();
        return distribucionResponse.Distribucion.Select(x => new ChartDataItem { Category = x.Estado, Value = x.Cantidad }).ToList();
    }
    private RenderFragment RenderStatisticsSection(List<AsistenciaReporteDto> data, string contextKey)
    {
        var totalUsuarios = data.Select(x => x.NombreMostrar).Distinct().Count();
        var totalMaquinas = data.Select(x => x.MaquinaCodigo).Distinct().Count();
        var obsComun = data.Where(x => !string.IsNullOrEmpty(x.Observacion))
                           .GroupBy(x => x.Observacion)
                           .OrderByDescending(g => g.Count())
                           .Select(g => g.Key).FirstOrDefault() ?? "Ninguna";
        var maqMasUsada = data.GroupBy(x => x.MaquinaCodigo)
                              .OrderByDescending(g => g.Count())
                              .Select(g => g.Key).FirstOrDefault() ?? "-";

        var currentConfig = GetChartConfig(contextKey);

        return @<div class="stats-dashboard-container">
            <div class="stats-header"><RadzenIcon Icon="insights" /> Estadísticas y Métricas Avanzadas</div>

            <div class="stats-grid-mini">
                <div class="mini-stat">
                    <span class="label">Usuarios Únicos</span>
                    <span class="value">@totalUsuarios</span>
                </div>
                <div class="mini-stat">
                    <span class="label">Máq. Activas</span>
                    <span class="value">@totalMaquinas</span>
                </div>
                <div class="mini-stat">
                    <span class="label">Obs. Común</span>
                    <span class="value text-truncate">@obsComun</span>
                </div>
                <div class="mini-stat">
                    <span class="label">Máq. Top 1</span>
                    <span class="value">@maqMasUsada</span>
                </div>
            </div>

            <div class="stats-toolbar">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenLabel Text="Gráfico:" />
                        <RadzenDropDown TValue="string" Value=@currentConfig.ChartType Change="@(args => UpdateChartConfig(contextKey, args.ToString(), currentConfig.Metric))"
                                        Data="@(new List<string> { "Bar", "Column", "Pie", "Donut" })"
                                        Class="chart-dropdown" />
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenLabel Text="Métrica:" />
                        <RadzenDropDown TValue="string" Value=@currentConfig.Metric Change="@(args => UpdateChartConfig(contextKey, currentConfig.ChartType, args.ToString()))"
                                        Data="@(new List<string> { "Usuarios por Rol", "Asistencia por Tipo", "Top 10 Máquinas", "Top Laboratorios", "Distribución por Hora", "Top Observaciones" })"
                                        Class="chart-dropdown" Style="width: 250px;" />
                    </RadzenStack>
                </RadzenStack>
            </div>

            <div class="chart-area">
                <RadzenChart ColorScheme="ColorScheme.Palette" Style="height: 400px;">
                    @if (currentConfig.ChartType == "Bar")
                    {
                        <RadzenBarSeries Data="@GetChartData(data, currentConfig.Metric)" CategoryProperty="Category" ValueProperty="Value" Title="Cantidad" LineType="LineType.Dashed">
                            <RadzenSeriesDataLabels Visible="true" />
                        </RadzenBarSeries>
                        <RadzenBarOptions Radius="5" />
                        <RadzenValueAxis><RadzenGridLines Visible="true" /></RadzenValueAxis>
                    }
                    else if (currentConfig.ChartType == "Column")
                    {
                        <RadzenColumnSeries Data="@GetChartData(data, currentConfig.Metric)" CategoryProperty="Category" ValueProperty="Value" Title="Cantidad">
                            <RadzenSeriesDataLabels Visible="true" />
                        </RadzenColumnSeries>
                        <RadzenColumnOptions Radius="5" />
                        <RadzenValueAxis><RadzenGridLines Visible="true" /></RadzenValueAxis>
                    }
                    else if (currentConfig.ChartType == "Pie")
                    {
                        <RadzenPieSeries Data="@GetChartData(data, currentConfig.Metric)" CategoryProperty="Category" ValueProperty="Value" Title="Cantidad">
                            <RadzenSeriesDataLabels Visible="true" />
                        </RadzenPieSeries>
                    }
                    else if (currentConfig.ChartType == "Donut")
                    {
                        <RadzenDonutSeries Data="@GetChartData(data, currentConfig.Metric)" CategoryProperty="Category" ValueProperty="Value" Title="Cantidad">
                            <RadzenSeriesDataLabels Visible="true" />
                        </RadzenDonutSeries>
                    }
                    <RadzenLegend Position="LegendPosition.Bottom" />
                </RadzenChart>
            </div>
        </div>;
    }

