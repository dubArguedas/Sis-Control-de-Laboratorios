    private async Task GenerarPdf() { }

    private async Task GenerarPdfHorario()
    {
        isLoading = true;
        try
        {
            var listaFinal = FilteredAsistenciasHorarioCompleto.OrderBy(x => x.HoraIngresoStr).ToList();

            if (!listaFinal.Any()) { NotificationService.Notify(NotificationSeverity.Warning, "Sin datos", "No hay registros."); return; }

            // 1. Preparar datos tabla con MAYÚSCULAS
            var datosParaJs = listaFinal.Select(a => new[]
            {
                a.FechaRegistro.ToString("dd/MM/yyyy"),
                a.NombreMostrar,
                a.Rol?.ToUpper(),
                // LÓGICA DE TEXTO: USO LIBRE / PROGRAMADA (Mayúsculas completas)
                (a.Tipo?.ToLower() == "uso_libre" ? "USO LIBRE" : (a.Tipo?.ToLower() == "programada" ? "PROGRAMADA" : a.Tipo?.ToUpper())),
                a.MaquinaCodigo ?? "-",
                // Si es uso libre, en materia ponemos USO LIBRE
                (string.IsNullOrEmpty(a.Materia) || a.Tipo == "uso_libre") ? "USO LIBRE" : a.Materia,
                a.HoraIngresoStr ?? "-",
                a.HoraSalidaStr ?? "-",
                a.Observacion ?? "-"
            }).ToList();

            var statsParaJs = new
            {
                totalRows = listaFinal.Count,
                uniqueUsers = listaFinal.Select(x => x.NombreMostrar).Distinct().Count(),
                uniqueMachines = listaFinal.Select(x => x.MaquinaCodigo).Distinct().Count()
            };

            // MODIFICADO: Antes calculábamos 'trendData', ahora ya no es necesario para el PDF.
            // Si quisieras mantener el cálculo por si acaso, lo puedes dejar, pero para optimizar lo omito o paso null.
            
            var columnas = new string[] { "Fecha", "Usuario", "Rol", "Tipo", "Máquina", "Materia", "Inicio", "Fin", "Obs." };

            // Título
            var titulo = $"REPORTE HORARIO: {diaSemana.ToUpper()}";
            if (!string.IsNullOrEmpty(horarioNombreMateria)) titulo += $" - {horarioNombreMateria}";

            // Obtener NOMBRE del laboratorio
            string? nombreLaboratorio = null;
            if (horarioSelectedLabId > 0)
            {
                var lab = horarioLaboratoriosFiltrados.FirstOrDefault(l => l.LaboratorioId == horarioSelectedLabId);
                nombreLaboratorio = lab?.Codigo;
                titulo += $" ({nombreLaboratorio})";
            }

            // 3. PREPARAR FILTROS COMPLETOS
            var filtros = new
            {
                dia_semana = diaSemana,
                tipo_uso = horarioTipoAsistencia,
                rol = horarioFiltroRol,
                materia = !string.IsNullOrEmpty(horarioNombreMateria) ? horarioNombreMateria : null,

                ubicacion = !string.IsNullOrEmpty(horarioSelectedUbicacion) ? horarioSelectedUbicacion : null,
                laboratorio = nombreLaboratorio,
                maquina = !string.IsNullOrEmpty(codigoMaquinaFilter) ? codigoMaquinaFilter : null,

                fecha_inicio = fechaInicioHorario.HasValue ? fechaInicioHorario.Value.ToString("yyyy-MM-dd") : null,
                fecha_fin = fechaFinHorario.HasValue ? fechaFinHorario.Value.ToString("yyyy-MM-dd") : null,
                hora_inicio = horaInicio.HasValue ? horaInicio.Value.ToString("HH:mm") : null
            };

            var logoUrl = "/images/uniolog.png";

            // MODIFICADO: Aquí pasamos 'null' en lugar de 'trendData' en el parámetro del gráfico (el 6º argumento)
            var result = await JSRuntime.InvokeAsync<PdfResultJs>("reportes.generarPDF",
                titulo, datosParaJs, columnas, logoUrl, null, "Bar", statsParaJs, filtros
            );

            if (result != null && !string.IsNullOrEmpty(result.blobUrl))
            {
                generatedPdfs.Insert(0, new PdfGeneratedItem
                {
                    Url = result.blobUrl,
                    Titulo = titulo,
                    Fecha = DateTime.Now,
                    NombreArchivo = result.nombrePDF
                });
                NotificationService.Notify(NotificationSeverity.Success, "Éxito", "PDF generado.");
            }
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message); }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task AbrirPdf(string url) { await JSRuntime.InvokeVoidAsync("window.open", url, "_blank"); }
