    private async Task ConsultarGeneral(string tipo)
    {
        isLoading = true;
        try
        {
            asistenciasGeneralResponse = tipo switch
            {
                "general" => await ReportesService.ObtenerAsistenciasGeneral(),
                "programada" => await ReportesService.ObtenerAsistenciasProgramada(),
                "uso_libre" => await ReportesService.ObtenerAsistenciasUso_libre(),
                _ => null
            };

            if (asistenciasGeneralResponse?.Asistencias.Count == 0)
                NotificationService.Notify(NotificationSeverity.Info, "Info", "No hay datos para mostrar.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error al cargar reporte", $"Detalle: {ex.Message}");
        }
        finally { isLoading = false; }
    }

    private void OnRolFilterChanged()
    {
        StateHasChanged();
    }

    private IEnumerable<AsistenciaReporteDto> FilteredAsistencias
    {
        get
        {
            if (asistenciasGeneralResponse?.Asistencias == null) return Enumerable.Empty<AsistenciaReporteDto>();
            if (filtroRol == "todos") return asistenciasGeneralResponse.Asistencias;
            return asistenciasGeneralResponse.Asistencias.Where(a => a.Rol?.ToLower() == filtroRol);
        }
    }

    private string GetStatusClass(string estado)
    {
        return estado.ToLower() switch
        {
            "disponible" => "disponible",
            "ocupado" => "ocupado",
            "mantenimiento" => "mantenimiento",
            _ => ""
        };
    }

    private async Task ExportarPDF()
    {
        if (asistenciasGeneralResponse?.Asistencias == null || !asistenciasGeneralResponse.Asistencias.Any())
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Atención", "No hay datos para exportar.");
            return;
        }

        var datos = FilteredAsistencias.Select(a => new[]
        {
            a.FechaRegistro.ToString("g"),
            a.NombreMostrar,
            a.Rol,
            a.LaboratorioCodigo,
            a.Materia ?? "-",
            a.Observacion ?? "-",
            a.HoraIngresoStr,
            a.HoraSalidaStr
        }).ToList();

        var columnas = new string[] {"Fecha", "Usuario", "Rol", "Lab", "Materia", "Obs.", "Ingreso", "Salida"};
        var titulo = "Reporte Diario de Asistencias";
        var logoUrl = "/images/uniolog.png";

        await JSRuntime.InvokeVoidAsync("reportes.generarPDF", titulo, datos, columnas, logoUrl);
    }
}