    private async Task ConsultarMateriaDocente() => await ConsultarMateriaGenerico("docente");
    private async Task ConsultarMateriaEstudiante() => await ConsultarMateriaGenerico("estudiante");
    private async Task ConsultarMateriaGenerico(string rol)
    {
        if (string.IsNullOrWhiteSpace(nombreMateria)) return;
        isLoading = true;
        try { asistenciasMateriaResponse = await ReportesService.ObtenerAsistenciasPorMateria(nombreMateria, rol, fechaFiltroMateria, materiaCodigoMaquinaFilter, materiaSelectedLabId, materiaSelectedUbicacion); }
        catch { }
        finally { isLoading = false; }
    }
    
    private async Task ConsultarHorario()
    {
        if (!horaInicio.HasValue)
        {
            await DialogService.Alert(
                "Por favor, selecciona una Hora de Inicio para realizar la búsqueda.", 
                "HORARIO OBLIGATORIO", 
                new AlertOptions() { OkButtonText = "Entendido", Width = "400px" }
            );
            return; 
        }

        isLoading = true;
        try
        {
            TimeSpan fin = horaFin.HasValue ? horaFin.Value.TimeOfDay : new TimeSpan(23, 59, 59);
            asistenciasHorarioResponse = await ReportesService.ObtenerAsistenciasporHorario(
                diaSemana, 
                horaInicio.Value.TimeOfDay, 
                fin, 
                codigoMaquinaFilter, 
                horarioSelectedLabId, 
                horarioSelectedUbicacion
            );
            
            if (asistenciasHorarioResponse == null || !asistenciasHorarioResponse.Asistencias.Any())
            {
                 NotificationService.Notify(NotificationSeverity.Warning, "Sin Resultados", "No se encontraron registros con esos criterios.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "Error al consultar: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }


