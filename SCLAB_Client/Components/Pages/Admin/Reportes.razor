@page "/reportes"

@using SCLAB_Client.Components.Service
@using SCLAB_Client.Models
@using SCLAB_Client.Components.Service.ServiciosApi
@using SCLAB_Client.Services
@using System.Linq.Dynamic.Core

@inject AdminDashboardService AdminDashboardService
@inject ReportesService ReportesService
@inject CronogramaService CronogramaService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@layout AdminLayout

<PageTitle>Reportes y Observaciones</PageTitle>

<div class="pacha-layout">
    <div class="admin-header">
        <h1>Reportes y Observaciones</h1>
        <p>Gestión y monitoreo de laboratorios en tiempo real</p>
    </div>

    <div class="content-wrapper main-content" style="max-width: 98%;">
        <RadzenCard Class="pacha-card main-card">
            @if (isLoading)
            {
                <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Class="pacha-progress" />
            }
            
            <RadzenTabs RenderMode="TabRenderMode.Client" Class="pacha-tabs">
                <Tabs>
                    <!-- TAB: Distribución -->
                    <RadzenTabsItem Text="Distribución">
                        <Content>
                            <RadzenStack Gap="1rem" Class="rz-p-2">
                                <div class="filters-container">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenLabel Text="Ubicación:" Class="filter-label" />
                                            <RadzenDropDown @bind-Value="selectedUbicacion" 
                                                            Data="@ubicaciones" 
                                                            Name="Ubicacion"
                                                            Placeholder="Seleccione..." 
                                                            Change="@OnUbicacionChanged" 
                                                            Class="pacha-dropdown" 
                                                            Style="width: 220px;" />
                                        </RadzenStack>
                                        
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenLabel Text="Laboratorio:" Class="filter-label" />
                                            <RadzenDropDown @bind-Value="selectedLaboratorioId" 
                                                            Data="@laboratoriosFiltrados"
                                                            TextProperty="Codigo" 
                                                            ValueProperty="LaboratorioId" 
                                                            Name="Laboratorio"
                                                            Placeholder="Seleccione..." 
                                                            Disabled="@(string.IsNullOrEmpty(selectedUbicacion))"
                                                            Class="pacha-dropdown" 
                                                            Style="width: 220px;" />
                                        </RadzenStack>
                                        
                                        <RadzenButton Text="Consultar" 
                                                      Icon="search" 
                                                      Click="@ConsultarDistribucion"
                                                      ButtonStyle="ButtonStyle.Primary" 
                                                      Disabled="@(selectedLaboratorioId == 0)"
                                                      Class="btn-pacha" />
                                    </RadzenStack>
                                </div>
                                
                                @if (distribucionResponse != null)
                                {
                                    <div class="stats-grid">
                                        <div class="stat-card total">
                                            <div class="stat-icon">
                                                <RadzenIcon Icon="computer" />
                                            </div>
                                            <div class="stat-info">
                                                <span class="stat-label">Total Máquinas</span>
                                                <span class="stat-value">@distribucionResponse.TotalMaquinas</span>
                                            </div>
                                        </div>
                                        
                                        @foreach (var estado in distribucionResponse.Distribucion)
                                        {
                                            <div class="stat-card @estado.Estado.ToLower()">
                                                <div class="stat-info">
                                                    <span class="stat-label">@estado.Estado</span>
                                                    <span class="stat-value">@estado.Cantidad</span>
                                                    <span class="stat-percent">@estado.Porcentaje%</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    
                                    <!-- GRÁFICO DE DISTRIBUCIÓN -->
                                    <div class="stats-dashboard-container">
                                        <div class="stats-header">
                                            <RadzenIcon Icon="analytics" /> Estadísticas Visuales
                                        </div>
                                        <div class="stats-toolbar">
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                                                <RadzenLabel Text="Tipo de Gráfico:" />
                                                <RadzenSelectBar @bind-Value="distribucionChartType" TValue="string" Class="chart-select-bar">
                                                    <Items>
                                                        <RadzenSelectBarItem Text="Barras" Value="@("Bar")" Icon="bar_chart" />
                                                        <RadzenSelectBarItem Text="Pastel" Value="@("Pie")" Icon="pie_chart" />
                                                        <RadzenSelectBarItem Text="Donut" Value="@("Donut")" Icon="donut_large" />
                                                    </Items>
                                                </RadzenSelectBar>
                                            </RadzenStack>
                                        </div>
                                        <div class="chart-area">
                                            <RadzenChart ColorScheme="ColorScheme.Palette" Style="height: 350px;">
                                                @if (distribucionChartType == "Bar")
                                                {
                                                    <RadzenColumnSeries Data="@GetDistribucionChartData()" CategoryProperty="Category" ValueProperty="Value" Title="Cantidad">
                                                        <RadzenSeriesDataLabels Visible="true" />
                                                    </RadzenColumnSeries>
                                                    <RadzenColumnOptions Radius="5" />
                                                }
                                                else if (distribucionChartType == "Pie")
                                                {
                                                    <RadzenPieSeries Data="@GetDistribucionChartData()" CategoryProperty="Category" ValueProperty="Value" Title="Cantidad">
                                                        <RadzenSeriesDataLabels Visible="true" />
                                                    </RadzenPieSeries>
                                                }
                                                else if (distribucionChartType == "Donut")
                                                {
                                                    <RadzenDonutSeries Data="@GetDistribucionChartData()" CategoryProperty="Category" ValueProperty="Value" Title="Cantidad">
                                                        <RadzenSeriesDataLabels Visible="true" />
                                                    </RadzenDonutSeries>
                                                }
                                            </RadzenChart>
                                        </div>
                                    </div>
                                    
                                    @if (maquinasResponse != null && maquinasResponse.Maquinas.Any())
                                    {
                                        <div class="section-divider">
                                            <span>Máquinas en @maquinasResponse.Codigo</span>
                                        </div>
                                        
                                        <RadzenDataList WrapItems="true" 
                                                       AllowPaging="true" 
                                                       Data="@maquinasResponse.Maquinas" 
                                                       TItem="MaquinaResumenDto" 
                                                       PageSize="12" 
                                                       PagerHorizontalAlign="HorizontalAlign.Left" 
                                                       ShowPagingSummary="true">
                                            <Template Context="maquina">
                                                <div class="machine-card @GetStatusClass(maquina.Estado)">
                                                    <div class="machine-header">
                                                        <span class="machine-code">@maquina.CodigoMaquina</span>
                                                        @if (maquina.TieneQr)
                                                        {
                                                            <RadzenIcon Icon="qr_code_2" Class="qr-icon" />
                                                        }
                                                    </div>
                                                    
                                                    <div class="machine-body">
                                                        <p class="hardware-desc">
                                                            @(string.IsNullOrEmpty(maquina.DescripcionHardware) ? "Sin descripción" : maquina.DescripcionHardware)
                                                        </p>
                                                        
                                                        @if (maquina.AsistenciaActiva != null)
                                                        {
                                                            <div class="user-info">
                                                                <div class="user-row">
                                                                    <RadzenIcon Icon="person" />
                                                                    <span>@maquina.AsistenciaActiva.UsuarioNombre</span>
                                                                </div>
                                                                <div class="user-row time">
                                                                    <RadzenIcon Icon="timer" />
                                                                    <span>@maquina.AsistenciaActiva.TiempoTranscurrido min</span>
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="empty-state">@maquina.Estado</div>
                                                        }
                                                    </div>
                                                    
                                                    @if (maquina.AlertaActiva != null)
                                                    {
                                                        <div class="machine-alert">
                                                            <RadzenIcon Icon="warning" />
                                                            <span>@maquina.AlertaActiva.Descripcion</span>
                                                        </div>
                                                    }
                                                </div>
                                            </Template>
                                        </RadzenDataList>
                                    }
                                }
                            </RadzenStack>
                        </Content>
                    </RadzenTabsItem>

                    <!-- TAB: GENERAL -->
                    <RadzenTabsItem Text="REPORTES">
                        <Content>
                            <RadzenStack Gap="1.5rem" Class="rz-p-3">
                                
                                <RadzenRow Gap="1rem" AlignItems="AlignItems.Normal">
                                    
                                    <RadzenColumn Size="12" SizeMD="8" SizeLG="9">
                                        <RadzenStack Gap="1.5rem">
                                            <div class="filtros-principales-container" style="height: 100%;">
                                                <RadzenRow Gap="1rem" AlignItems="AlignItems.Stretch" Style="height: 100%;">
                                                    <RadzenColumn Size="12" SizeMD="6">
                                                        <div class="filtro-principal-card">
                                                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" Class="filtro-principal-title">
                                                                <RadzenIcon Icon="category" /> Tipo de Asistencia
                                                            </RadzenText>
                                                            <RadzenRadioButtonList @bind-Value="horarioTipoAsistencia" TValue="string" Orientation="Orientation.Horizontal" Class="radio-buttons-custom">
                                                                <Items>
                                                                    <RadzenRadioButtonListItem Text="General" Value="@("general")" />
                                                                    <RadzenRadioButtonListItem Text="Programada" Value="@("programada")" />
                                                                    <RadzenRadioButtonListItem Text="Uso Libre" Value="@("uso_libre")" />
                                                                </Items>
                                                            </RadzenRadioButtonList>
                                                        </div>
                                                    </RadzenColumn>
                                                    <RadzenColumn Size="12" SizeMD="6">
                                                        <div class="filtro-principal-card">
                                                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" Class="filtro-principal-title">
                                                                <RadzenIcon Icon="people" /> Rol de Usuario
                                                            </RadzenText>
                                                            <RadzenRadioButtonList @bind-Value="horarioFiltroRol" TValue="string" Orientation="Orientation.Horizontal" Class="radio-buttons-custom">
                                                                <Items>
                                                                    <RadzenRadioButtonListItem Text="Todos" Value="@("todos")" />
                                                                    <RadzenRadioButtonListItem Text="Estudiantes" Value="@("estudiante")" />
                                                                    <RadzenRadioButtonListItem Text="Docentes" Value="@("docente")" />
                                                                </Items>
                                                            </RadzenRadioButtonList>
                                                        </div>
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            </div>

                                            <div class="filters-container-structured">
                                                <RadzenRow Gap="2rem">
                                                    <RadzenColumn Size="12" SizeLG="6">
                                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" Style="color: #842a3b; font-weight: 600; margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 5px;">
                                                            <RadzenIcon Icon="schedule" /> Filtros de Tiempo y Materia
                                                        </RadzenText>
                                                        <RadzenStack Gap="1rem">
                                                            <div>
                                                                <RadzenLabel Text="Materia (Opcional)" Style="font-size: 0.8rem; color: #666; display: block; margin-bottom: 4px;" />
                                                                <RadzenDropDown @bind-Value="horarioNombreMateria" Data="@listaMateriasCronograma" Placeholder="Todas las materias" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Style="width: 100%; border-radius: 6px;" />
                                                            </div>
                                                            <RadzenRow Gap="0.5rem">
                                                                <RadzenColumn Size="4">
                                                                    <RadzenLabel Text="Día" Style="font-size: 0.8rem; color: #666; display: block; margin-bottom: 4px;" />
                                                                    <RadzenDropDown @bind-Value="diaSemana" Data="@diasSemana" Style="width: 100%;" />
                                                                </RadzenColumn>
                                                                <RadzenColumn Size="4">
                                                                    <RadzenLabel Text="H. Inicio" Style="font-size: 0.8rem; color: #666; display: block; margin-bottom: 4px;" />
                                                                    <RadzenDatePicker @bind-Value="horaInicio" ShowTime="true" TimeOnly="true" DateFormat="HH:mm" Placeholder="07:30" Style="width: 100%;" />
                                                                </RadzenColumn>
                                                                <RadzenColumn Size="4">
                                                                    <RadzenLabel Text="H. Fin (Opc)" Style="font-size: 0.8rem; color: #666; display: block; margin-bottom: 4px;" />
                                                                    <RadzenDatePicker @bind-Value="horaFin" ShowTime="true" TimeOnly="true" DateFormat="HH:mm" Placeholder="Sin límite" Style="width: 100%;" />
                                                                </RadzenColumn>
                                                            </RadzenRow>
                                                            <div>
                                                                <RadzenLabel Text="Rango de Fechas (Opcional)" Style="font-size: 0.8rem; color: #666; display: block; margin-bottom: 4px;" />
                                                                <RadzenRow Gap="0.5rem">
                                                                    <RadzenColumn Size="6">
                                                                        <RadzenDatePicker @bind-Value="fechaInicioHorario" DateFormat="dd/MM/yyyy" Placeholder="Desde" AllowClear="true" Change="@OnFechaHorarioChanged" Style="width: 100%;" />
                                                                    </RadzenColumn>
                                                                    <RadzenColumn Size="6">
                                                                        <RadzenDatePicker @bind-Value="fechaFinHorario" DateFormat="dd/MM/yyyy" Placeholder="Hasta" AllowClear="true" Change="@OnFechaHorarioChanged" Style="width: 100%;" />
                                                                    </RadzenColumn>
                                                                </RadzenRow>
                                                            </div>
                                                        </RadzenStack>
                                                    </RadzenColumn>

                                                    <RadzenColumn Size="12" SizeLG="6">
                                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" Style="color: #842a3b; font-weight: 600; margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 5px;">
                                                            <RadzenIcon Icon="computer" /> Filtro por Máquina (Opcional)
                                                        </RadzenText>
                                                        <RadzenStack Gap="1rem">
                                                            <div>
                                                                <RadzenLabel Text="1. Torre/Ubicación" Style="font-size: 0.8rem; color: #666; display: block; margin-bottom: 4px;" />
                                                                <div style="display: flex; gap: 5px;">
                                                                    <RadzenDropDown @bind-Value="horarioSelectedUbicacion" Data="@ubicaciones" Placeholder="Todas las ubicaciones" Change="@OnHorarioUbicacionChanged" Style="width: 100%;" />
                                                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => LimpiarFiltroHorario("ubicacion"))" Disabled="@(string.IsNullOrEmpty(horarioSelectedUbicacion))" />
                                                                </div>
                                                            </div>
                                                            <div>
                                                                <RadzenLabel Text="2. Laboratorio" Style="font-size: 0.8rem; color: #666; display: block; margin-bottom: 4px;" />
                                                                <div style="display: flex; gap: 5px;">
                                                                    <RadzenDropDown @bind-Value="horarioSelectedLabId" Data="@horarioLaboratoriosFiltrados" TextProperty="Codigo" ValueProperty="LaboratorioId" Placeholder="Todos los laboratorios" Change="@OnHorarioLabChanged" Disabled="@(string.IsNullOrEmpty(horarioSelectedUbicacion))" Style="width: 100%;" />
                                                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => LimpiarFiltroHorario("laboratorio"))" Disabled="@(horarioSelectedLabId == 0)" />
                                                                </div>
                                                            </div>
                                                            <div>
                                                                <RadzenLabel Text="3. Máquina" Style="font-size: 0.8rem; color: #666; display: block; margin-bottom: 4px;" />
                                                                <div style="display: flex; gap: 5px;">
                                                                    <RadzenDropDown @bind-Value="codigoMaquinaFilter" Data="@horarioListaMaquinas" TextProperty="CodigoMaquina" ValueProperty="CodigoMaquina" Placeholder="Todas las máquinas" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Disabled="@(horarioSelectedLabId == 0)" Style="width: 100%;" />
                                                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => LimpiarFiltroHorario("maquina"))" Disabled="@(string.IsNullOrEmpty(codigoMaquinaFilter))" />
                                                                </div>
                                                            </div>
                                                        </RadzenStack>
                                                    </RadzenColumn>
                                                </RadzenRow>

                                                <RadzenRow Class="rz-mt-4">
                                                    <RadzenColumn Size="12" Class="rz-text-align-right">
                                                        <RadzenButton Text="Limpiar Filtros"
                                                                      Icon="autorenew"
                                                                      Click="@ResetHorarioFilters"
                                                                      ButtonStyle="ButtonStyle.Light"
                                                                      Style="margin-right: 10px;" />

                                                        <RadzenButton Text="BUSCAR REGISTROS"
                                                                      Icon="search"
                                                                      Click="@ConsultarHorario"
                                                                      ButtonStyle="ButtonStyle.Primary"
                                                                      Style="background-color: #bf4b57; padding: 0 40px; font-weight: bold;" />
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            </div>
                                        </RadzenStack>
                                    </RadzenColumn>

                                    <RadzenColumn Size="12" SizeMD="4" SizeLG="3">
                                        <div class="pdf-sidebar" style="height: 100%;">
                                            <div class="pdf-header">
                                                <RadzenIcon Icon="picture_as_pdf" />
                                                <span>Reportes PDF</span>
                                            </div>
                                            <div class="pdf-actions-top">
                                                <RadzenButton Text="Generar PDF" Icon="picture_as_pdf" Click="@ShowPdfFilterDialogHorario" ButtonStyle="ButtonStyle.Danger" Style="width: 100%; font-weight: bold;" />
                                            </div>
                                            <div class="pdf-list">
                                                @if (generatedPdfs.Any())
                                                {
                                                    @foreach (var pdf in generatedPdfs)
                                                    {
                                                        <div class="pdf-item">
                                                            <div class="pdf-icon">
                                                                <RadzenIcon Icon="description" />
                                                            </div>
                                                            <div class="pdf-details">
                                                                <span class="pdf-title">@pdf.Titulo</span>
                                                                <span class="pdf-date">@pdf.Fecha.ToString("HH:mm:ss")</span>
                                                                <div class="pdf-actions">
                                                                    <button class="btn-view" @onclick="@(() => AbrirPdf(pdf.Url))">Ver</button>
                                                                    <a href="@pdf.Url" download="@pdf.NombreArchivo" class="btn-download">Descargar</a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="pdf-empty">
                                                        <RadzenIcon Icon="hourglass_empty" />
                                                        <p>No se han generado reportes PDF aún.</p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </RadzenColumn>
                                </RadzenRow>

                                @if (asistenciasHorarioResponse != null)
                                {
                                    <RadzenRow>
                                        <RadzenColumn Size="12">
                                            <div class="results-header" style="margin-top: 10px;">
                                                <span class="results-count">Total: @FilteredAsistenciasHorarioCompleto.Count() registros encontrados</span>
                                            </div>
                                            
                                            <RadzenDataGrid Data="@FilteredAsistenciasHorarioCompleto" TItem="AsistenciaReporteDto" AllowPaging="true" PageSize="15" Class="pacha-grid" Density="Density.Compact" GridLines="DataGridGridLines.Vertical" Width="100%">
                                                <Columns>
                                                    <!-- Fecha - 80px -->
                                                    <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="FechaRegistro" Title="Fecha" FormatString="{0:dd/MM/yyyy}" Width="80px" />
                                                    
                                                    <!-- Usuario - 150px (reducido de 180px) -->
                                                    <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="NombreMostrar" Title="Usuario" Width="150px" />
                                                    
                                                    <!-- Rol - 65px (reducido de 90px, solo entra ESTUDIANTE/DOCENTE) -->
                                                    <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="Rol" Title="Rol" Width="65px">
                                                        <Template Context="data">
                                                            <span class="role-badge @(data.Rol?.ToLower())">@data.Rol</span>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    
                                                    <!-- Tipo: CORREGIDO A MAYÚSCULAS COMPLETAS -->
                                                    <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="Tipo" Title="Tipo" Width="110px">
                                                        <Template Context="data">
                                                            @if (data.Tipo?.ToLower() == "programada")
                                                            {
                                                                <span class="badge-tipo programada">
                                                                    <RadzenIcon Icon="schedule" Style="font-size: 0.75rem;" /> PROGRAMADA
                                                                </span>
                                                            }
                                                            else if (data.Tipo?.ToLower() == "uso_libre")
                                                            {
                                                                <span class="badge-tipo uso-libre">
                                                                    <RadzenIcon Icon="person" Style="font-size: 0.75rem;" /> USO LIBRE
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge-tipo">@data.Tipo?.ToUpper()</span>
                                                            }
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    
                                                    <!-- Máquina - 75px (reducido de 90px) -->
                                                    <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="MaquinaCodigo" Title="Máquina" Width="75px">
                                                        <Template Context="data">
                                                            <span class="badge-maquina">@data.MaquinaCodigo</span>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    
                                                    <!-- Materia - 130px (reducido de 160px) -->
                                                    <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="Materia" Title="Materia" Width="130px">
                                                        <Template Context="data">
                                                            @if (string.IsNullOrEmpty(data.Materia) || data.Tipo == "uso_libre") { 
                                                                <span style="color: #888; font-style: italic; font-size: 0.75rem;">
                                                                    @(data.Tipo == "uso_libre" ? "USO LIBRE" : "-")
                                                                </span> 
                                                            }
                                                            else { 
                                                                <span style="font-weight: 600; color: #444; font-size: 0.75rem;">@data.Materia</span> 
                                                            }
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    
                                                    <!-- Inicio - 65px (reducido de 80px) -->
                                                    <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="HoraIngresoStr" Title="Inicio" Width="65px">
                                                        <Template Context="data">
                                                            <span style="color: #2e7d32; font-weight: bold; font-size: 0.85rem;">@data.HoraIngresoStr</span>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    
                                                    <!-- Fin - 65px (reducido de 80px) -->
                                                    <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="HoraSalidaStr" Title="Fin" Width="65px">
                                                        <Template Context="data">
                                                            <span style="color: #c62828; font-weight: bold; font-size: 0.85rem;">@data.HoraSalidaStr</span>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    
                                                    <!-- Observación - 250px (aumentado de 150px para más espacio) -->
                                                    <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="Observacion" Title="Observación" Width="250px">
                                                        <Template Context="data">
                                                            <div style="white-space: normal; font-style: italic; color: #555; font-size: 0.8rem; line-height: 1.2;">
                                                                @(string.IsNullOrEmpty(data.Observacion) ? "-" : data.Observacion)
                                                            </div>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                </Columns>
                                            </RadzenDataGrid>

                                            <!-- ESTADÍSTICAS Y GRÁFICOS (COMPLETO) -->
                                            @RenderStatisticsSection(FilteredAsistenciasHorarioCompleto.ToList(), "Horario")
                                        </RadzenColumn>
                                    </RadzenRow>
                                }
                            </RadzenStack>
                        </Content>
                    </RadzenTabsItem>

                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    </div>
</div>  

<style>
    /* ESTILOS NUEVOS PARA DASHBOARD DE ESTADÍSTICAS */
    .stats-dashboard-container {
        margin-top: 30px;
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }
    
    .stats-header {
        background: #f8f9fa;
        padding: 15px 20px;
        border-bottom: 1px solid #eee;
        color: #842a3b;
        font-weight: 700;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .stats-grid-mini {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        padding: 20px;
        background: #fff;
        border-bottom: 1px solid #eee;
    }

    .mini-stat {
        background: #fdfdfd;
        border: 1px solid #eee;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        transition: transform 0.2s;
    }
