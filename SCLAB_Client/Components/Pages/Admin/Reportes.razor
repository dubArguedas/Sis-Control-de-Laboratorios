@page "/reportes"

@using SCLAB_Client.Components.Service
@using SCLAB_Client.Models
@using SCLAB_Client.Components.Service.ServiciosApi
@inject AdminDashboardService AdminDashboardService
@inject ReportesService ReportesService
@inject NotificationService NotificationService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@layout AdminLayout

<div class="pacha-layout">
    <div class="pacha-header">
        <div class="content-wrapper">
            <div class="header-content">
                <h1 class="page-title">Reportes y Observaciones</h1>
                <p class="page-subtitle">Gestión y monitoreo de laboratorios en tiempo real</p>
            </div>
        </div>
    </div>

    <div class="content-wrapper main-content">
        <RadzenCard Class="pacha-card main-card">
            @if (isLoading)
            {
                <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Class="pacha-progress" />
            }
            <RadzenTabs RenderMode="TabRenderMode.Client" Class="pacha-tabs">
                <Tabs>
                    <!-- TAB 1: DISTRIBUCIÓN -->
                    <RadzenTabsItem Text="Distribución">
                        <RadzenStack Gap="1rem" Class="rz-p-2">
                            <!-- Filtros -->
                            <div class="filters-container">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="1rem" Wrap="FlexWrap.Wrap">
                                    <RadzenStack Gap="0.2rem">
                                        <RadzenLabel Text="Ubicación" Component="Ubicacion" Class="filter-label" />
                                        <RadzenDropDown @bind-Value="selectedUbicacion" Data="@ubicaciones" Name="Ubicacion"
                                                        Placeholder="Seleccione..." Change="@OnUbicacionChanged" Class="pacha-dropdown" />
                                    </RadzenStack>

                                    <RadzenStack Gap="0.2rem">
                                        <RadzenLabel Text="Laboratorio" Component="Laboratorio" Class="filter-label" />
                                        <RadzenDropDown @bind-Value="selectedLaboratorioId" Data="@laboratoriosFiltrados"
                                                        TextProperty="Codigo" ValueProperty="LaboratorioId" Name="Laboratorio"
                                                        Placeholder="Seleccione..." Disabled="@(string.IsNullOrEmpty(selectedUbicacion))"
                                                        Class="pacha-dropdown" />
                                    </RadzenStack>

                                    <RadzenButton Text="Consultar" Icon="search" Click="@ConsultarDistribucion"
                                                  ButtonStyle="ButtonStyle.Primary" Disabled="@(selectedLaboratorioId == 0)"
                                                  Class="btn-pacha" />
                                </RadzenStack>
                            </div>

                            @if (distribucionResponse != null)
                            {
                                <div class="stats-grid">
                                    <div class="stat-card total">
                                        <div class="stat-icon"><RadzenIcon Icon="computer" /></div>
                                        <div class="stat-info">
                                            <span class="stat-label">Total Máquinas</span>
                                            <span class="stat-value">@distribucionResponse.TotalMaquinas</span>
                                        </div>
                                    </div>
                                    @foreach (var estado in distribucionResponse.Distribucion)
                                    {
                                        <div class="stat-card @estado.Estado.ToLower()">
                                            <div class="stat-info">
                                                <span class="stat-label">@estado.Estado</span>
                                                <span class="stat-value">@estado.Cantidad</span>
                                                <span class="stat-percent">@estado.Porcentaje%</span>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- LISTA DE MÁQUINAS -->
                                @if (maquinasResponse != null && maquinasResponse.Maquinas.Any())
                                {
                                    <div class="section-divider">
                                        <span>Máquinas en @maquinasResponse.Codigo</span>
                                    </div>

                                    <RadzenDataList WrapItems="true" AllowPaging="true" Data="@maquinasResponse.Maquinas" TItem="MaquinaResumenDto" PageSize="12" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
                                        <Template Context="maquina">
                                            <div class="machine-card @GetStatusClass(maquina.Estado)">
                                                <div class="machine-header">
                                                    <span class="machine-code">@maquina.CodigoMaquina</span>
                                                    @if (maquina.TieneQr)
                                                    {
                                                        <RadzenIcon Icon="qr_code_2" Class="qr-icon" />
                                                    }
                                                </div>
                                                <div class="machine-body">
                                                    <p class="hardware-desc">@(string.IsNullOrEmpty(maquina.DescripcionHardware) ? "Sin descripción" : maquina.DescripcionHardware)</p>

                                                    @if (maquina.AsistenciaActiva != null)
                                                    {
                                                        <div class="user-info">
                                                            <div class="user-row"><RadzenIcon Icon="person" /><span>@maquina.AsistenciaActiva.UsuarioNombre</span></div>
                                                            <div class="user-row time"><RadzenIcon Icon="timer" /><span>@maquina.AsistenciaActiva.TiempoTranscurrido min</span></div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="empty-state">@maquina.Estado</div>
                                                    }
                                                </div>
                                                @if (maquina.AlertaActiva != null)
                                                {
                                                    <div class="machine-alert"><RadzenIcon Icon="warning" /><span>@maquina.AlertaActiva.Descripcion</span></div>
                                                }
                                            </div>
                                        </Template>
                                    </RadzenDataList>
                                }
                            }
                        </RadzenStack>
                    </RadzenTabsItem>

                    <!-- TAB 2: POR MATERIA -->
                    <RadzenTabsItem Text="Por Materia">
                        <RadzenStack Gap="1rem" Class="rz-p-2">
                            <div class="filters-container">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="1rem" Wrap="FlexWrap.Wrap">
                                    <RadzenStack Gap="0.2rem" Style="flex-grow: 1; max-width: 400px;">
                                        <RadzenLabel Text="Nombre de la Materia" Component="Materia" Class="filter-label" />
                                        <RadzenTextBox @bind-Value="nombreMateria" Name="Materia" Placeholder="Ej. Programación..." Class="pacha-input" />
                                    </RadzenStack>
                                    <RadzenButton Text="Docentes" Icon="school" Click="@ConsultarMateriaDocente" Class="btn-pacha-secondary" />
                                    <RadzenButton Text="Estudiantes" Icon="person" Click="@ConsultarMateriaEstudiante" Class="btn-pacha-outline" />
                                </RadzenStack>
                            </div>

                            @if (asistenciasMateriaResponse != null)
                            {
                                <div class="results-header">
                                    <span class="results-count">Total: @asistenciasMateriaResponse.TotalAsistencias registros</span>
                                </div>
                                <RadzenDataGrid Data="@asistenciasMateriaResponse.Asistencias" TItem="AsistenciaReporteDto" AllowPaging="true" PageSize="10" AllowSorting="true" Class="pacha-grid">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="FechaRegistro" Title="Fecha" FormatString="{0:g}" Width="130px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="NombreMostrar" Title="Nombre" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="Materia" Title="Materia" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="Observacion" Title="Obs." Width="150px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="LaboratorioCodigo" Title="Lab" Width="70px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="HoraIngresoStr" Title="Ingreso" Width="80px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="HoraSalidaStr" Title="Salida" Width="80px" />
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenStack>
                    </RadzenTabsItem>

                    <!-- TAB 3: POR HORARIO -->
                    <RadzenTabsItem Text="Por Horario">
                        <RadzenStack Gap="1rem" Class="rz-p-2">
                            <div class="filters-container">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="1rem" Wrap="FlexWrap.Wrap">
                                    <RadzenStack Gap="0.2rem">
                                        <RadzenLabel Text="Día" Class="filter-label" />
                                        <RadzenDropDown @bind-Value="diaSemana" Data="@diasSemana" Class="pacha-dropdown" />
                                    </RadzenStack>
                                    <RadzenStack Gap="0.2rem">
                                        <RadzenLabel Text="Inicio" Class="filter-label" />
                                        <RadzenDatePicker @bind-Value="horaInicio" ShowTime="true" TimeOnly="true" DateFormat="HH:mm" Class="pacha-input" />
                                    </RadzenStack>
                                    <RadzenStack Gap="0.2rem">
                                        <RadzenLabel Text="Fin" Class="filter-label" />
                                        <RadzenDatePicker @bind-Value="horaFin" ShowTime="true" TimeOnly="true" DateFormat="HH:mm" Class="pacha-input" />
                                    </RadzenStack>
                                    <RadzenButton Text="Consultar" Icon="schedule" Click="@ConsultarHorario" Class="btn-pacha" />
                                </RadzenStack>
                            </div>

                            @if (asistenciasHorarioResponse != null)
                            {
                                <div class="results-header">
                                    <span class="results-count">Total: @asistenciasHorarioResponse.TotalAsistencias registros</span>
                                </div>
                                <RadzenDataGrid Data="@asistenciasHorarioResponse.Asistencias" TItem="AsistenciaReporteDto" AllowPaging="true" PageSize="10" Class="pacha-grid">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="FechaRegistro" Title="Fecha" FormatString="{0:d}" Width="100px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="NombreMostrar" Title="Estudiante" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="Materia" Title="Materia" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="Observacion" Title="Obs." Width="150px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="CronogramaHoraInicio" Title="Inicio Clase" Width="90px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="CronogramaHoraFin" Title="Fin Clase" Width="90px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="HoraIngresoStr" Title="Ingreso Real" Width="90px" />
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenStack>
                    </RadzenTabsItem>

                    <!-- TAB 4: GENERALES -->
                    <RadzenTabsItem Text="Reportes Generales">
                        <RadzenStack Gap="1rem" Class="rz-p-2">
                            <div class="filters-container">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                        <RadzenButton Text="General" Click="@(() => ConsultarGeneral("general"))" Class="btn-pacha" />
                                        <RadzenButton Text="Programada" Click="@(() => ConsultarGeneral("programada"))" Class="btn-pacha-secondary" />
                                        <RadzenButton Text="Uso Libre" Click="@(() => ConsultarGeneral("uso_libre"))" Class="btn-pacha-outline" />
                                    </RadzenStack>

                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                        <RadzenButton Text="PDF" Icon="picture_as_pdf" Click="@ExportarPDF" ButtonStyle="ButtonStyle.Danger" Class="btn-pdf" />
                                        <RadzenSelectBar @bind-Value="filtroRol" Change="@OnRolFilterChanged" TValue="string" Size="ButtonSize.Medium" Class="pacha-selectbar">
                                            <Items>
                                                <RadzenSelectBarItem Text="Todos" Value="@("todos")" />
                                                <RadzenSelectBarItem Text="Estudiantes" Value="@("estudiante")" />
                                                <RadzenSelectBarItem Text="Docentes" Value="@("docente")" />
                                            </Items>
                                        </RadzenSelectBar>
                                    </RadzenStack>
                                </RadzenStack>
                            </div>

                            @if (asistenciasGeneralResponse != null)
                            {
                                <div class="results-header">
                                    <span class="results-count">@asistenciasGeneralResponse.Nota - Total: @FilteredAsistencias.Count()</span>
                                </div>

                                <RadzenDataGrid Data="@FilteredAsistencias" TItem="AsistenciaReporteDto" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" Class="pacha-grid">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="FechaRegistro" Title="Fecha" FormatString="{0:g}" Width="130px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="NombreMostrar" Title="Usuario" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="Rol" Title="Rol" Width="100px">
                                            <Template Context="data">
                                                <span class="role-badge @(data.Rol?.ToLower())">@data.Rol</span>
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="LaboratorioCodigo" Title="Lab" Width="60px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="Materia" Title="Materia" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="Observacion" Title="Observación" Width="180px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="HoraIngresoStr" Title="Ingreso" Width="70px" />
                                        <RadzenDataGridColumn TItem="AsistenciaReporteDto" Property="HoraSalidaStr" Title="Salida" Width="70px" />
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenStack>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    </div>
</div>

<style>
    :root {
        --pacha-guindo: #8B4C4C;
        --pacha-guindo-dark: #662222;
        --pacha-bg: #f4f6f8;
        --pacha-text: #1a1a1a;
        --pacha-gray: #666;
    }

    .pacha-layout {
        background-color: var(--pacha-bg);
        min-height: 100vh;
        font-family: 'Roboto', sans-serif;
    }

    .pacha-header {
        background: linear-gradient(135deg, var(--pacha-guindo), var(--pacha-guindo-dark));
        padding: 60px 0 80px;
        color: white;
        margin-bottom: -40px;
    }

    .content-wrapper {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .header-content {
        text-align: center;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .page-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
        font-weight: 300;
    }

    .main-card {
        border-radius: 16px !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05) !important;
        border: none !important;
        overflow: hidden;
        padding: 0 !important;
    }

    .pacha-tabs .rz-tabview-nav {
        background: #fff;
        border-bottom: 1px solid #eee;
        padding-left: 20px;
    }

    .pacha-tabs .rz-tabview-selected {
        color: var(--pacha-guindo) !important;
        border-bottom: 3px solid var(--pacha-guindo) !important;
        background: transparent !important;
        font-weight: 600;
    }

    .pacha-tabs .rz-tabview-item {
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .filters-container {
        background: #f9f9f9;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #eee;
    }

    .filter-label {
        font-size: 0.85rem;
        color: var(--pacha-gray);
        font-weight: 500;
    }

    .btn-pacha {
        background-color: var(--pacha-guindo) !important;
        color: white !important;
        border-radius: 8px !important;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
        padding: 0 24px !important;
    }

    .btn-pacha-secondary {
        background-color: #5a3030 !important;
        color: white !important;
        border-radius: 8px !important;
    }

    .btn-pacha-outline {
        background-color: transparent !important;
        border: 1px solid var(--pacha-guindo) !important;
        color: var(--pacha-guindo) !important;
        border-radius: 8px !important;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #eee;
        display: flex;
        align-items: center;
        gap: 15px;
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .stat-card.total {
            background: linear-gradient(135deg, var(--pacha-guindo), var(--pacha-guindo-dark));
            color: white;
        }

            .stat-card.total .stat-label {
                color: rgba(255,255,255,0.9);
            }

            .stat-card.total .stat-value {
                color: white;
            }

            .stat-card.total .stat-icon {
                color: rgba(255,255,255,0.2);
                font-size: 2.5rem;
            }

    .stat-info {
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        font-size: 0.9rem;
        color: var(--pacha-gray);
        text-transform: capitalize;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--pacha-text);
        line-height: 1.2;
    }

    .stat-percent {
        font-size: 0.8rem;
        color: #888;
    }

    .machine-card {
        background: white;
        border-radius: 10px;
        border: 1px solid #eee;
        padding: 15px;
        margin: 10px;
        width: 280px;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }

        .machine-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        }

        .machine-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
        }

        .machine-card.disponible::before { background-color: #28a745; }
        .machine-card.ocupado::before { background-color: #dc3545; }
        .machine-card.mantenimiento::before { background-color: #ffc107; }

    .machine-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .machine-code {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--pacha-text);
    }

    .qr-icon {
        color: var(--pacha-guindo);
        font-size: 1.5rem;
    }

    .machine-body {
        min-height: 80px;
    }

    .hardware-desc {
        font-size: 0.85rem;
        color: #888;
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .user-info {
        background: #f8f9fa;
        padding: 8px;
        border-radius: 6px;
    }

    .user-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

        .user-row.time {
            color: var(--pacha-guindo);
            font-weight: 500;
        }

    .empty-state {
        text-align: center;
        color: #ccc;
        font-style: italic;
        padding: 20px 0;
    }

    .machine-alert {
        margin-top: 10px;
        background: #fff3cd;
        color: #856404;
        padding: 8px;
        border-radius: 6px;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        padding: 0 10px;
    }

    .results-count {
        font-weight: 500;
        color: var(--pacha-gray);
    }

    /* ESTILOS COMPACTOS PARA LA TABLA */
    .pacha-grid {
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #eee;
    }

    .pacha-grid .rz-grid-table thead th {
        background-color: #f8f9fa;
        color: var(--pacha-gray);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.65rem !important; /* ULTRA PEQUEÑO */
        padding: 4px 4px !important; /* MÍNIMO PADDING */
        border-bottom: 2px solid #eee;
        white-space: nowrap; /* Evitar saltos de línea en encabezados */
    }

    .pacha-grid .rz-grid-table td {
        padding: 2px 4px !important; /* ULTRA COMPACTO */
        font-size: 0.75rem !important;
        color: var(--pacha-text);
        border-bottom: 1px solid #f0f0f0;
        height: 24px !important; /* Altura forzada */
    }

    .pacha-grid .rz-cell-data {
        font-size: 0.75rem !important;
        line-height: 1.1 !important;
    }

    .btn-pdf {
        background-color: #d32f2f !important;
        color: white !important;
        border-radius: 8px !important;
        font-weight: 600;
        text-transform: uppercase;
        padding: 0 16px !important;
    }

    .role-badge {
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

        .role-badge.estudiante {
            background-color: #e3f2fd;
            color: #1976d2;
        }

        .role-badge.docente {
            background-color: #e8f5e9;
            color: #2e7d32;
        }

    .pacha-selectbar .rz-selectbar-btn {
        background-color: white;
        color: var(--pacha-gray);
        border: 1px solid #ddd;
        font-size: 0.85rem;
        padding: 4px 16px;
    }

    .pacha-selectbar .rz-selectbar-btn.rz-state-active {
        background-color: #e3f2fd;
        color: #1976d2;
        border-color: #1976d2;
        font-weight: 600;
    }
</style>

@code {
    // --- Variables de Estado ---
    private bool isLoading = false;
    private string selectedUbicacion = "";
    private int selectedLaboratorioId = 0;
    private List<string> ubicaciones = new();
    private List<LaboratorioResumenDto> laboratorios = new();
    private List<LaboratorioResumenDto> laboratoriosFiltrados = new();

    // Variables para filtros
    private string nombreMateria = "";
    private string diaSemana = "Lunes";
    private DateTime? horaInicio;
    private DateTime? horaFin;
    private List<string> diasSemana = new() { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" };
    private string filtroRol = "todos"; // todos, estudiante, docente

    // Respuestas de API
    private DistribucionEstadosResponse? distribucionResponse;
    private MaquinasLaboratorioResponse? maquinasResponse;
    private ReporteAsistenciasResponse? asistenciasMateriaResponse;
    private ReporteAsistenciasResponse? asistenciasHorarioResponse;
    private ReporteAsistenciasResponse? asistenciasGeneralResponse;

    protected override async Task OnInitializedAsync()
    {
        await CargarLaboratorios();
    }

    private async Task CargarLaboratorios()
    {
        try
        {
            var resumen = await AdminDashboardService.ObtenerResumenLaboratorios();
            if (resumen != null)
            {
                laboratorios = resumen.Laboratorios;
                ubicaciones = laboratorios.Select(l => l.Ubicacion).Distinct().ToList();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "No se pudieron cargar los laboratorios.");
        }
    }

    private void OnUbicacionChanged()
    {
        laboratoriosFiltrados = laboratorios.Where(l => l.Ubicacion == selectedUbicacion).ToList();
        selectedLaboratorioId = 0;
    }

    // --- Métodos de Consulta ---

    private async Task ConsultarDistribucion()
    {
        if (selectedLaboratorioId == 0) return;
        isLoading = true;
        try
        {
            distribucionResponse = await ReportesService.ObtenerDistribucionEstados(selectedLaboratorioId);
            maquinasResponse = await AdminDashboardService.ObtenerMaquinasLaboratorio(selectedLaboratorioId);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error al cargar distribución: {ex.Message}");
        }
        finally { isLoading = false; }
    }

    private async Task ConsultarMateriaDocente()
