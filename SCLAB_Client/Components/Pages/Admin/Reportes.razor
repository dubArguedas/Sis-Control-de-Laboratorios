    private IEnumerable<AsistenciaReporteDto> FilteredAsistencias => asistenciasGeneralResponse?.Asistencias.Where(a => (filtroRol == "todos" || a.Rol?.ToLower() == filtroRol) && (!fechaFiltro.HasValue || a.FechaRegistro.Date == fechaFiltro.Value.Date)) ?? Enumerable.Empty<AsistenciaReporteDto>();
    private IEnumerable<AsistenciaReporteDto> FilteredAsistenciasMateria => asistenciasMateriaResponse?.Asistencias.Where(a => !fechaFiltroMateria.HasValue || a.FechaRegistro.Date == fechaFiltroMateria.Value.Date) ?? Enumerable.Empty<AsistenciaReporteDto>();

    private IEnumerable<AsistenciaReporteDto> FilteredAsistenciasHorarioCompleto
    {
        get
        {
            if (asistenciasHorarioResponse?.Asistencias == null) return Enumerable.Empty<AsistenciaReporteDto>();
            var q = asistenciasHorarioResponse.Asistencias.AsEnumerable();
            if (horarioTipoAsistencia != "general") q = q.Where(a => a.Tipo?.ToLower() == horarioTipoAsistencia);
            if (horarioFiltroRol != "todos") q = q.Where(a => a.Rol?.ToLower() == horarioFiltroRol);
            if (!string.IsNullOrWhiteSpace(horarioNombreMateria)) q = q.Where(a => a.Materia?.Equals(horarioNombreMateria, StringComparison.OrdinalIgnoreCase) == true);
            if (fechaInicioHorario.HasValue) q = q.Where(a => a.FechaRegistro.Date >= fechaInicioHorario.Value.Date);
            if (fechaFinHorario.HasValue) q = q.Where(a => a.FechaRegistro.Date <= fechaFinHorario.Value.Date);
            return q;
        }
    }

