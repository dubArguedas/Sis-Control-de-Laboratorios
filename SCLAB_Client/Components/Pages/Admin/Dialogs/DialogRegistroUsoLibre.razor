@using Radzen
@using Radzen.Blazor
@using SCLAB_Entities
@inject AsistenciaService AsistenciaService
@inject MaquinaService MaquinaService
@inject LaboratorioService LaboratorioService
@inject NotificationService NotificationService
@inject DialogService DialogService

<RadzenStack Gap="1rem">
    <!-- Header con info de la máquina -->
    <RadzenCard Style="background: linear-gradient(135deg, #842a3b, #bf4b57); color: white; padding: 1rem;">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: white;">
                    Registro de Uso Libre
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" Style="color: rgba(255,255,255,0.9);">
                    Máquina: @MaquinaCodigo | Laboratorio: @LabCodigo
                </RadzenText>
            </div>
            <RadzenIcon Icon="assignment" Style="font-size: 36px;" />
        </RadzenStack>
    </RadzenCard>

    <!-- Barra de búsqueda de estudiante -->
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0.5rem; color: #842a3b; font-weight: 600;">
            Buscar Estudiante
        </RadzenText>

        <RadzenTextBox @bind-Value="terminoBusqueda"
                       Placeholder="Nombre, apellido o correo..."
                       Style="width: 100%;"
                       @oninput="@BuscarEstudiantes" />

        @if (mostrarResultados && estudiantesEncontrados.Any())
        {
            <RadzenCard Style="margin-top: 0.5rem; max-height: 200px; overflow-y: auto; padding: 0.5rem;">
                @foreach (var estudiante in estudiantesEncontrados)
                {
                    <div class="resultado-estudiante" @onclick="() => SeleccionarEstudiante(estudiante)">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                            <RadzenIcon Icon="account_circle" Style="color: #842a3b;" />
                            <div>
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; font-weight: 600;">
                                    @estudiante.Nombre @estudiante.ApellidoPaterno
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: #666;">
                                    @estudiante.CorreoInstitucional
                                </RadzenText>
                            </div>
                        </RadzenStack>
                    </div>
                }
            </RadzenCard>
        }
        else if (mostrarResultados && !string.IsNullOrWhiteSpace(terminoBusqueda))
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Size="AlertSize.Small" Style="margin-top: 0.5rem;">
                No se encontraron estudiantes con ese criterio
            </RadzenAlert>
        }
    </RadzenCard>

    <!-- Formulario con datos del estudiante seleccionado -->
    @if (estudianteSeleccionado != null)
    {
        <RadzenCard Style="background-color: #f8f9fa;">
            <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 1rem; color: #842a3b; font-weight: 600;">
                Datos del Estudiante
            </RadzenText>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Nombre" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox Value="@estudianteSeleccionado.Nombre" Disabled="true" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Apellido Paterno" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox Value="@estudianteSeleccionado.ApellidoPaterno" Disabled="true" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12">
                    <RadzenFormField Text="Correo Institucional" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox Value="@estudianteSeleccionado.CorreoInstitucional" Disabled="true" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Laboratorio" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox Value="@LabCodigo" Disabled="true" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Máquina" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox Value="@MaquinaCodigo" Disabled="true" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12">
                    <RadzenFormField Text="Hora de Entrada" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox Value="@DateTime.Now.ToString("HH:mm")" Disabled="true" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Botones de acción -->
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Cancelar"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@CerrarDialogo"
                          Disabled="@registrando" />

            <RadzenButton Text="@(registrando ? "Registrando..." : "Registrar Uso Libre")"
                          Icon="@(registrando ? "" : "check_circle")"
                          ButtonStyle="ButtonStyle.Success"
                          Style="background-color: #842a3b;"
                          Click="@RegistrarUsoLibre"
                          Disabled="@registrando" />
        </RadzenStack>
    }
</RadzenStack>

<style>
    .resultado-estudiante {
        padding: 0.75rem;
        cursor: pointer;
        border-radius: 6px;
        transition: all 0.2s;
        border: 1px solid transparent;
    }

        .resultado-estudiante:hover {
            background-color: rgba(132, 42, 59, 0.1);
            border-color: #842a3b;
        }
</style>

@code {
    [Parameter] public int MaquinaId { get; set; }
    [Parameter] public string MaquinaCodigo { get; set; } = "";
    [Parameter] public int LaboratorioId { get; set; }
    [Parameter] public string LabCodigo { get; set; } = "";

    private string terminoBusqueda = "";
    private bool mostrarResultados = false;
    private List<UsuariosCLS> estudiantesEncontrados = new();
    private UsuariosCLS? estudianteSeleccionado = null;
    private bool registrando = false;

    private async Task BuscarEstudiantes(ChangeEventArgs e)
    {
        terminoBusqueda = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(terminoBusqueda) || terminoBusqueda.Length < 2)
        {
            mostrarResultados = false;
            estudiantesEncontrados.Clear();
            return;
        }

        estudiantesEncontrados = await AsistenciaService.BuscarEstudiantesPorNombre(terminoBusqueda);
        mostrarResultados = true;
    }

    private void SeleccionarEstudiante(UsuariosCLS estudiante)
    {
        estudianteSeleccionado = estudiante;
        mostrarResultados = false;
        terminoBusqueda = $"{estudiante.Nombre} {estudiante.ApellidoPaterno}";
        StateHasChanged();
    }

    private async Task RegistrarUsoLibre()
    {
        if (estudianteSeleccionado == null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Advertencia", "Debe seleccionar un estudiante");
            return;
        }

        registrando = true;
        StateHasChanged();

        try
        {
            var registroDto = new SCLAB_Client.Services.RegistroAsistenciaDto
            {
                UsuarioId = estudianteSeleccionado.UsuarioId,
                MaquinaId = MaquinaId,
                LaboratorioId = LaboratorioId,
                TipoDisp = "PC"
            };

            Console.WriteLine($"[DialogRegistroUsoLibre] Enviando: UsuarioId={registroDto.UsuarioId}, MaquinaId={registroDto.MaquinaId}, LabId={registroDto.LaboratorioId}");

            var resultado = await AsistenciaService.RegistrarUsoLibre(registroDto);

            if (resultado.IsSuccess)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Éxito", resultado.Message);
                DialogService.Close(true);
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", resultado.Message);
                registrando = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DialogRegistroUsoLibre] Error: {ex.Message}");
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Excepción: {ex.Message}");
            registrando = false;
            StateHasChanged();
        }
    }

    private void CerrarDialogo()
    {
        DialogService.Close(false);
    }
}