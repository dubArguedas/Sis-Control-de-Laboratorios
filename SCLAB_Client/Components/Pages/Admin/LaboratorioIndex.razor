@page "/seleccion-torre"
@layout AdminLayout
@rendermode InteractiveServer
@inject NavigationManager NavManager

<div class="header-container rz-shadow-10 rz-p-12 rz-text-align-center">
    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem">
        <RadzenText TextStyle="TextStyle.H2" Class="rz-color-white" Style="font-weight: 700;">
            Gestión de Laboratorios
        </RadzenText>
        <RadzenText TextStyle="TextStyle.H5" Class="rz-color-white rz-pt-2">
            Por favor, seleccione la torre con la que desea trabajar
        </RadzenText>
    </RadzenStack>
</div>

<RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" JustifyContent="JustifyContent.Center" Class="selection-card-row">

    <RadzenCard Class="selection-card rz-shadow-5" Style="width: 350px; background-color: #F8F8F8;">
        <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="1rem">
            <div class="image-wrapper rz-shadow-3" style="background-color: #842A3B;">
                <RadzenImage Path="/images/Univalle_Torres.jpg" Alt="Torre Maestra" Class="card-image" />
            </div>

            <RadzenText TextStyle="TextStyle.H4" Class="rz-color-primary-dark" Style="font-weight: 600;">
                Torre Maestra
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" Class="rz-color-secondary-darker rz-text-align-center">
                Acceso a la gestión principal de proyectos.
            </RadzenText>

            <RadzenButton Variant="Variant.Flat" Text="Gestionar →" Click="@(args => SelectTower("maestra"))" Class="rz-mt-3" Style="background-color: #d9cfc7; color: #662121; border-radius: 10px; border: 2px solid #662121;" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard Class="selection-card rz-shadow-5" Style="width: 350px; background-color: #F8F8F8;">
        <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="1rem">
            <div class="image-wrapper rz-shadow-3" style="background-color: #842A3B;">
                <RadzenImage Path="/images/Univalle_Torres.jpg" Alt="Torre Innovación" Class="card-image" />
            </div>

            <RadzenText TextStyle="TextStyle.H4" Class="rz-color-primary-dark" Style="font-weight: 600;">
                Torre Innovación
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" Class="rz-color-secondary-darker rz-text-align-center">
                Acceso a la gestión de iniciativas especiales y I+D.
            </RadzenText>

            <RadzenButton Variant="Variant.Flat" Text="Gestionar →" Click="@(args => SelectTower("innovacion"))" Class="rz-mt-3" Style="background-color: #d9cfc7; color: #662020; border-radius: 10px; border: 2px solid #662121" />
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

<style>
    .header-container {
        background: linear-gradient(135deg, #842a3b, #bf4b57);
        width: 100%;
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .rz-color-white {
        color: white !important;
    }

    .selection-card-row {
        width: 100%;
        padding-bottom: 2rem;
    }

    .selection-card {
        border-radius: 15px;
        border: 1px solid #eee;
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    }

        .selection-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important;
        }

    .image-wrapper {
        width: 150px;
        height: 150px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-top: -75px;
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 10px;
        opacity: 0.8;
    }

    .rz-color-primary-dark {
        color: #662222 !important;
    }

    .rz-color-secondary-darker {
        color: #444 !important;
    }
</style>

@code {
    private void SelectTower(string towerParam)
    {
        NavManager.NavigateTo($"/laboratorios/{towerParam}");
    }
}
