@page "/cronograma/{laboratorioId:int}"
@using SCLAB_Client.Services
@using SCLAB_Entities
@using Radzen
@using Radzen.Blazor
@inject CronogramaService CronogramaService
@inject DialogService DialogService
@inject NotificationService NotificationService
@layout AdminLayout
@rendermode InteractiveServer

<h3>Cronograma del Laboratorio: @CodigoLaboratorio</h3>
<p>Haga clic en una celda para actualizar la materia.</p>

<RadzenCard class="rz-shadow-5">
    @if (isLoading)
    {
        <p>Cargando cronograma...</p>
    }
    else if (errorMessage != null)
    {
        <p class="text-danger">Error: @errorMessage</p>
    }
    else
    {
        <RadzenDataGrid Data="@cronogramaPorHora"
                        TItem="HoraBloque"
                        AllowColumnResize="true"
                        AllowFiltering="false"
                        AllowSorting="false"
                        PageSize="16"
                        AllowPaging="true"
                        ShowPagingSummary="true"
                        Density="Density.Compact"
                        ColumnWidth="120px"
                        class="rz-shadow-5 rz-border-radius-1">

            <Columns>
                <RadzenDataGridColumn TItem="HoraBloque" Property="Hora" Title="Intervalo" Frozen="true" Width="130px" TextAlign="TextAlign.Center" />

                @foreach (var dia in DiasSemana)
                {
                    <RadzenDataGridColumn TItem="HoraBloque" Title="@dia" Width="150px">
                        <Template Context="bloqueHorario">
                            @{
                                var bloque = bloqueHorario.BloquesPorDia
                                .FirstOrDefault(b => b.DiaSemana.Equals(dia, StringComparison.OrdinalIgnoreCase));
                            }
                            @if (bloque != null)
                            {
                                <RadzenButton Variant="Variant.Text"
                                              class="@(string.IsNullOrEmpty(bloque.Materia) ? "bg-success-light" : "bg-danger-light")"
                                              Text="@(bloque.Materia ?? "LIBRE")"
                                              Title="@(bloque.Materia ?? "LIBRE")"
                                              Style="width:100%; height:100%; color:black; font-size: 0.8rem; padding: 2px 4px;"
                                              Click="@(() => OpenMateriaDialog(bloque))" />
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    [Parameter]
    public int LaboratorioId { get; set; }

    private string? CodigoLaboratorio { get; set; }
    private List<HoraBloque> cronogramaPorHora = new();
    private bool isLoading = true;
    private string? errorMessage;

    private readonly string[] DiasSemana = new[] { "Lunes", "Martes", "Miercoles", "Jueves", "Viernes", "Sabado" };

    protected override async Task OnParametersSetAsync()
    {
        await LoadCronograma();
    }

    private async Task LoadCronograma()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var response = await CronogramaService.GetCronogramaResponse(LaboratorioId);

            if (response == null)
            {
                throw new Exception("Respuesta del servicio nula.");
            }

            CodigoLaboratorio = response.CodigoLaboratorio;
            var cronogramaPlano = response.Cronograma;
            var gruposPorHora = cronogramaPlano
                .GroupBy(c => c.HoraInicio)
                .OrderBy(g => g.Key)
                .Select(g => new HoraBloque
                {
                    Hora = $"{g.Key.ToString(@"hh\:mm")} - {g.First().HoraFin.ToString(@"hh\:mm")}",
                    BloquesPorDia = g.ToList()
                })
                .ToList();

            cronogramaPorHora = gruposPorHora;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar el cronograma: {ex.Message}";
            Console.WriteLine(ex.ToString());
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetHoraFin(TimeSpan horaFin)
    {
        return $"({horaFin.ToString(@"hh\:mm")})";
    }

    private async Task OpenMateriaDialog(CronogramaIntervalCLS bloque)
    {
        var result = await DialogService.OpenAsync<DialogEditarMateria>(
            $"Asignar Materia a {bloque.DiaSemana} ({bloque.HoraInicio.ToString(@"hh\:mm")} - {bloque.HoraFin.ToString(@"hh\:mm")})",
            new Dictionary<string, object> { { "Materia", bloque.Materia ?? string.Empty } },
            new DialogOptions()
            {
                Width = "400px",
                Height = "200px",
                CloseDialogOnEsc = true,
                CloseDialogOnOverlayClick = true
            }
        );

        if (result is string nuevaMateria)
        {
            if (bloque.Materia != (string.IsNullOrWhiteSpace(nuevaMateria) ? null : nuevaMateria.Trim()))
            {
                await ActualizarMateria(bloque.CronogramaId, string.IsNullOrWhiteSpace(nuevaMateria) ? null : nuevaMateria.Trim());
            }
        }
    }

    private async Task ActualizarMateria(int cronogramaId, string? nuevaMateria)
    {
        try
        {
            await CronogramaService.ActualizarMateria(cronogramaId, nuevaMateria);
            await LoadCronograma();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Actualización Exitosa",
                Detail = nuevaMateria == null ? "Bloque marcado como LIBRE." : $"Bloque asignado a '{nuevaMateria}'.",
                Duration = 4000
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error de Actualización",
                Detail = $"No se pudo actualizar el bloque. Detalle: {ex.Message}",
                Duration = 6000
            });
        }
    }

    public class HoraBloque
    {
        public string Hora { get; set; } = string.Empty;
        public List<CronogramaIntervalCLS> BloquesPorDia { get; set; } = new();
    }
}