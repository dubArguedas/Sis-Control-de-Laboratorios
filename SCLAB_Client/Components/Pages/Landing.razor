@page "/"
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Landing Page</PageTitle>
<RadzenText TextStyle="TextStyle.H1">PachaSoft</RadzenText>

<div class="padre">
     <header class="header">
          <div class="rz-p-sm-12 d-flex justify-content-between align-items-center" style="margin-bottom: 200px; background-color: #C5C7BC;">
          <img src="#" alt="Landing background" />
               <div class="text-column">
                    <h1 style="font-size: 2.5em; margin-bottom: 10px;">Bienvenido al Registro de Equipos</h1>
                    <p style="font-size: 1.2em;">Inicia Sesión</p>
               </div>
               <div class="button-column">
                    <RadzenButton Text="INICIAR SESIÓN" Style="font-size:36px; font-weight:bold; background-color:#662222; height:120px;" Click="@OnLoginClick"  />
               </div>
          </div>
     </header>
   <section class="section">
        <div class="texto">
            <h2>Desarrollamos soluciones tecnológicas a la medida de tus necesidades</h2>
            <p>En PachaSoft, nos especializamos en crear software personalizado que impulsa el crecimiento de tu negocio. Nuestro equipo de expertos trabaja contigo para entender tus desafíos y ofrecer soluciones innovadoras que optimizan tus procesos y mejoran la eficiencia operativa.</p>
            <nav class="navegacion"></nav>
        </div>

   </section>
   <aside class="publicidad">
        
    </aside>
  
</div>

@code{
    private void OnLoginClick()
    {
       NavigationManager.NavigateTo("/login");
    }
    
}