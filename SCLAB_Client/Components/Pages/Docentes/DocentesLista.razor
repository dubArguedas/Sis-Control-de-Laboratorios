@page "/docentes/lista/{codigoMaquina}/{codigoLaboratorio}"
@inject NavigationManager navigationManager
@layout MainLayout
@rendermode InteractiveServer
@inject ITokenStateService TokenStateService
@inject NotificationService notificationService
@inject MaquinaService maquinaService
@inject LaboratorioService laboratorioService
@inject DocenteService docenteService
@inject DialogService DialogService

<div class="header-container rz-p-12 rz-text-align-center rz-shadow-7"
     style="background: linear-gradient(135deg, #842a3b, #bf4b57); margin-top:80px">
    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem">
        <RadzenText TextStyle="TextStyle.H2" Class="rz-color-white" Style="font-weight: 700;">
            @if (oDocenteCLS.Nombre != null)
            {
                <text>Bienvenido @oDocenteCLS.Nombre</text>
            }
            else
            {
                <text>Cargando datos del Docente...</text>
            }
        </RadzenText>
        <RadzenText TextStyle="TextStyle.H5" Class="rz-color-white rz-pt-2">
            Control de Asistencia
        </RadzenText>
    </RadzenStack>
</div>

<div class="rz-p-4 rz-mx-auto" style="max-width: 1200px;">

    <RadzenTabs TabPosition="TabPosition.Top"
                RenderMode="TabRenderMode.Server"
                Style="
                    --rz-tabs-tab-hover-background-color: #f2f2f2;
                    --rz-tabs-tab-focus-outline: 2px solid #662222;
                    --rz-tabs-tab-selected-color: #662222;
                    --rz-tabs-tab-selected-top-border-color: #662222;
                    --rz-tabs-tab-font-weight: 600;
                    box-shadow: 0 3px 4px rgba(0,0,0,0.08);
                    border-radius: 8px;
                ">

        <Tabs>
            <!-- TAB 1: INICIAR CLASE -->
            <RadzenTabsItem Text="INICIAR CLASE">
                <RadzenStack Orientation="Orientation.Vertical" Gap="25px"
                             Class="rz-p-2 rz-p-md-3">

                    <RadzenText TagName="TagName.H3"
                                Style="color:#662222; font-weight:700; text-align:center;">
                        Iniciar Clase
                    </RadzenText>

                    <RadzenText TagName="TagName.H4"
                                Style="color:#662222; margin-bottom:-10px; font-weight:600;">
                        Ubicación
                    </RadzenText>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Código del Laboratorio" Variant="Variant.Flat"
                                             Style="width:100%; --rz-input-text-color:#662222;">
                                <RadzenTextBox ReadOnly="true"
                                               Style="width:100%; font-weight:500;"
                                               @bind-Value="@codigoLaboratorio" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Código de la Máquina" Variant="Variant.Flat"
                                             Style="width:100%; --rz-input-text-color:#662222;">
                                <RadzenTextBox ReadOnly="true"
                                               Style="width:100%; font-weight:500;"
                                               @bind-Value="@codigoMaquina" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenText TagName="TagName.H4"
                                Style="color:#662222; margin-bottom:-10px; font-weight:600;">
                        Datos del Docente
                    </RadzenText>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Nombre" Variant="Variant.Flat"
                                             Style="width:100%; --rz-input-text-color:#662222;">
                                <RadzenTextBox ReadOnly="true" Style="width:100%;" @bind-Value="@oDocenteCLS.Nombre" />
                            </RadzenFormField>

                            <RadzenFormField Text="Apellido Paterno" Variant="Variant.Flat"
                                             Style="width:100%; --rz-input-text-color:#662222;">
                                <RadzenTextBox ReadOnly="true" Style="width:100%;" @bind-Value="@oDocenteCLS.ApellidoPaterno" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Correo Institucional" Variant="Variant.Flat"
                                             Style="width:100%; --rz-input-text-color:#662222;">
                                <RadzenTextBox ReadOnly="true" Style="width:100%;" @bind-Value="@oDocenteCLS.CorreoInstitucional" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    @if (!string.IsNullOrEmpty(materiaActual))
                    {
                        <RadzenText TagName="TagName.H4"
                                    Style="color:#662222; margin-bottom:-10px; font-weight:600;">
                            Clase Actual
                        </RadzenText>

                        <RadzenFormField Text="Materia Asignada" Variant="Variant.Flat"
                                         Style="width:100%; --rz-input-text-color:#662222;">
                            <RadzenTextBox ReadOnly="true"
                                           Style="width:100%; background-color:#f4f4f4; font-weight:600;"
                                           @bind-Value="@materiaActual" />
                        </RadzenFormField>
                    }

                    <RadzenStack Orientation="Orientation.Horizontal"
                                 JustifyContent="JustifyContent.Center"
                                 Class="rz-pt-4">
                        <RadzenButton Text="Registrar Asistencia"
                                      Icon="check_circle"
                                      Style="background-color:#842a3b; color:white;
                                             width:260px; height:48px; font-size:16px; font-weight:700;"
                                      Click="@(args => RegistrarAsistencia())" />
                    </RadzenStack>

                </RadzenStack>
            </RadzenTabsItem>

            <!-- TAB 2: LISTA -->
            <RadzenTabsItem Text="Lista de Asistencia" Disabled="@disabled">
                <RadzenStack Gap="1.2rem">

                    <RadzenDataGrid Data="@listaEstudiantes"
                                    TItem="UsuariosCLS"
                                    AllowFiltering="true"
                                    AllowPaging="true"
                                    PageSize="10"
                                    AllowSorting="true"
                                    Style="
                                        --rz-grid-header-background-color:#fafafa;
                                        --rz-grid-header-color:#662222;
                                        --rz-grid-cell-color:#662222;
                                        --rz-grid-hover-color:#842a3b;
                                    ">
                        <Columns>
                            <RadzenDataGridColumn TItem="UsuariosCLS" Property="Nombre" Title="Nombre Completo" MinWidth="200px" />
                            <RadzenDataGridColumn TItem="UsuariosCLS" Property="CI" Title="CI" Width="120px">
                                <Template Context="user">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light"
                                                 Text="@user.CI"
                                                 Style="color:#662222;" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UsuariosCLS" Property="CorreoInstitucional" Title="Correo Institucional">
                                <Template Context="user">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
                                        <RadzenIcon Icon="email" Style="color:#842a3b;" />
                                        <span style="color:#662222;">@user.CorreoInstitucional</span>
                                    </RadzenStack>
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="UsuariosCLS" Property="FechaRegistro" Title="Fecha Registro" Width="250px">
                                <Template Context="user">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="5px" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="calendar_today" Style="font-size: 14px; color: #842a3b;" />
                                        <span style="font-size: 13px; color: #662222;">@user.FechaRegistro.ToString("dd/MM/yyyy")</span>
                                    </RadzenStack>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                    @if (asistenciaActualId > 0)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     JustifyContent="JustifyContent.Center"
                                     Class="rz-pt-4">
                            <RadzenButton Text="Finalizar Clase"
                                          Icon="power_settings_new"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Style="background-color:#d9534f; width:260px; height:48px; font-weight:700;"
                                          Click="@ConfirmarFinalizarClase" />
                        </RadzenStack>
                    }
                </RadzenStack>
            </RadzenTabsItem>

            <!-- TAB 3: OBSERVACIONES -->
            <RadzenTabsItem Text="Observaciones" Disabled="@disabled">
                <RadzenCard Class="rz-p-4 rz-mx-auto" Style="max-width:800px;">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

                        <RadzenText TagName="TagName.H3"
                                    Style="color:#662222; font-weight:600;">
                            Registre su observación
                        </RadzenText>

                        <RadzenTextArea @bind-Value="@maxLengthValue"
                                        MaxLength="@maxLength"
                                        Placeholder="Escriba aquí..."
                                        Style="width:100%; min-height:120px; --rz-input-text-color:#662222;" />

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     JustifyContent="JustifyContent.SpaceBetween">
                            <span style="font-style:italic; color:#662222;">Caracteres: @($"{maxLengthValue?.Length ?? 0}/{maxLength}")</span>

                            <RadzenButton Text="Enviar Observación"
                                          Icon="send"
                                          Style="background-color:#662222; color:white; font-weight:600;"
                                          Click="@GuardarObservaciones" />
                        </RadzenStack>

                    </RadzenStack>
                </RadzenCard>
            </RadzenTabsItem>

        </Tabs>
    </RadzenTabs>
</div>


@code {
    bool disabled = true;
    string maxLengthValue = "";
    int maxLength = 200;

    public int asistenciaId { get; set; } = 0;
    private string materiaActual = string.Empty;

    [Parameter]
    public string? codigoMaquina { get; set; }
    [Parameter]
    public string? codigoLaboratorio { get; set; }


    private int asistenciaActualId = 0;
    private string observacionText = string.Empty;

    public RegistroAsistenciaDocenteDto asistenciaDocente = new RegistroAsistenciaDocenteDto();

    public List<UsuariosCLS> listaEstudiantes { get; set; } = new List<UsuariosCLS>();

    public UsuariosCLS oDocenteCLS = new UsuariosCLS();

    public UsuarioInfo? correo = new UsuarioInfo();

    [Inject]
    private IAuthService AuthService { get; set; } = default!;

    private bool isDataLoaded = false;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isDataLoaded)
        {
            await ObtenerDocente();
            isDataLoaded = true;
            StateHasChanged();
        }
    }

    private async Task ObtenerDocente()
    {
        try
        {
            correo = await AuthService.GetCurrentUserInfoAsync();
            oDocenteCLS = await docenteService.ObtenerDocenteId(correo.UsuarioId);
        }
        catch (Exception ex)
        {
            oDocenteCLS = new UsuariosCLS() { Nombre = "Error", CorreoInstitucional = "Error" };
            notificationService.Notify(NotificationSeverity.Error, "Error de Carga", $"No se pudieron cargar los datos del docente. Detalle: {ex.Message}");
        }
    }


    async Task RegistrarAsistencia()
    {
        Console.WriteLine($"[DEBUG] Inputs recibidos -> Maquina: '{codigoMaquina}', Lab: '{codigoLaboratorio}', UsuarioId: {oDocenteCLS.UsuarioId}");

        asistenciaDocente.UsuarioId = oDocenteCLS.UsuarioId;
        asistenciaDocente.MaquinaId = await maquinaService.ObtenerIdPorCodigo(codigoMaquina);
        asistenciaDocente.LaboratorioId = await laboratorioService.ObtenerIdLaboratorio(codigoLaboratorio);

        var jsonDebug = System.Text.Json.JsonSerializer.Serialize(asistenciaDocente);
        Console.WriteLine("[DEBUG] Objeto DTO resuelto (IDs):");
        Console.WriteLine(jsonDebug);

        if (asistenciaDocente.MaquinaId <= 0 || asistenciaDocente.LaboratorioId <= 0)
        {
            Console.WriteLine("[ERROR] Uno de los IDs es 0. La validación falló.");
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error de Datos QR",
                Detail = "No se pudieron obtener IDs válidos para Máquina o Laboratorio. Verifique el código.",
                Duration = 5000
            });
            return;
        }

        var respuesta = await docenteService.RegistrarAsistenciaDocente(asistenciaDocente);

        if (respuesta.IsSuccess)
        {
            disabled = false;

            if (respuesta.Data is SCLAB_Client.Components.Service.GestionLaboratorio.RegistroExitosoDto datosExitosis)
            {
                asistenciaActualId = datosExitosis.asistenciaId;
                materiaActual = datosExitosis.materia; 
            }

            notificationService.Notify(NotificationSeverity.Success, "Registro Exitoso", respuesta.Message);
            if (!string.IsNullOrEmpty(materiaActual))
            {
                await CargarListaEstudiantes();
            }
            StateHasChanged();
        }
        else
        {
            NotificationSeverity severity;
            string summary;

            if (respuesta.Message.Contains("No hay un horario") || respuesta.Message.Contains("Ya existe un registro"))
            {
                severity = NotificationSeverity.Warning;
                summary = "Advertencia de Asistencia";
            }
            else
            {
                severity = NotificationSeverity.Error;
                summary = "Error en Asistencia";
            }

            notificationService.Notify(new NotificationMessage
            {
                Severity = severity,
                Summary = summary,
                Detail = respuesta.Message,
                Duration = 7000
            });
        }
    }
    private async Task CargarListaEstudiantes()
    {
        try
        {
            listaEstudiantes = await docenteService.ObtenerEstudiantesPorMateria(materiaActual);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando estudiantes: " + ex.Message);
        }
    }

    private async Task ConfirmarFinalizarClase()
    {
        var result = await DialogService.Confirm("¿Está seguro de que desea finalizar la clase y la asistencia?", "Confirmar Finalización", new ConfirmOptions()
        {
            OkButtonText = "Sí, Finalizar",
            CancelButtonText = "No",
            CloseDialogOnOverlayClick = true
        });

        if (result.HasValue && result.Value)
        {
            await FinalizarClase();
        }
    }

    private async Task FinalizarClase()
    {
        if (asistenciaActualId == 0)
        {
            notificationService.Notify(NotificationSeverity.Warning, "Advertencia", "No hay una asistencia activa para finalizar.");
            return;
        }

        var resultado = await docenteService.FinalizarAsistenciaDocente(asistenciaActualId);

        if (resultado.IsSuccess)
        {
            notificationService.Notify(NotificationSeverity.Success, "Clase Finalizada", resultado.Message);

            asistenciaActualId = 0;
            disabled = true;
            listaEstudiantes.Clear();
            maxLengthValue = string.Empty;
            materiaActual = string.Empty; 
            StateHasChanged();
        }
        else
        {
            notificationService.Notify(NotificationSeverity.Error, "Error al Finalizar", resultado.Message);
        }
    }

    private async Task GuardarObservaciones()
    {
        if (string.IsNullOrWhiteSpace(maxLengthValue))
        {
            notificationService.Notify(NotificationSeverity.Warning, "Advertencia", "La observación no puede estar vacía.");
            return;
        }

        if (asistenciaActualId == 0)
        {
            notificationService.Notify(NotificationSeverity.Warning, "Advertencia", "Debe registrar la asistencia primero.");
            return;
        }

        var dto = new SCLAB_Client.Components.Service.GestionLaboratorio.ActualizarObservacionDto
        {
            Observacion = maxLengthValue
        };

        var resultado = await docenteService.ActualizarObservaciones(asistenciaActualId, dto);

        if (resultado.IsSuccess)
        {
            notificationService.Notify(NotificationSeverity.Success, "Guardado Exitoso", resultado.Message);
        }
        else
        {
            notificationService.Notify(NotificationSeverity.Error, "Error al guardar observación", resultado.Message);
        }
    }
}