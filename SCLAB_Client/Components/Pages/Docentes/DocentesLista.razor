@page "/docentes"
@inject NavigationManager navigationManager
@layout LoginLayout
@rendermode InteractiveServer
@inject ITokenStateService TokenStateService
@inject NotificationService notificationService
@inject MaquinaService maquinaService
@inject LaboratorioService laboratorioService
@inject DocenteService docenteService
@inject DialogService DialogService
@inject AlertaService alertaService
@using System.Linq
@using SCLAB_Entities
@using SCLAB_Client.Models
@using SCLAB_Client.Components.Service
@using SCLAB_Client.Components.Service.ServiciosApi
@using Microsoft.AspNetCore.WebUtilities
@using Radzen
@using Radzen.Blazor
@using SCLAB_Client.Components.Service.GestionLaboratorio

<PageTitle>Control de Asistencia - Docente</PageTitle>

@if (mostrarModalQR)
{
    <div class="modal-overlay">
        <div class="modal-container-qr">
            <div class="modal-icon">
                <RadzenIcon Icon="qr_code_scanner" Style="font-size: 64px; color: #842A3B;" />
            </div>
            <div class="modal-content">
                <h3 class="modal-title">Registro Requerido</h3>
                <p class="modal-text">
                    Para acceder al sistema, primero debe registrar su asistencia escaneando el código QR
                    de la máquina en el laboratorio.
                </p>
                <p class="modal-subtext">
                    Una vez registrado, podrá ingresar con sus credenciales institucionales.
                </p>
            </div>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="10px" JustifyContent="JustifyContent.Center">
                <RadzenButton Text="Volver al Inicio"
                              Click="@(() => navigationManager.NavigateTo("/"))"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Medium" />
            </RadzenStack>
        </div>
    </div>
}
else if (cargando)
{
    <div class="loading-overlay">
        <div class="loading-container">
            <div class="loading-spinner">
                <RadzenProgressBarCircular ShowValue="false"
                                           Mode="ProgressBarMode.Indeterminate"
                                           Size="ProgressBarCircularSize.Large" />
            </div>
            <div class="loading-content">
                <p class="loading-text">@mensajeCarga</p>
                <small class="loading-subtext">Por favor espere...</small>
            </div>
        </div>
    </div>
}
else
{
    <div class="pacha-layout">
        <div class="pacha-header">
            <div class="header-top-row">
                <RadzenButton Icon="logout"
                              Click="@CerrarSesion"
                              Variant="Variant.Text"
                              Class="btn-logout-mobile"
                              Style="color: white;"
                              Title="Cerrar Sesión" />
            </div>

            <div class="profile-container">
                <div class="avatar-ring">
                    <RadzenIcon Icon="account_circle" Style="font-size: 80px; color: #fff; display: block;" />
                </div>
                <div class="user-info">
                    <h2 class="welcome-text">
                        Hola, <span class="highlight-name">@(oDocenteCLS.Nombre ?? "Docente")</span>
                    </h2>
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" IsPill="true" Text="Docente" Class="rz-mt-1" />
                    @if (asistenciaActualId > 0)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" IsPill="true" Text="Clase en Curso" Class="rz-mt-1" />
                    }
                </div>
            </div>
        </div>

        <div class="content-area">
            <RadzenCard class="main-card rz-shadow-4">
                <RadzenTabs @bind-SelectedIndex="@selectedTabIndex" RenderMode="TabRenderMode.Server" Class="pacha-tabs">
                    <Tabs>
                        <RadzenTabsItem Text="INICIAR CLASE">

                            <RadzenTemplateForm TItem="RegistroAsistenciaDocenteDto"
                                                Data="@asistenciaDocente"
                                                Submit="@(async (RegistroAsistenciaDocenteDto args) => await RegistrarAsistencia(args))">

                                <RadzenStack Gap="1.5rem" Class="rz-p-0 rz-p-md-2">
                                    <RadzenAlert AlertStyle="AlertStyle.Info"
                                                 Variant="Variant.Flat"
                                                 Shade="Shade.Lighter"
                                                 Size="AlertSize.Small"
                                                 AllowClose="false"
                                                 Class="rz-mb-2">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <RadzenIcon Icon="info" />
                                            <RadzenText TextStyle="TextStyle.Body2" Class="rz-m-0">
                                                Presione el botón "Iniciar Clase" para iniciar la clase.
                                            </RadzenText>
                                        </RadzenStack>
                                    </RadzenAlert>

                                    <RadzenRow>
                                        <RadzenColumn Size="6" SizeXS="12">
                                            <RadzenFormField Text="Laboratorio" Variant="Variant.Flat" Style="width: 100%;">
                                                <RadzenTextBox Value="@codigoLaboratorio" Disabled="true" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="6" SizeXS="12">
                                            <RadzenFormField Text="Máquina" Variant="Variant.Flat" Style="width: 100%;">
                                                <RadzenTextBox Value="@codigoMaquina" Disabled="true" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow>
                                        <RadzenColumn Size="6" SizeXS="12">
                                            <RadzenFormField Text="Nombre" Variant="Variant.Flat" Style="width: 100%;">
                                                <RadzenTextBox Value="@oDocenteCLS.Nombre" Disabled="true" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="6" SizeXS="12">
                                            <RadzenFormField Text="Apellido Paterno" Variant="Variant.Flat" Style="width: 100%;">
                                                <RadzenTextBox Value="@oDocenteCLS.ApellidoPaterno" Disabled="true" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow>
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Text="Correo Institucional" Variant="Variant.Flat" Style="width: 100%;">
                                                <RadzenTextBox Value="@oDocenteCLS.CorreoInstitucional" Disabled="true" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow>
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Text="Materia Asignada" Variant="Variant.Flat" Style="width: 100%;">
                                                <RadzenTextBox Value="@(materiaActual ?? "No asignada")" Disabled="true" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow>
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Text="Tipo de Dispositivo" Variant="Variant.Outlined">
                                                <RadzenDropDown @bind-Value="@asistenciaDocente.TipoDisp"
                                                                Name="TipoDispositivoField"
                                                                Data="@(new List<string> { "PC", "LAPTOP" })"
                                                                Placeholder="Seleccione uno"
                                                                Disabled="@(asistenciaActualId > 0)" />
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="TipoDispositivoField" Text="Debe seleccionar un tipo de dispositivo" Popup="true" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenButton ButtonType="ButtonType.Submit"
                                                  Text="INICIAR DE CLASE"
                                                  Icon="check_circle"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Size="ButtonSize.Large"
                                                  Class="btn-guindo rz-mt-4"
                                                  Hidden="@(asistenciaActualId > 0 || string.IsNullOrEmpty(codigoMaquina))" />
                                </RadzenStack>
                            </RadzenTemplateForm>

                        </RadzenTabsItem>

                        <RadzenTabsItem Text="LISTA DE ASISTENCIA" Disabled="@disabled">
                            <RadzenStack Gap="1.2rem" Class="rz-p-0 rz-p-md-2">
                                <RadzenDataGrid Data="@listaEstudiantes"
                                                TItem="UsuariosCLS"
                                                AllowFiltering="true"
                                                AllowPaging="true"
                                                PageSize="10"
                                                AllowSorting="true"
                                                Style="
                                                        --rz-grid-header-background-color:#fafafa;
                                                        --rz-grid-header-color:var(--pacha-guindo-dark);
                                                        --rz-grid-cell-color:var(--pacha-guindo-dark);
                                                        --rz-grid-hover-color:var(--pacha-guindo);
                                                    ">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="UsuariosCLS" Property="Nombre" Title="Nombre Completo" MinWidth="200px" />

                                        <RadzenDataGridColumn TItem="UsuariosCLS" Property="CorreoInstitucional" Title="Correo Institucional">
                                            <Template Context="user">
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
                                                    <RadzenIcon Icon="email" Style="color:var(--pacha-guindo);" />
                                                    <span style="color:var(--pacha-guindo-dark);">@user.CorreoInstitucional</span>
                                                </RadzenStack>
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="UsuariosCLS" Property="FechaRegistro" Title="Hora Registro" Width="250px">
                                            <Template Context="user">
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="5px" AlignItems="AlignItems.Center">
                                                    <RadzenIcon Icon="watch_later" Style="font-size: 14px; color: var(--pacha-guindo);" />
                                                    <span style="font-size: 13px; color: var(--pacha-guindo-dark);">@user.FechaRegistro.ToString("HH:mm:ss")</span>
                                                </RadzenStack>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>

                                @if (asistenciaActualId > 0)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Class="rz-pt-4">
                                        <RadzenButton Text="FINALIZAR CLASE"
                                                      Icon="power_settings_new"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Size="ButtonSize.Large"
                                                      Style="width:260px; height:48px; font-weight:700;"
                                                      Click="@ConfirmarFinalizarClase" />
                                    </RadzenStack>
                                }
                            </RadzenStack>
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="OBSERVACIONES" Disabled="@disabled">
                            <RadzenStack Gap="1rem" Class="rz-p-0 rz-p-md-2">
                                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" Size="AlertSize.Small" AllowClose="false" Class="rz-mb-2">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenIcon Icon="info" />
                                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-m-0">
                                            Reporte cualquier incidencia técnica con la máquina o el laboratorio.
                                        </RadzenText>
                                    </RadzenStack>
                                </RadzenAlert>

                                <RadzenFormField Text="Detalle del problema" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenTextArea @bind-Value="maxLengthValue"
                                                    @oninput="@(args => maxLengthValue = $"{args.Value}")"
                                                    MaxLength="@maxLength"
                                                    Change="@(args => OnChange(args, "Observaciones"))"
                                                    Style="width: 100%; min-height: 150px;"
                                                    Disabled="@disabled"
                                                    Placeholder="Escriba aquí la incidencia..." />
                                </RadzenFormField>

                                <div class="char-counter">@($"{maxLengthValue?.Length ?? 0}/{maxLength}") caracteres</div>

                                <RadzenButton Text="ENVIAR REPORTE"
                                              Icon="send"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Large"
                                              Class="btn-guindo rz-mt-4"
                                              Disabled="@(disabled || string.IsNullOrWhiteSpace(maxLengthValue))"
                                              Click="@GuardarObservaciones" />
                            </RadzenStack>
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
            </RadzenCard>
        </div>
    </div>
}

<style>
    /* Estilos CSS idénticos al original para mantener consistencia */
    :root {
        --pacha-guindo: #842A3B;
        --pacha-guindo-dark: #601e2b;
        --pacha-bg: #f4f6f8;
    }

    .pacha-layout {
        background-color: var(--pacha-bg);
        min-height: 100vh;
        font-family: 'Roboto', sans-serif;
    }

    .pacha-header {
        background: linear-gradient(180deg, var(--pacha-guindo) 0%, var(--pacha-guindo-dark) 100%);
        padding: 20px 15px 40px 15px;
        color: white;
        border-radius: 0;
    }

    .header-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .btn-back-mobile, .btn-logout-mobile {
        background: rgba(255, 255, 255, 0.2) !important;
        border-radius: 50% !important;
        width: 45px !important;
        height: 45px !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .header-brand {
        font-weight: 700;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .profile-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .avatar-ring {
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        padding: 8px;
        border: 2px solid rgba(255,255,255,0.3);
        margin-bottom: 10px;
    }

    .welcome-text {
        font-size: 1.4rem;
        margin: 0;
    }

    .highlight-name {
        font-weight: 700;
    }

    .content-area {
        margin-top: -20px;
        padding: 0 15px 40px 15px;
        display: flex;
        justify-content: center;
        position: relative;
        z-index: 10;
    }

    .main-card {
        width: 100%;
        max-width: 700px;
        border-radius: 12px !important;
        background: white;
        overflow: hidden;
    }

    .pacha-tabs .rz-tabview-nav {
        background: #fff;
        border-bottom: 1px solid #eee;
    }

    .rz-form-field label {
        color: #333 !important;
        font-weight: 500 !important;
        font-size: 0.875rem !important;
    }

    .rz-textbox:disabled {
        color: #555 !important;
        background-color: #f5f5f5 !important;
        opacity: 1 !important;
    }

    .pacha-tabs .rz-tabview-selected {
        color: var(--pacha-guindo) !important;
        border-bottom: 3px solid var(--pacha-guindo) !important;
    }

    .btn-guindo {
        background-color: var(--pacha-guindo) !important;
        color: white !important;
    }

    .char-counter {
        text-align: right;
        font-size: 0.75rem;
        color: #999;
        margin-top: 5px;
    }

    .loading-overlay, .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loading-container {
        background: white;
        padding: 30px;
        border-radius: 12px;
        text-align: center;
    }

    .modal-container-qr {
        background: white;
        padding: 40px;
        border-radius: 12px;
        max-width: 500px;
        text-align: center;
    }
</style>

@code {
    bool disabled = true;
    string maxLengthValue = "";
    int maxLength = 200;
    private bool mostrarModalQR = false;
    private bool cargando = true;
    private string mensajeCarga = "Cargando datos del docente...";
    int selectedTabIndex = 0;

    private string? codigoMaquina;
    private string? codigoLaboratorio;

    private int asistenciaActualId = 0;
    private string materiaActual = string.Empty;

    private int _laboratorioId = 0;
    private int _maquinaId = 0;

    public RegistroAsistenciaDocenteDto asistenciaDocente = new RegistroAsistenciaDocenteDto();
    public List<UsuariosCLS> listaEstudiantes { get; set; } = new List<UsuariosCLS>();
    public UsuariosCLS oDocenteCLS = new UsuariosCLS();
    public UsuarioInfo? correo = new UsuarioInfo();

    [Inject] private IAuthService AuthService { get; set; } = default!;

    private bool isDataLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isDataLoaded)
        {
            await ObtenerDocente();
            isDataLoaded = true;
            StateHasChanged();
        }
    }

    private async Task ObtenerDocente()
    {
        try
        {
            correo = await AuthService.GetCurrentUserInfoAsync();
            if (correo == null || correo.Rol.ToLower() != "docente")
            {
                notificationService.Notify(NotificationSeverity.Error, "Acceso denegado", "Esta sección es solo para docentes");
                navigationManager.NavigateTo("/");
                return;
            }

            oDocenteCLS = await docenteService.ObtenerDocenteId(correo.UsuarioId);

            var uri = navigationManager.ToAbsoluteUri(navigationManager.Uri);
            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("codigoMaquina", out var maquinaValue))
            {
                codigoMaquina = maquinaValue.ToString();
            }
            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("codigoLaboratorio", out var laboratorioValue))
            {
                codigoLaboratorio = laboratorioValue.ToString();
            }

            if (string.IsNullOrEmpty(codigoMaquina) || string.IsNullOrEmpty(codigoLaboratorio))
            {
                mostrarModalQR = true;
                cargando = false;
                StateHasChanged();
                return;
            }
            cargando = false;
            StateHasChanged();

            if (!string.IsNullOrEmpty(codigoLaboratorio) && !string.IsNullOrEmpty(codigoMaquina))
            {
                _laboratorioId = await laboratorioService.ObtenerIdLaboratorio(codigoLaboratorio);
                _maquinaId = await maquinaService.ObtenerIdPorCodigo(codigoMaquina);
            }

            if (oDocenteCLS.UsuarioId > 0 && _laboratorioId > 0 && _maquinaId > 0)
            {
                var asistenciasActivas = await docenteService.ObtenerAsistenciasDocentesActivas(_laboratorioId);

                var miSesionActiva = asistenciasActivas.FirstOrDefault(a => a.UsuarioId == oDocenteCLS.UsuarioId && a.MaquinaId == _maquinaId);

                if (miSesionActiva != null)
                {
                    asistenciaActualId = miSesionActiva.AsistenciaId;
                    materiaActual = miSesionActiva.Materia;
                    disabled = false;
                    await CargarListaEstudiantes();
                }
            }

        }
        catch (Exception ex)
        {
            oDocenteCLS = new UsuariosCLS() { Nombre = "Error", CorreoInstitucional = "Error" };
            notificationService.Notify(NotificationSeverity.Error, "Error", $"No se pudieron cargar los datos. Detalle: {ex.Message}");
            cargando = false;
        }
    }

    async Task RegistrarAsistencia(RegistroAsistenciaDocenteDto model)
    {
        if (_laboratorioId == 0 || _maquinaId == 0)
        {
            notificationService.Notify(NotificationSeverity.Error, "Error QR", "Códigos de máquina o laboratorio inválidos. Escanee el QR nuevamente.");
            return;
        }

        model.UsuarioId = oDocenteCLS.UsuarioId;
        model.MaquinaId = _maquinaId;
        model.LaboratorioId = _laboratorioId;

        var respuesta = await docenteService.RegistrarAsistenciaDocente(model);

        if (respuesta.IsSuccess)
        {
            disabled = false;

            if (respuesta.Data is SCLAB_Client.Components.Service.GestionLaboratorio.RegistroExitosoDto datosExitosos)
            {
                asistenciaActualId = datosExitosos.asistenciaId;
                materiaActual = datosExitosos.materia;
            }

            notificationService.Notify(NotificationSeverity.Success, "Clase Iniciada", respuesta.Message);

            if (!string.IsNullOrEmpty(materiaActual))
            {
                await CargarListaEstudiantes();
            }
            StateHasChanged();
        }
        else
        {
            NotificationSeverity severity = respuesta.Message.Contains("No hay un horario") || respuesta.Message.Contains("Ya existe")
                                             ? NotificationSeverity.Warning
                                             : NotificationSeverity.Error;

            notificationService.Notify(severity, "Aviso", respuesta.Message);
            Console.WriteLine($"[ERROR]{respuesta.Message}");
        }
    }

    private async Task CargarListaEstudiantes()
    {
        if (string.IsNullOrEmpty(materiaActual)) return;

        try
        {
            listaEstudiantes = await docenteService.ObtenerEstudiantesPorMateria(materiaActual);
            StateHasChanged();
        }
        catch
        {
            notificationService.Notify(NotificationSeverity.Error, "Error", "No se pudo cargar la lista de estudiantes.");
        }
    }

    private async Task ConfirmarFinalizarClase()
    {
        var result = await DialogService.Confirm("¿Está seguro de que desea finalizar la clase?", "Confirmar Finalización",
            new ConfirmOptions() { OkButtonText = "Sí, Finalizar", CancelButtonText = "No" });

        if (result.HasValue && result.Value)
        {
            await FinalizarClase();
        }
    }

    private async Task FinalizarClase()
    {
        if (asistenciaActualId == 0) return;

        var resultado = await docenteService.FinalizarAsistenciaDocente(asistenciaActualId);

        if (resultado.IsSuccess)
        {
            notificationService.Notify(NotificationSeverity.Success, "Clase Finalizada", resultado.Message);

            asistenciaActualId = 0;
            materiaActual = string.Empty;
            disabled = true;
            listaEstudiantes.Clear();
            maxLengthValue = string.Empty;
            StateHasChanged();
        }
        else
        {
            notificationService.Notify(NotificationSeverity.Error, "Error", resultado.Message);
        }
    }

    private async Task GuardarObservaciones()
    {
        if (string.IsNullOrWhiteSpace(maxLengthValue))
        {
            notificationService.Notify(NotificationSeverity.Warning, "Advertencia", "La observación no puede estar vacía.");
            return;
        }

        if (asistenciaActualId == 0)
        {
            notificationService.Notify(NotificationSeverity.Warning, "Advertencia", "Debe registrar la asistencia primero.");
            return;
        }

        var nuevaAlerta = new SCLAB_Client.Components.Service.CrearAlertaDto
        {
            MaquinaId = _maquinaId,
            UsuarioId = oDocenteCLS.UsuarioId,
            Descripcion = maxLengthValue,
            CambiarEstadoMaquina = true
        };

        var respuestaAlerta = await alertaService.CrearAlerta(nuevaAlerta);

        if (respuestaAlerta.IsSuccess)
        {
            notificationService.Notify(NotificationSeverity.Success, "Alerta Registrada", "Se ha notificado al encargado y la máquina está en mantenimiento.");

            var dtoAsistencia = new Service.GestionLaboratorio.ActualizarObservacionDto { Observacion = maxLengthValue };
            await docenteService.ActualizarObservaciones(asistenciaActualId, dtoAsistencia);
            maxLengthValue = string.Empty;
        }
        else
        {
            notificationService.Notify(NotificationSeverity.Error, "Error", respuestaAlerta.Message);
        }
    }

    private void CerrarModalQR()
    {
        mostrarModalQR = false;
        StateHasChanged();
    }
    private void VolverAlLogin() => navigationManager.NavigateTo("/login");
    private void OnChange(object value, string name) { }

    private async Task CerrarSesion()
    {
        var result = await DialogService.Confirm("¿Desea cerrar sesión?", "Cerrar Sesión",
            new ConfirmOptions() { OkButtonText = "Sí", CancelButtonText = "Cancelar" });

        if (result.HasValue && result.Value)
        {
            await AuthService.LogoutAsync();
            navigationManager.NavigateTo("/", forceLoad: true);
        }
    }
}