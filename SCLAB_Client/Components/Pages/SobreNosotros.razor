@page "/sobre-nosotros"
@using Microsoft.AspNetCore.Mvc.Formatters
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Sobre Nosotros - PachaSoft</PageTitle>

<div class="sobre-nosotros-container" id="nosotros">
    <!-- Hero Section con Parallax -->
    <section class="hero-section">
        <div class="hero-overlay">
            <div class="hero-content animate-fade-in">
                <div class="hero-badge">EST. 2025</div>
                <h1 class="hero-title">Sobre PachaSoft</h1>
                <div class="hero-divider"></div>
                <p class="hero-subtitle">Transformando ideas en soluciones tecnológicas innovadoras</p>
                <div class="scroll-indicator">
                    <span>Descubre más</span>
                    <RadzenIcon Icon="keyboard_arrow_down" Style="font-size: 24px;" />
                </div>
            </div>
        </div>
    </section>

    <!-- Historia Section Mejorada -->
    <section class="historia-section">
        <div class="content-wrapper">
            <div class="section-header">
                <span class="section-label">Nuestro Viaje</span>
                <h2 class="section-title">Nuestra Historia</h2>
                <div class="title-underline"></div>
            </div>
            
            <div class="historia-content">
                <div class="historia-text">
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <p class="destacado">2025 - El Comienzo</p>
                            <p>PachaSoft nació gracias a un proyecto de semestre con la visión de todo un grupo comprometido en crear soluciones tecnológicas que realmente impacten en el crecimiento de las empresas. Desde nuestros inicios, nos hemos dedicado a entender las necesidades específicas de cada cliente mediante todos los procesos para obtener información del sistema que se adecua a su comodidad.</p>
                        </div>
                    </div>
                    
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <p class="destacado">Nuestro Crecimiento</p>                    
                            <p>A lo largo de los meses, aprendimos a trabajar en equipo gracias al mismo proyecto que estamos presentando del sistema de gestión para las hojas de control, tomando en cuenta todos los procesos que llegamos a hacer desde las primeras entrevistas hasta la misma creación de diagramas, esto con el fin de que nos pueda ayudar a elaborar más proyectos en equipo.</p>
                        </div>
                    </div>
                </div>
                
                <div class="historia-image-wrapper">
                    <div class="image-decoration"></div>
                    <img src="/images/logo2.png" alt="Equipo PachaSoft" class="historia-image" />
                </div>
            </div>
        </div>
    </section>

    <!-- Valores Section Premium -->
    <section class="valores-section">
        <div class="content-wrapper">
            <div class="section-header">
                <span class="section-label">Lo que nos define</span>
                <h2 class="section-title">Nuestros Valores</h2>
                <div class="title-underline"></div>
            </div>
            
            <div class="valores-grid">
                <div class="valor-card">
                    <div class="valor-icon-wrapper">
                        <div class="valor-icon-bg"></div>
                        <RadzenIcon Icon="verified" Style="font-size: 50px; color: #8B4C4C;" />
                    </div>
                    <h3>Calidad</h3>
                    <p>Nos comprometemos a entregar productos de la más alta calidad, siguiendo las mejores prácticas de desarrollo.</p>
                    <div class="card-shine"></div>
                </div>

                <div class="valor-card">
                    <div class="valor-icon-wrapper">
                        <div class="valor-icon-bg"></div>
                        <RadzenIcon Icon="lightbulb" Style="font-size: 50px; color: #8B4C4C;" />
                    </div>
                    <h3>Innovación</h3>
                    <p>Buscamos constantemente nuevas tecnologías y metodologías para ofrecer soluciones vanguardistas.</p>
                    <div class="card-shine"></div>
                </div>

                <div class="valor-card">
                    <div class="valor-icon-wrapper">
                        <div class="valor-icon-bg"></div>
                        <RadzenIcon Icon="handshake" Style="font-size: 50px; color: #8B4C4C;" />
                    </div>
                    <h3>Compromiso</h3>
                    <p>Trabajamos codo a codo con nuestros clientes para garantizar el éxito de cada proyecto.</p>
                    <div class="card-shine"></div>
                </div>

                <div class="valor-card">
                    <div class="valor-icon-wrapper">
                        <div class="valor-icon-bg"></div>
                        <RadzenIcon Icon="groups" Style="font-size: 50px; color: #8B4C4C;" />
                    </div>
                    <h3>Trabajo en Equipo</h3>
                    <p>Creemos en la colaboración y el apoyo mutuo como pilares fundamentales del éxito.</p>
                    <div class="card-shine"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Equipo Section Premium -->
    <section class="equipo-section">
        <div class="content-wrapper">
            <div class="section-header">
                <span class="section-label">Los cerebros detrás de PachaSoft</span>
                <h2 class="section-title">Nuestro Equipo</h2>
                <div class="title-underline"></div>
                <p class="equipo-intro">Un equipo apasionado, comprometido y altamente capacitado</p>
            </div>
            
            <div class="equipo-grid">
                <div class="miembro-card">
                    <div class="miembro-avatar-wrapper">
                        <div class="avatar-ring"></div>
                        <div class="miembro-avatar">
                            <img src="/images/equipo/Dubraska.webp" alt="Jhael Dubraska" />
                        </div>
                    </div>
                    <h3>Jhael Dubraska Arguedas Guerreros</h3>
                    <p class="cargo">
                        <RadzenIcon Icon="code" Style="font-size: 16px; margin-right: 5px;" />
                        Back End Developer
                    </p>
                </div>

                <div class="miembro-card">
                    <div class="miembro-avatar-wrapper">
                        <div class="avatar-ring"></div>
                        <div class="miembro-avatar">
                            <img src="/images/equipo/Fabricio.webp" alt="Angel Fabricio" />
                        </div>
                    </div>
                    <h3>Angel Fabricio Paredes Campos</h3>
                    <p class="cargo">
                        <RadzenIcon Icon="brush" Style="font-size: 16px; margin-right: 5px;" />
                        Front End Developer
                    </p>
                </div>

                <div class="miembro-card">
                    <div class="miembro-avatar-wrapper">
                        <div class="avatar-ring"></div>
                        <div class="miembro-avatar">
                            <img src="/images/equipo/Eduardo.webp" alt="Carlos Eduardo" />
                        </div>
                    </div>
                    <h3>Carlos Eduardo Conde Mamani</h3>
                    <p class="cargo">
                        <RadzenIcon Icon="code" Style="font-size: 16px; margin-right: 5px;" />
                        Back End Developer
                    </p>
                </div>

                <div class="miembro-card">
                    <div class="miembro-avatar-wrapper">
                        <div class="avatar-ring"></div>
                        <div class="miembro-avatar">
                            <img src="/images/equipo/John.webp" alt="John Martin" />
                        </div>
                    </div>
                    <h3>John Martin Zabaleta Cano</h3>
                    <p class="cargo">
                        <RadzenIcon Icon="brush" Style="font-size: 16px; margin-right: 5px;" />
                        Front End Developer
                    </p>
                </div>
            </div>
        </div>
    </section>

@*     <!-- Estadísticas Premium -->
    <section class="stats-section">
        <div class="stats-overlay"></div>
        <div class="content-wrapper">
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-icon">
                        <RadzenIcon Icon="check_circle" Style="font-size: 40px;" />
