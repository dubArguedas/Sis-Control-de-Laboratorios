    <!-- CTA Final Premium -->
    <section class="cta-section">
        <div class="cta-content">
            <div class="cta-decoration"></div>
            <h2>¿Listo para trabajar con nosotros?</h2>
            <p>Contáctanos y descubre cómo podemos ayudarte a transformar tu negocio</p>
            <RadzenButton Text="Contáctanos Ahora" 
                         Icon="email"
                         ButtonStyle="ButtonStyle.Primary"
                         Size="ButtonSize.Large"
                         Class="btn-contacto" 
                         Click="@(() => Navigation.NavigateTo("/#contact-section"))" />
            <div class="cta-features">
                <div class="feature-item">
                    <RadzenIcon Icon="check" Style="font-size: 20px;" />
                    <span>Respuesta en 24h</span>
                </div>
                <div class="feature-item">
                    <RadzenIcon Icon="check" Style="font-size: 20px;" />
                    <span>Consultoría gratuita</span>
                </div>
                <div class="feature-item">
                    <RadzenIcon Icon="check" Style="font-size: 20px;" />
                    <span>Soluciones personalizadas</span>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .sobre-nosotros-container {
        width: 100%;
        overflow-x: hidden;
    }

    /* Hero Section Premium */
    .hero-section {
        height: 100vh;
        background: linear-gradient(135deg, #8B4C4C 0%, #5a3030 50%, #3d1f1f 100%);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('/images/fotogrupo.jpeg') center/cover;
        opacity: 0.08;
        animation: subtle-zoom 20s ease-in-out infinite alternate;
    }

    .hero-section::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle at 50% 50%, transparent 0%, rgba(0,0,0,0.4) 100%);
    }

    @@keyframes subtle-zoom {
        from { transform: scale(1); }
        to { transform: scale(1.05); }
    }

    .hero-overlay {
        position: relative;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
    }

    .hero-content {
        text-align: center;
        color: white;
        max-width: 900px;
        padding: 0 20px;
    }

    .hero-badge {
        display: inline-block;
        padding: 8px 24px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 2px;
        margin-bottom: 30px;
        animation: fade-in-down 1s ease-out;
    }

    .hero-title {
        font-size: 80px;
        font-weight: 800;
        margin-bottom: 30px;
        text-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        letter-spacing: -2px;
        animation: fade-in-up 1s ease-out 0.2s both;
    }

    .hero-divider {
        width: 100px;
        height: 4px;
        background: linear-gradient(90deg, transparent, white, transparent);
        margin: 0 auto 30px;
        animation: fade-in 1s ease-out 0.4s both;
    }

    .hero-subtitle {
        font-size: 28px;
        font-weight: 300;
        opacity: 0.95;
        line-height: 1.6;
        animation: fade-in-up 1s ease-out 0.6s both;
    }

    .scroll-indicator {
        position: absolute;
        bottom: 40px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        color: white;
        opacity: 0.7;
        animation: bounce 2s ease-in-out infinite;
    }

    @@keyframes bounce {
        0%, 100% { transform: translateX(-50%) translateY(0); }
        50% { transform: translateX(-50%) translateY(-10px); }
    }

    @@keyframes fade-in-down {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fade-in-up {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* Content Wrapper */
    .content-wrapper {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 60px;
    }

    /* Section Header Premium */
    .section-header {
        text-align: center;
        margin-bottom: 80px;
    }

    .section-label {
        display: inline-block;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: #8B4C4C;
        margin-bottom: 15px;
    }

    .section-title {
        font-size: 56px;
        color: #1a1a1a;
        margin-bottom: 20px;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .title-underline {
        width: 80px;
        height: 4px;
        background: linear-gradient(90deg, #8B4C4C, #5a3030);
        margin: 0 auto;
        border-radius: 2px;
    }

    /* Historia Section Premium */
    .historia-section {
        padding: 140px 0;
        background: #ffffff;
        position: relative;
    }

    .historia-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: center;
    }

    .historia-text {
        position: relative;
    }

    .timeline-item {
        position: relative;
        padding-left: 40px;
        margin-bottom: 40px;
    }

    .timeline-dot {
        position: absolute;
        left: 0;
        top: 8px;
        width: 16px;
        height: 16px;
        background: #8B4C4C;
        border-radius: 50%;
        border: 4px solid #fff;
        box-shadow: 0 0 0 4px rgba(139, 76, 76, 0.2);
    }

    .timeline-content {
        background: #f9f9f9;
        padding: 30px;
        border-radius: 15px;
        border-left: 4px solid #8B4C4C;
    }

    .historia-text p {
        font-size: 17px;
        line-height: 1.9;
        color: #555;
        margin-bottom: 0;
    }

    .historia-text .destacado {
        font-size: 24px;
        font-weight: 700;
        color: #8B4C4C;
        margin-bottom: 15px;
        display: block;
    }

    .historia-image-wrapper {
        position: relative;
    }

    .image-decoration {
        position: absolute;
        top: -20px;
        right: -20px;
        width: 200px;
        height: 200px;
        background: linear-gradient(135deg, #8B4C4C, #5a3030);
        opacity: 0.1;
        border-radius: 30px;
        z-index: 0;
    }

    .historia-image {
        width: 100%;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
        position: relative;
        z-index: 1;
        transition: transform 0.5s ease;
    }

    .historia-image:hover {
        transform: scale(1.03);
    }

    /* Valores Section Premium */
    .valores-section {
        padding: 140px 0;
        background: linear-gradient(135deg, #f8f8f8 0%, #ececec 100%);
        position: relative;
    }

    .valores-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 40px;
    }

    .valor-card {
        background: white;
        padding: 50px 35px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .valor-card:hover {
        transform: translateY(-15px);
        box-shadow: 0 25px 60px rgba(139, 76, 76, 0.25);
    }

    .card-shine {
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent, rgba(255,255,255,0.3), transparent);
        transform: rotate(45deg);
        transition: all 0.6s;
        pointer-events: none;
    }

    .valor-card:hover .card-shine {
        left: 100%;
    }

    .valor-icon-wrapper {
        position: relative;
        display: inline-block;
        margin-bottom: 30px;
    }

    .valor-icon-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, rgba(139, 76, 76, 0.1), rgba(90, 48, 48, 0.1));
        border-radius: 50%;
        transition: all 0.4s ease;
    }

    .valor-card:hover .valor-icon-bg {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, rgba(139, 76, 76, 0.2), rgba(90, 48, 48, 0.2));
    }

    .valor-card h3 {
        font-size: 26px;
        color: #1a1a1a;
        margin-bottom: 20px;
        font-weight: 700;
    }

    .valor-card p {
        font-size: 15px;
        line-height: 1.8;
        color: #666;
    }

    /* Equipo Section Premium */
    .equipo-section {
        padding: 140px 0;
        background: white;
        position: relative;
    }

    .equipo-intro {
        text-align: center;
        font-size: 20px;
        color: #666;
        margin-top: 20px;
        font-weight: 300;
    }

    .equipo-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 50px;
        margin-top: 80px;
    }

    .miembro-card {
        text-align: center;
        transition: transform 0.4s ease;
    }

    .miembro-card:hover {
        transform: translateY(-10px);
    }

    .miembro-avatar-wrapper {
        position: relative;
        display: inline-block;
        margin-bottom: 30px;
    }

    .avatar-ring {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 180px;
        height: 180px;
        border: 3px solid transparent;
        border-radius: 50%;
        background: linear-gradient(white, white) padding-box,
                    linear-gradient(135deg, #8B4C4C, #5a3030) border-box;
        transition: all 0.4s ease;
    }

    .miembro-card:hover .avatar-ring {
        width: 190px;
        height: 190px;
        filter: drop-shadow(0 10px 30px rgba(139, 76, 76, 0.4));
    }

    .miembro-avatar {
        width: 170px;
        height: 170px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
        border: 6px solid white;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    }

    .miembro-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform 0.4s ease;
    }

    .miembro-card:hover .miembro-avatar img {
        transform: scale(1.1);
    }

    .miembro-card h3 {
        font-size: 22px;
        color: #1a1a1a;
        margin-bottom: 10px;
        font-weight: 700;
        line-height: 1.3;
    }

    .miembro-card .cargo {
        font-size: 15px;
        color: #8B4C4C;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    /* Stats Section Premium */
    .stats-section {
        padding: 120px 0;
        background: linear-gradient(135deg, #8B4C4C 0%, #5a3030 50%, #3d1f1f 100%);
        color: white;
        position: relative;
        overflow: hidden;
    }

    .stats-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: 
            radial-gradient(circle at 20% 50%, rgba(255,255,255,0.1) 0%, transparent 50%),
            radial-gradient(circle at 80% 50%, rgba(255,255,255,0.1) 0%, transparent 50%);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 60px;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .stat-item {
        padding: 40px 20px;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        transition: all 0.4s ease;
    }

    .stat-item:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-10px);
    }

    .stat-icon {
        margin-bottom: 20px;
        opacity: 0.9;
    }

    .stat-number {
        font-size: 64px;
        font-weight: 800;
        margin-bottom: 15px;
        background: linear-gradient(135deg, #ffffff, #e0e0e0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .stat-label {
        font-size: 18px;
        opacity: 0.9;
        font-weight: 300;
        letter-spacing: 1px;
    }

    /* CTA Section Premium */
    .cta-section {
        padding: 140px 0;
        background: linear-gradient(135deg, #f8f8f8 0%, #ffffff 100%);
        position: relative;
        overflow: hidden;
    }

    .cta-content {
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
        padding: 0 20px;
        position: relative;
        z-index: 1;
    }

    .cta-decoration {
        position: absolute;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(139, 76, 76, 0.1) 0%, transparent 70%);
        border-radius: 50%;
    }

    .cta-section h2 {
        font-size: 52px;
        color: #1a1a1a;
        margin-bottom: 25px;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .cta-section p {
        font-size: 22px;
        color: #666;
        margin-bottom: 50px;
        line-height: 1.6;
    }

    .btn-contacto {
        background: linear-gradient(135deg, #8B4C4C 0%, #6d3838 100%) !important;
        padding: 20px 60px !important;
        font-size: 18px !important;
        font-weight: 700 !important;
