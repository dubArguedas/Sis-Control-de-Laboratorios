@page "/login"
@layout LoginLayout
@rendermode InteractiveServer
@using SCLAB_Client.Services
@using SCLAB_Client.Models
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject NotificationService NotificationService
@inject IConfiguration Configuration

<PageTitle>Iniciar Sesión - PachaSoft</PageTitle>

<div class="login-container">
    <RadzenButton Icon="arrow_back"
                  Click="@(() => NavigationManager.NavigateTo("/"))"
                  ButtonStyle="ButtonStyle.Light"
                  Class="btn-volver-inicio"
                  Title="Volver al inicio" />

    <RadzenColumn Size="12" SizeMD="8" SizeLG="6" SizeXL="4" Class="login-column">
        <RadzenCard Class="login-card-custom">

            <div class="logo-section">
                <img src="/images/uniolog.png" style="width:90px" alt="PachaSoft Logo" class="logo" />
            </div>

            <h2 class="login-title">Iniciar Sesión</h2>
            <p class="login-subtitle">Ingresar con datos de la Universidad</p>

            <!-- Alertas simplificadas -->
            @if (loginState.IsBlocked)
            {
                <div class="alert-simple alert-danger">
                    <div class="alert-icon">🔒</div>
                    <div class="alert-content">
                        <div class="alert-title">Cuenta Bloqueada</div>
                        <div class="alert-message">
                            Demasiados intentos fallidos. Intente nuevamente en <strong>@loginState.TimeRemaining</strong>
                        </div>
                    </div>
                </div>
            }
            else if (loginState.ShowWarning && loginState.RemainingAttempts < maxIntentos)
            {
                <div class="alert-simple alert-warning">
                    <div class="alert-icon">⚠️</div>
                    <div class="alert-content">
                        <div class="alert-title">Credenciales Incorrectas</div>
                        <div class="alert-message">
                            Intentos restantes: <strong>@(loginState.RemainingAttempts) de @maxIntentos</strong>
                        </div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(loginState.ErrorMessage) && !loginState.ShowWarning)
            {
                <div class="alert-simple alert-info">
                    <div class="alert-icon">ℹ️</div>
                    <div class="alert-content">
                        <div class="alert-title">Información</div>
                        <div class="alert-message">@loginState.ErrorMessage</div>
                    </div>
                </div>
            }

            <RadzenTemplateForm Data="@loginModel" Class="login-form" TItem="LoginDto" Submit="@HandleLogin">
                <RadzenStack Gap="1.5rem" Class="form-stack">

                    <!-- Campo Email -->
                    <div class="form-group-custom">
                        <RadzenLabel Text="Correo Institucional" Class="form-label-custom" />
                        <RadzenTextBox @bind-Value="@CorreoInstitucional"
                                       Placeholder="usuario@est.univalle.edu"
                                       Style="width: 100%;"
                                       Disabled="@(loginState.IsBlocked || loginState.IsLoading)"
                                       Class="form-input-custom"
                                       TabIndex="1"
                                       autocomplete="username" />
                        @if (!string.IsNullOrWhiteSpace(CorreoInstitucional) && !IsEmailValid())
                        {
                            <div class="input-error">
                                <RadzenIcon Icon="error" Style="font-size: 14px;" />
                                Debe ser un correo institucional válido
                            </div>
                        }
                    </div>

                    <!-- Campo Contraseña -->
                    <div class="form-group-custom">
                        <div class="password-header">
                            <RadzenLabel Text="Contraseña" Class="form-label-custom" />
                            <a href="javascript:void(0)" @onclick="MostrarModalOlvidoContrasena" class="forgot-password" tabindex="5">
                                ¿Olvidó su contraseña?
                            </a>
                        </div>
                        <RadzenPassword @bind-Value="@Password"
                                        Style="width: 100%;"
                                        Disabled="@(loginState.IsBlocked || loginState.IsLoading)"
                                        Class="form-input-custom"
                                        TabIndex="2"
                                        Placeholder="Ingrese su contraseña"
                                        autocomplete="current-password" />
                        @if (!string.IsNullOrWhiteSpace(Password) && Password.Length < 5)
                        {
                            <div class="input-warning">
                                <RadzenIcon Icon="info" Style="font-size: 14px;" />
                                La contraseña debe tener al menos 5 caracteres
                            </div>
                        }
                    </div>

                    <!-- Botón de Login -->
                    <RadzenButton Text="@GetLoginButtonText()"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@IsLoginDisabled()"
                                  Icon="@GetLoginButtonIcon()"
                                  Class="btn-entrar-custom"
                                  Size="ButtonSize.Large"
                                  TabIndex="3"
                                  ButtonType="ButtonType.Submit" />

                </RadzenStack>
            </RadzenTemplateForm>

            <!-- Footer -->
            <div class="footer-section">
                <p class="security-notice">
                    <RadzenIcon Icon="verified_user" />
                </p>
            </div>
        </RadzenCard>
    </RadzenColumn>
</div>

<!-- Loading Overlay Mejorado -->
@if (loginState.IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-container">
            <div class="loading-spinner">
                <RadzenProgressBarCircular ShowValue="false"
                                           Mode="ProgressBarMode.Indeterminate"
                                           Size="ProgressBarCircularSize.Large" />
            </div>
            <div class="loading-content">
                <p class="loading-text">@loginState.LoadingMessage</p>
                <small class="loading-subtext">Por favor espere...</small>
            </div>
        </div>
    </div>
}

<!-- Modal Olvidó Contraseña -->
@if (mostrarModalOlvidoContrasena)
{
    <div class="loading-overlay">
        <div class="modal-container">
            <div class="modal-icon">
                <RadzenIcon Icon="support_agent" Style="font-size: 48px; color: #842A3B;" />
            </div>
            <div class="modal-content">
                <h3 class="modal-title">Recuperación de Contraseña</h3>
                <p class="modal-text">Comunícate con el administrador de la universidad</p>
            </div>
            <RadzenButton Text="Entendido"
                          Click="@CerrarModalOlvidoContrasena"
                          ButtonStyle="ButtonStyle.Primary"
                          Class="modal-btn"
                          Size="ButtonSize.Medium" />
        </div>
    </div>
}

