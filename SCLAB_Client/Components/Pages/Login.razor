@code {
    private SCLAB_Client.Models.LoginDto loginModel = new();
    private string CorreoInstitucional { get; set; } = "";
    private string Password { get; set; } = "";
    private bool showPassword = false;


    // 🔥 NUEVO: Parámetros del QR
    protected string? CodigoMaquina { get; set; }
    protected string? CodigoLaboratorio { get; set; }

    // Configuración de seguridad
    private int maxIntentos = 3;
    private int bloqueoMinutos = 10;
    private System.Threading.Timer? bloqueoTimer;

    // Estado del login
    private LoginState loginState = new();

    // Estado del modal
    private bool mostrarModalOlvidoContrasena = false;

    protected override void OnInitialized()
    {
        // Obtener parámetros del QR de la URL
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("codigoMaquina", out var maquinaValue))
        {
            CodigoMaquina = maquinaValue.ToString();
        }

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("codigoLaboratorio", out var laboratorioValue))
        {
            CodigoLaboratorio = laboratorioValue.ToString();
        }

        Console.WriteLine($"Código de Máquina recibido: {CodigoMaquina}");
        Console.WriteLine($"Código de Laboratorio recibido: {CodigoLaboratorio}");

        maxIntentos = Configuration.GetValue<int>("Security:MaxLoginAttempts", 3);
        bloqueoMinutos = Configuration.GetValue<int>("Security:BlockDurationMinutes", 10);
    }




    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void MostrarModalOlvidoContrasena()
    {
        mostrarModalOlvidoContrasena = true;
        StateHasChanged();
    }

    private void CerrarModalOlvidoContrasena()
    {
        mostrarModalOlvidoContrasena = false;
        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        if (IsLoginDisabled())
            return;

        loginState.IsLoading = true;
        loginState.LoadingMessage = "Verificando credenciales...";
        loginState.ShowWarning = false;
        loginState.ErrorMessage = "";
        StateHasChanged();

        try
        {
            // Normalizar correo
            var correo = CorreoInstitucional.Trim().ToLowerInvariant();

            // Validar formato de correo primero
            if (!IsEmailValid())
            {
                loginState.ErrorMessage = "El formato del correo institucional no es válido. Use: usuario@est.univalle.edu";
                loginState.ErrorType = "INVALID_FORMAT";
                loginState.IsLoading = false;
                StateHasChanged();
                return;
            }

            // LLAMADA A LA API - Usar el tipo correcto de LoginResponse
            var response = await AuthService.LoginAsync(correo, Password);

            if (!string.IsNullOrEmpty(response.Token))
            {
                // Login exitoso
                loginState.LoadingMessage = "Acceso concedido. Redirigiendo...";
                StateHasChanged();

                await MostrarNotificacion("¡Bienvenido!", "Inicio de sesión exitoso", NotificationSeverity.Success);

                // Obtener información del usuario
                var userInfo = await AuthService.GetCurrentUserInfoAsync();

                // Redirigir según el rol
                await Task.Delay(800);
                await RedirigirSegunRol(userInfo?.Rol ?? "");
            }
            else
            {
                // Login fallido - Mejorar manejo de errores
                await ManejarErrorLogin(response);
            }
        }
        catch (HttpRequestException)
        {
            loginState.ErrorMessage = "Error de conexión con el servidor. Verifique su conexión a internet.";
            loginState.ErrorType = "CONNECTION_ERROR";
            loginState.IsLoading = false;

            await MostrarNotificacion(
                "Error de Conexión",
                "No se pudo conectar con el servidor.",
                NotificationSeverity.Error
            );
        }
        catch (Exception)
        {
            loginState.ErrorMessage = "Error interno del sistema. Por favor, intente nuevamente.";
            loginState.ErrorType = "SYSTEM_ERROR";
            loginState.IsLoading = false;

            await MostrarNotificacion(
                "Error del Sistema",
                "Ha ocurrido un error inesperado.",
                NotificationSeverity.Error
            );
        }
        finally
        {
            loginState.IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task ManejarErrorLogin(LoginResponse response) // Cambiado a LoginResponse sin namespace
    {
        loginState.IsBlocked = response.IsBlocked;
        loginState.RemainingAttempts = response.RemainingAttempts;
        loginState.ErrorType = response.ErrorType;

        // Manejar diferentes tipos de errores según la respuesta del servidor
        if (response.IsBlocked)
        {
            loginState.ErrorMessage = response.Message ?? "Cuenta bloqueada por demasiados intentos fallidos";
            loginState.TimeRemaining = response.TimeRemaining.ToString(@"mm\:ss");
            IniciarTimerBloqueo();
        }
        else
        {
            switch (response.ErrorType)
            {
                case "USER_NOT_FOUND":
                    loginState.ErrorMessage = "El correo no está registrado en el sistema";
                    loginState.ShowWarning = false;
                    break;
                case "USER_INACTIVE":
                    loginState.ErrorMessage = "Su cuenta está inactiva. Contacte al administrador";
                    loginState.ShowWarning = false;
                    break;
                case "WRONG_PASSWORD":
                    loginState.ErrorMessage = "Contraseña incorrecta";
                    loginState.ShowWarning = true;
                    loginState.RemainingAttempts = Math.Max(0, loginState.RemainingAttempts - 1);

                    // Bloquear después de máximo de intentos
                    if (loginState.RemainingAttempts <= 0)
                    {
                        loginState.IsBlocked = true;
                        loginState.ErrorMessage = "Cuenta bloqueada por demasiados intentos fallidos";
                        loginState.TimeRemaining = $"{bloqueoMinutos}:00";
                        IniciarTimerBloqueo();
                    }
                    break;
                case "INVALID_EMAIL":
                    loginState.ErrorMessage = "Formato de correo electrónico inválido";
                    loginState.ShowWarning = false;
                    break;
                case "INVALID_CREDENTIALS":
                    loginState.ErrorMessage = "Credenciales inválidas";
                    loginState.ShowWarning = true;
                    loginState.RemainingAttempts = Math.Max(0, loginState.RemainingAttempts - 1);
                    break;
                default:
                    loginState.ErrorMessage = response.Message ?? "Error al iniciar sesión. Por favor, intente nuevamente";
                    loginState.ShowWarning = false;
                    break;
            }
        }

        StateHasChanged();
    }

    private void IniciarTimerBloqueo()
    {
        bloqueoTimer?.Dispose();
        var tiempoBloqueo = TimeSpan.FromMinutes(bloqueoMinutos);
        loginState.TimeRemaining = tiempoBloqueo.ToString(@"mm\:ss");

        bloqueoTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() =>
            {
                loginState.IsBlocked = false;
                loginState.RemainingAttempts = maxIntentos;
                loginState.ShowWarning = false;
                loginState.ErrorMessage = "";
                bloqueoTimer?.Dispose();
                StateHasChanged();
            });
        }, null, tiempoBloqueo, Timeout.InfiniteTimeSpan);

        // Actualizar el contador cada segundo
        _ = ActualizarContadorBloqueo(tiempoBloqueo);
    }

    private async Task ActualizarContadorBloqueo(TimeSpan tiempoTotal)
    {
        var tiempoRestante = tiempoTotal;
        while (tiempoRestante > TimeSpan.Zero && loginState.IsBlocked)
        {
            await Task.Delay(1000);
            tiempoRestante = tiempoRestante.Subtract(TimeSpan.FromSeconds(1));
            await InvokeAsync(() =>
            {
                loginState.TimeRemaining = tiempoRestante.ToString(@"mm\:ss");
                StateHasChanged();
            });
        }
    }

    private bool IsEmailValid()
    {
        if (string.IsNullOrWhiteSpace(CorreoInstitucional))
            return false;

        var email = CorreoInstitucional.Trim().ToLowerInvariant();

        // Validar formato básico de email
        if (!email.Contains("@") || email.Split('@').Length != 2)
            return false;

        // Validar dominios permitidos
        var dominiosPermitidos = new[]
        {
            "est.univalle.edu",
            "univalle.edu",
            "encargado.univalle.edu",
            "admin.univalle.edu"
        };

        var dominio = email.Split('@')[1];
        return dominiosPermitidos.Any(d => d.Equals(dominio, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsFormValid()
    {
        return IsEmailValid() && !string.IsNullOrWhiteSpace(Password) && Password.Length >= 5;
    }

    private bool IsLoginDisabled()
    {
        return loginState.IsBlocked || loginState.IsLoading || !IsFormValid();
    }

    private string GetLoginButtonText()
    {
        if (loginState.IsLoading) return "VERIFICANDO...";
        if (loginState.IsBlocked) return "CUENTA BLOQUEADA";
        if (!IsFormValid()) return "INGRESAR";
        return "ENTRAR";
    }

    private string GetLoginButtonIcon()
    {
        if (loginState.IsLoading) return "hourglass_empty";
        if (loginState.IsBlocked) return "lock";
        return "login";
    }

    private string GetAlertClass()
    {
        return loginState.ErrorType switch
        {
            "USER_INACTIVE" or "USER_NOT_FOUND" or "INVALID_EMAIL" => "alert-info",
            "WRONG_PASSWORD" or "INVALID_CREDENTIALS" => "alert-warning",
            "BLOCKED" => "alert-danger",
            _ => "alert-info"
        };
    }

    private string GetAlertIcon()
    {
        return loginState.ErrorType switch
        {
            "USER_INACTIVE" => "🚫",
            "USER_NOT_FOUND" => "❓",
            "INVALID_EMAIL" => "📧",
            "WRONG_PASSWORD" or "INVALID_CREDENTIALS" => "⚠️",
            "BLOCKED" => "🔒",
            _ => "ℹ️"
        };
    }

    private string GetAlertTitle()
    {
        return loginState.ErrorType switch
        {
            "USER_INACTIVE" => "Cuenta Inactiva",
            "USER_NOT_FOUND" => "Usuario No Registrado",
            "INVALID_EMAIL" => "Correo Inválido",
            "WRONG_PASSWORD" or "INVALID_CREDENTIALS" => "Credenciales Incorrectas",
            "BLOCKED" => "Cuenta Bloqueada",
            _ => "Información"
        };
    }

    private async Task RedirigirSegunRol(string rol)
    {
        var route = rol.ToLower() switch
        {
            "estudiante" when !string.IsNullOrEmpty(CodigoMaquina) && !string.IsNullOrEmpty(CodigoLaboratorio) 
                => $"/estudiante?codigoMaquina={CodigoMaquina}&codigoLaboratorio={CodigoLaboratorio}",
            "estudiante" => "/estudiante",
            "docente" when !string.IsNullOrEmpty(CodigoMaquina) && !string.IsNullOrEmpty(CodigoLaboratorio) 
                => $"/docentes?codigoMaquina={CodigoMaquina}&codigoLaboratorio={CodigoLaboratorio}",
            "encargado" => "/encargado",
            "admin" => "/admin",
            _ => "/docentes"
        };

        NavigationManager.NavigateTo(route, forceLoad: true);
    }

    private async Task MostrarNotificacion(string titulo, string mensaje, NotificationSeverity severity)
    {
        var notificacion = new NotificationMessage
        {
            Severity = severity,
            Summary = titulo,
            Detail = mensaje,
            Duration = 4000
        };
        NotificationService.Notify(notificacion);
    }

    public void Dispose()
    {
        bloqueoTimer?.Dispose();
    }

    // Clase para manejar el estado del login
    public class LoginState
    {
        public bool IsLoading { get; set; }
        public bool IsBlocked { get; set; }
        public bool ShowWarning { get; set; }
        public int RemainingAttempts { get; set; } = 3;
        public string TimeRemaining { get; set; } = "10:00";
        public string ErrorMessage { get; set; } = "";
        public string ErrorType { get; set; } = "";
        public string LoadingMessage { get; set; } = "Verificando credenciales...";
    }
}

