@page "/login"
@layout LoginLayout
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject UsuarioService usuarioService
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<PageTitle>Iniciar Sesión - PachaSoft</PageTitle>

<div class="login-container">
    <RadzenButton Icon="arrow_back" 
                  Text="Volver al Inicio"
                  Click="@(() => NavigationManager.NavigateTo("/"))"
                  ButtonStyle="ButtonStyle.Light"
                  Class="btn-volver-inicio" />

    <RadzenColumn Size="12" SizeMD="8" SizeLG="6" SizeXL="4">
        <RadzenCard Class="login-card-custom">
            
            <div class="logo-section">
                <img src="/images/logo4.png" alt="PachaSoft Logo" class="logo" />
            </div>

            <h2 class="login-title">Iniciar Sesión</h2>
            <p class="login-subtitle" style="margin-bottom: 15px;">Ingresar con datos de la Universidad</p>

            @* --- Espacio para Alerta de Bloqueo (Simulación) --- *@
            <RadzenAlert AlertStyle="AlertStyle.Danger" Title="Cuenta Bloqueada" Visible="false" Class="alerta-bloqueo">
                Demasiados intentos fallidos. Intente nuevamente en **00:00**.
            </RadzenAlert>

            @* --- Espacio para Alerta de Intentos Restantes (Simulación) --- *@
            <RadzenAlert AlertStyle="AlertStyle.Warning" Title="Advertencia" Visible="false" Class="alerta-intentos">
                Intentos restantes: **X** de 3
            </RadzenAlert>

            <RadzenTemplateForm Data="@(usuario)" Disabled="false">
                <RadzenStack Gap="1.5rem" Class="form-stack">
                    
                    <div class="form-group-custom">
                        <RadzenLabel Text="Email" Class="form-label-custom" />
                        <RadzenTextBox @bind-Value="@CorreoInstitucional"
                                       Placeholder="Ejemplo@est.univalle.edu" 
                                       Style="width: 100%;" 
                                       Disabled="false" 
                                       Class="form-input-custom" />
                    </div>

                    <div class="form-group-custom">
                        <RadzenLabel Text="Contraseña" Class="form-label-custom" />
                        <RadzenPassword @bind-Value="@PasswordHash"
                                        Style="width: 100%;" 
                                        Disabled="false" 
                                        Class="form-input-custom" />
                    </div>
                    
                    <RadzenButton
                                  Text="ENTRAR" 
                                  ButtonStyle="ButtonStyle.Primary"
                                  Class="btn-entrar-custom" 
                                  Size="ButtonSize.Large" />
                </RadzenStack>
            </RadzenTemplateForm>
            <p class="footer-text">Sistema de control de laboratorios</p>
        </RadzenCard>
    </RadzenColumn>
</div>

<style>
    .login-container {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: #f5f5f5;
    }
    .btn-volver-inicio {
        position: absolute;
        top: 20px;
        left: 20px;
        background-color: transparent !important;
        color: #8B4C4C !important;
        border: 1px solid #8B4C4C !important;
        padding: 8px 15px;
        border-radius: 5px;
        font-weight: 500;
        text-transform: uppercase;
        box-shadow: none !important;
    }
    
    .btn-volver-inicio:hover {
        background-color: #f0e6e6 !important;
        color: #6d3838 !important;
    }
    .login-card-custom {
        padding: 40px !important;
        width: 400px; 
        text-align: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1) !important;
        border-radius: 10px !important;
    }
    
    .logo-section { margin-bottom: 25px; }
    .logo { width: 200px; height: auto; }
    .login-title { 
        font-size: 24px; 
        font-weight: 600; 
        color: #333; 
        margin-top: 15px;
        margin-bottom: 5px; 
    }
    .login-subtitle { 
        font-size: 14px; 
        color: #666; 
        margin-bottom: 30px; 
    }
    .form-stack {
        gap: 1.5rem; 
    }
    .form-group-custom {
        text-align: left;
        margin-bottom: 10px; 
    }
    
    .form-label-custom { 
        display: block; 
        font-size: 14px; 
        color: #333; 
        margin-bottom: 5px; 
        font-weight: 500; 
    }
    
    .form-input-custom { 
        width: 100%; 
    }

    .btn-entrar-custom {
        width: 100%;
        height: 45px;
        background-color: #842A3B !important;
        border: none !important;
        font-size: 16px;
        font-weight: 600;
        margin-top: 15px;
        border-radius: 8px !important;
        transition: background-color 0.3s;
        box-shadow: none !important;
    }

    .btn-entrar-custom:hover {
        background-color: #6d3838 !important;
    }
    
    .footer-text {
        font-size: 12px;
        color: #999;
        margin-top: 25px;
    }
    
    .alerta-bloqueo, .alerta-intentos {
        margin-bottom: 20px;
        text-align: left;
    }
</style>

