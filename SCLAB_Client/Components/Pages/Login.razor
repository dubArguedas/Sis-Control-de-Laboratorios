@page "/login"
@layout LoginLayout
@rendermode InteractiveServer

@inject NavigationManager NavigationManager

<PageTitle>Iniciar Sesión - PachaSoft</PageTitle>

<div class="login-container">
    <RadzenButton Icon="arrow_back" 
                  Text="Inicio" 
                  Click="@(() => NavigationManager.NavigateTo("/"))"
                  ButtonStyle="ButtonStyle.Light"
                  Class="btn-volver-inicio" />

    <div class="login-card">
        <div class="logo-section">
            <img src="images/logo-pachasoft.png" alt="PachaSoft Logo" class="logo" />
        </div>

        <h2 class="login-title">Iniciar Sesión</h2>
        <p class="login-subtitle">Ingresar con datos de la Universidad</p>

        <div class="form-group">
            <label class="form-label">Email</label>
            <RadzenTextBox @bind-Value="email" 
                           Placeholder="Ejemplo@est.univalle.edu" 
                           Class="form-input" />
        </div>

        <div class="form-group">
            <label class="form-label">Contraseña</label>
            <RadzenPassword @bind-Value="password" 
                            Class="form-input" />
        </div>

        <RadzenButton Text="Entrar" 
                      Click="@HandleLogin"
                      ButtonStyle="ButtonStyle.Primary"
                      Class="btn-entrar" />
        
        <div class="registro-link-container">
            <RadzenLink Text="No tienes cuenta? Regístrate!" 
                        Path="/registro-info" 
                        Class="link-registro" />
        </div>

        <p class="footer-text">Sistema de registro de máquina</p>
    </div>
</div>

<style>
    /* Estilos ya existentes */
    .login-container {
        position: relative; /* Importante para posicionar el botón */
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: #f5f5f5;
    }

    .login-card {
        background: white;
        padding: 40px;
        width: 400px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1); /* Sutil sombra para elegancia */
        border-radius: 10px; /* Bordes redondeados */
    }
    
    /* ... (resto de tus estilos originales) ... */
    .logo-section { margin-bottom: 30px; }
    .logo { width: 180px; height: auto; }
    .login-title { font-size: 24px; font-weight: 600; color: #333; margin-bottom: 10px; }
    .login-subtitle { font-size: 14px; color: #666; margin-bottom: 30px; }
    .form-group { margin-bottom: 20px; text-align: left; }
    .form-label { display: block; font-size: 14px; color: #333; margin-bottom: 8px; font-weight: 500; }
    .form-input { width: 100%; }

    .btn-entrar {
        width: 100%;
        height: 45px;
        background-color: #8B4C4C !important; /* Color principal */
        border: none;
        font-size: 16px;
        font-weight: 600;
        margin-top: 20px;
        border-radius: 8px;
        transition: background-color 0.3s;
    }

    .btn-entrar:hover {
        background-color: #6d3838 !important; /* Tono más oscuro al pasar el ratón */
    }

    .footer-text {
        font-size: 12px;
        color: #999;
        margin-top: 20px;
    }

    /* --- Estilos Adicionales --- */

    /* 1. Botón Elegante en la Esquina */
    .btn-volver-inicio {
        position: absolute;
        top: 20px; /* Separación superior */
        left: 20px; /* Separación izquierda */
        /* Estilo Light para hacerlo sutil */
        background-color: transparent !important;
        color: #8B4C4C !important; /* Color del texto/icono */
        border: 1px solid #8B4C4C !important;
        padding: 8px 15px;
        border-radius: 5px;
        font-weight: 500;
        transition: background-color 0.3s, color 0.3s;
    }

    .btn-volver-inicio:hover {
        background-color: #f0e6e6 !important; /* Color muy claro al pasar el ratón */
        color: #6d3838 !important;
    }

    /* 2. Link Estético de Registro */
    .registro-link-container {
        margin-top: 15px;
    }

    .link-registro {
        font-size: 14px;
        color: #8B4C4C !important; /* Usa el color principal */
        text-decoration: none !important; /* Quita el subrayado por defecto */
        border-bottom: 1px dashed #8B4C4C; /* Subrayado punteado estético */
        transition: color 0.3s, border-bottom 0.3s;
        cursor: pointer;
    }

    .link-registro:hover {
        color: #6d3838 !important; /* Oscurece al pasar el ratón */
        border-bottom: 1px solid #6d3838;
    }

</style>

@code {
    private string email = "";
    private string password = "";

    private void HandleLogin()
    {
        // Aquí irá la lógica de autenticación
        // Por ahora navegamos directamente a la página de bienvenida
        NavigationManager.NavigateTo("/bienvenida");
    }
}