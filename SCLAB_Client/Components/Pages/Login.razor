@code {
    private SCLAB_Client.Models.LoginDto loginModel = new();
    private string CorreoInstitucional { get; set; } = "";
    private string Password { get; set; } = "";

    // Configuración de seguridad
    private int maxIntentos = 3;
    private int bloqueoMinutos = 10;
    private System.Threading.Timer? bloqueoTimer;

    // Estado del login
    private LoginState loginState = new();

    // Estado del modal
    private bool mostrarModalOlvidoContrasena = false;

    protected override void OnInitialized()
    {
        maxIntentos = Configuration.GetValue<int>("Security:MaxLoginAttempts", 3);
        bloqueoMinutos = Configuration.GetValue<int>("Security:BlockDurationMinutes", 10);
    }

    private void MostrarModalOlvidoContrasena()
    {
        mostrarModalOlvidoContrasena = true;
        StateHasChanged();
    }

    private void CerrarModalOlvidoContrasena()
    {
        mostrarModalOlvidoContrasena = false;
        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        if (IsLoginDisabled())
            return;

        loginState.IsLoading = true;
        loginState.LoadingMessage = "Verificando credenciales...";
        loginState.ShowWarning = false;
        loginState.ErrorMessage = "";
        StateHasChanged();

        try
        {
            // Normalizar correo
            var correo = CorreoInstitucional.Trim().ToLowerInvariant();

            // Validar formato de correo primero
            if (!IsEmailValid())
            {
                loginState.ErrorMessage = "El formato del correo institucional no es válido. Use: usuario@est.univalle.edu";
                loginState.ErrorType = "INVALID_FORMAT";
                loginState.IsLoading = false;
                StateHasChanged();
                return;
            }

            // LLAMADA A LA API
            var response = await AuthService.LoginAsync(correo, Password);

            if (!string.IsNullOrEmpty(response.Token))
            {
                // Login exitoso
                loginState.LoadingMessage = "Acceso concedido. Redirigiendo...";
                StateHasChanged();

                await MostrarNotificacion("¡Bienvenido!", "Inicio de sesión exitoso", NotificationSeverity.Success);

                // Obtener información del usuario
                var userInfo = await AuthService.GetCurrentUserInfoAsync();

                // Redirigir según el rol
                await Task.Delay(800);
                await RedirigirSegunRol(userInfo?.Rol ?? "");
            }
            else
            {
                // Login fallido - Mejorar mensajes de error
                await ManejarErrorLogin(response);
            }
        }
        catch (Exception ex)
        {
            loginState.ErrorMessage = "Error de conexión con el servidor. Verifique su conexión a internet.";
            loginState.ErrorType = "CONNECTION_ERROR";
            loginState.IsLoading = false;

            await MostrarNotificacion(
                "Error de Conexión",
                "No se pudo conectar con el servidor.",
                NotificationSeverity.Error
            );
        }
        finally
        {
            loginState.IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task ManejarErrorLogin(SCLAB_Client.Models.LoginResponse response)
    {
        loginState.IsBlocked = response.IsBlocked;
        loginState.RemainingAttempts = response.RemainingAttempts;
        loginState.ErrorType = response.ErrorType;

        // Mejorar mensajes de error según el tipo
        if (response.IsBlocked)
        {
            loginState.ErrorMessage = response.Message;
            loginState.TimeRemaining = response.TimeRemaining.ToString(@"mm\:ss");
            IniciarTimerBloqueo();
        }
        else if (response.ErrorType == "USER_NOT_FOUND" || response.ErrorType == "INVALID_EMAIL")
        {
            loginState.ErrorMessage = "Correo no registrado";
            loginState.ShowWarning = false;
        }
        else if (response.ErrorType == "WRONG_PASSWORD")
        {
            loginState.ErrorMessage = "Contraseña incorrecta";
            loginState.ShowWarning = true;
        }
        else
        {
            loginState.ErrorMessage = response.Message ?? "Error al iniciar sesión";
            loginState.ShowWarning = false;
        }

        StateHasChanged();
    }

    private void IniciarTimerBloqueo()
    {
        bloqueoTimer?.Dispose();
        bloqueoTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() =>
            {
                loginState.IsBlocked = false;
                loginState.RemainingAttempts = maxIntentos;
                loginState.ShowWarning = false;
                bloqueoTimer?.Dispose();
                StateHasChanged();
            });
        }, null, TimeSpan.FromMinutes(bloqueoMinutos), Timeout.InfiniteTimeSpan);
    }

    private bool IsEmailValid()
    {
        if (string.IsNullOrWhiteSpace(CorreoInstitucional))
            return false;

        var email = CorreoInstitucional.Trim().ToLowerInvariant();

        // Validar formato básico de email
        if (!email.Contains("@") || email.Split('@').Length != 2)
            return false;

        // Validar dominios permitidos
        var dominiosPermitidos = new[]
        {
            "est.univalle.edu",
            "univalle.edu",
            "encargado.univalle.edu",
            "admin.univalle.edu"
        };

        var dominio = email.Split('@')[1];
        return dominiosPermitidos.Any(d => d.Equals(dominio, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsFormValid()
    {
        // Cambio: ahora requiere mínimo 5 caracteres en la contraseña
        return IsEmailValid() && !string.IsNullOrWhiteSpace(Password) && Password.Length >= 5;
    }

    private bool IsLoginDisabled()
    {
        return loginState.IsBlocked || loginState.IsLoading || !IsFormValid();
    }

    private string GetLoginButtonText()
    {
        if (loginState.IsLoading) return "VERIFICANDO...";
        if (loginState.IsBlocked) return "CUENTA BLOQUEADA";
        if (!IsFormValid()) return "INGRESAR";
        return "ENTRAR";
    }

    private string GetLoginButtonIcon()
    {
        if (loginState.IsLoading) return "hourglass_empty";
        if (loginState.IsBlocked) return "lock";
        return "login";
    }

    private async Task RedirigirSegunRol(string rol)
    {
        var route = rol.ToLower() switch
        {
            "estudiante" => "/",
            "docente" => "/docente/dashboard",
            "encargado" => "/encargado",
            "admin" => "/admin",
            _ => "/"
        };

        NavigationManager.NavigateTo(route, forceLoad: true);
    }

    private async Task MostrarNotificacion(string titulo, string mensaje, NotificationSeverity severity)
    {
        var notificacion = new NotificationMessage
        {
            Severity = severity,
            Summary = titulo,
            Detail = mensaje,
            Duration = 4000
        };
        NotificationService.Notify(notificacion);
    }

    public void Dispose()
    {
        bloqueoTimer?.Dispose();
    }

    // Clase para manejar el estado del login
    public class LoginState
    {
        public bool IsLoading { get; set; }
        public bool IsBlocked { get; set; }
        public bool ShowWarning { get; set; }
        public int RemainingAttempts { get; set; } = 3;
        public string TimeRemaining { get; set; } = "10:00";
        public string ErrorMessage { get; set; } = "";
        public string ErrorType { get; set; } = "";
        public string LoadingMessage { get; set; } = "Verificando credenciales...";
    }
}