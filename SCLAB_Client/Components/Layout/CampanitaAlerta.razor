@using SCLAB_Client.Components.Service
@using SCLAB_Client.Components.Service.SignalR
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using SCLAB_Client.Components.Pages.Encargado
@inject SignalRAlertasService SignalRService
@inject AlertaService AlertaService
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable
@rendermode InteractiveServer

<div class="alert-bell-container">
    <div class="bell-circle" @onclick="ToggleDropdown">
        <RadzenIcon Icon="notifications" Style="font-size: 24px; color: #662222;" />

        @if (conteoPendientes > 0)
        {
            <span class="alert-badge">@conteoPendientes</span>
        }
    </div>

    @if (mostrarDropdown)
    {
        <div class="alert-dropdown shadow-lg">
            <div class="dropdown-header">
                <strong>Pendientes (@conteoPendientes)</strong>
                <span class="close-btn" @onclick="ToggleDropdown">×</span>
            </div>

            <div class="dropdown-body">
                @if (ultimasAlertas == null || !ultimasAlertas.Any())
                {
                    <div class="empty-state">
                        <RadzenIcon Icon="check_circle" Style="color: green; font-size: 20px;" />
                        <span>Todo en orden</span>
                    </div>
                }
                else
                {
                    @foreach (var alerta in ultimasAlertas)
                    {
                        <div class="alert-card" @onclick="() => AbrirDialogoResolver(alerta)">
                            <div class="card-top">
                                <span class="machine-code">@alerta.Maquina?.Codigo</span>
                                <small class="date">@alerta.FechaCreacion.ToString("HH:mm dd/MM")</small>
                            </div>
                            <div class="card-action">
                                Revisar ahora <RadzenIcon Icon="arrow_forward" Style="font-size: 12px;" />
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="dropdown-footer" @onclick="IrAHistorial">
                Ver todo el historial
            </div>
        </div>
    }
</div>

@code {
    private int conteoPendientes = 0;
    private bool mostrarDropdown = false;
    private List<AlertaViewDto> ultimasAlertas = new();

    protected override async Task OnInitializedAsync()
    {
        SignalRService.OnAlertaRecibida += ManejarNuevaAlerta;
        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        var response = await AlertaService.ObtenerAlertasPorEstado("pendiente");
        if (response.IsSuccess && response.Data is List<AlertaViewDto> lista)
        {
            ultimasAlertas = lista.Take(5).ToList();
            conteoPendientes = lista.Count;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void ManejarNuevaAlerta(AlertaPayloadDto nuevaAlerta)
    {
        conteoPendientes++;

        var vistaDto = new AlertaViewDto
        {
            AlertaId = nuevaAlerta.AlertaId,
            Maquina = new MaquinaDto { Codigo = nuevaAlerta.MaquinaCodigo },
            FechaCreacion = nuevaAlerta.FechaCreacion,
            EstadoAlerta = "pendiente"
        };

        ultimasAlertas.Insert(0, vistaDto);
        if (ultimasAlertas.Count > 5) ultimasAlertas.RemoveAt(ultimasAlertas.Count - 1);

        InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown()
    {
        mostrarDropdown = !mostrarDropdown;
    }

    private async Task AbrirDialogoResolver(AlertaViewDto alerta)
    {
        mostrarDropdown = false; 

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        int userId = 0;

        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int id))
        {
            userId = id;
        }

        var parametros = new Dictionary<string, object>
        {
            { "AlertaId", alerta.AlertaId },
            { "MaquinaCodigo", alerta.Maquina?.Codigo ?? "Desconocido" },
            { "LaboratorioCodigo", alerta.Laboratorio?.Codigo ?? "N/A" },
            { "UsuarioResolutorId", userId }
        };

        var resultado = await DialogService.OpenAsync<ResolverAlertaDialog>($"Resolver Incidencia #{alerta.AlertaId}",
            parametros,
            new DialogOptions() { Width = "500px", CloseDialogOnOverlayClick = false });

        if (resultado is bool success && success)
        {
            ultimasAlertas.Remove(alerta);
            conteoPendientes--;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void IrAHistorial()
    {
        mostrarDropdown = false;
        Navigation.NavigateTo("/alertas/historial");
    }

    public void Dispose()
    {
        SignalRService.OnAlertaRecibida -= ManejarNuevaAlerta;
    }
}

<style>
