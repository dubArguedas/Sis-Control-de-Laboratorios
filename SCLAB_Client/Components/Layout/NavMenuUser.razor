@using System.Threading.Tasks
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

    <RadzenMenu Click="OnParentClicked" Style="--rz-menu-top-item-color: #662121; --rz-menu-top-item-hover-color: #1e0101; font-weight: 300; --rz-menu-item-icon-color: #662121; --rz-menu-item-icon-hover-color: #1c0101; background-color: var(--rz-white); --rz-menu-top-item-icon-color: #662121; --rz-menu-top-item-icon-hover-color: #662121; --rz-menu-top-item-selected-color: #580505; text-align: left; --rz-menu-background-color: #f9f8f6; --rz-menu-item-hover-background-color: #e9e9e9; text-transform: none" Responsive="true">
