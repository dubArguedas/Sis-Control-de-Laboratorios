@using SCLAB_Client.Components.Service.ServiciosApi
@inject IAuthService authService
@rendermode InteractiveServer

@if (hasEncargadoAccess)
{
    <div style="position: fixed; top: 10px; right: 20px; z-index: 1000;">
        <CampanitaAlerta/>
    </div>
}

@code {
    private bool hasEncargadoAccess = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userInfo = await authService.GetCurrentUserInfoAsync();
                if (userInfo != null)
                {
                    hasEncargadoAccess = userInfo.Rol?.Trim().ToLower() == "encargado";
                }
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[EncargadoAccessChecker] Error: {ex.Message}");
            }
        }
    }
}
